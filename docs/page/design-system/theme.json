{
  "name": "Breakout",
  "version": "2026-10-28",
  "base": {
    "system": "Nocturne (Claude Design)",
    "files": ["nocturne-styles.css", "nocturne-guide.md", "nocturne-theme.json"],
    "loadOrder": ["nocturne-styles.css", "breakout-maroon-tokens.css"],
    "inherited": "neutral ramp, type scale, spacing (density 0.7x), radii (8px), shadows, all component classes"
  },
  "method": "Accent ramp generated in OKLCH at Nocturne's per-step lightness so each step matches the neutral ramp in visual weight. Hue 16 deg (wine #722f37 = 15 deg, classic maroon #800020 = 18.6 deg). Chroma raised per step, clipped to sRGB. Base (500) lifted to L 0.68 so accent-coloured button labels clear ~4.3:1 on cards. A true maroon as the line colour would be ~1.5:1 on this ground; maroon is therefore carried by steps 700-900, tag fills, tinted nodes and the hero glow.",
  "ground": {
    "bg":      { "hex": "#1d1f27", "role": "page ground", "note": "lifted from Nocturne #161826" },
    "surface": { "hex": "#2b2d37", "role": "cards, nav, panels", "note": "lifted from #232532" },
    "text":    { "hex": "#e9e9ed", "role": "body and headings", "contrastOnBg": 13.58 }
  },
  "accent": {
    "hue": 16,
    "100": { "hex": "#fff2f2", "oklch": [0.971, 0.020, 16], "contrast": { "bg": 15.06, "surface": 12.55 }, "role": "text on .tag-accent" },
    "200": { "hex": "#ffdfe0", "oklch": [0.931, 0.045, 16], "contrast": { "bg": 13.22, "surface": 11.01 }, "role": "text on 900 tints; link hover" },
    "300": { "hex": "#fec2c5", "oklch": [0.870, 0.085, 16], "contrast": { "bg": 10.75, "surface": 8.96 },  "role": "accent at paragraph size: links, payout values, live labels" },
    "400": { "hex": "#fe949b", "oklch": [0.780, 0.140, 16], "contrast": { "bg": 7.77,  "surface": 6.47 },  "role": "kickers, step numbers, pressed state" },
    "500": { "hex": "#f65b6f", "oklch": [0.680, 0.190, 16], "contrast": { "bg": 5.20,  "surface": 4.33 },  "role": "THE accent: lines, outlines, button labels, arrows, status dot, headline-scale type" },
    "600": { "hex": "#cb4457", "oklch": [0.580, 0.170, 16], "contrast": { "bg": 3.53,  "surface": 2.94 },  "role": "hover depth via color-mix; never text" },
    "700": { "hex": "#a02e40", "oklch": [0.480, 0.150, 16], "contrast": { "bg": 2.32,  "surface": 1.93 },  "role": "maroon proper; presence fills at slide scale only" },
    "800": { "hex": "#78182a", "oklch": [0.380, 0.130, 16], "contrast": { "bg": 1.54,  "surface": 1.28 },  "role": "tag fills, hero glow source", "textOn": { "accent-100": 9.8 } },
    "900": { "hex": "#4f121b", "oklch": [0.290, 0.090, 16], "contrast": { "bg": 1.12,  "surface": 1.07 },  "role": "tinted fills: avatar tiles, core diagram nodes, card flash", "textOn": { "accent-200": 11.77 } }
  },
  "section": {
    "note": "deck dividers and stat bands only — never interface fills",
    "section": "#650c1f", "glow": "#822a36", "ghost": "#9e4b53"
  },
  "neutralUsage": {
    "neutral-800": "borders, seams, progress tracks, .tag-neutral fill",
    "neutral-700": "diagram node strokes",
    "neutral-400": "tertiary text, timestamps (6.8:1 on surface)",
    "neutral-300": "meta / secondary text (9.2:1 on surface)"
  },
  "type": {
    "family": "Inter (var(--font-heading) / var(--font-body))",
    "maxHeadingWeight": 500,
    "h1": "clamp(40px,6vw,80px) / 1.1, -0.015em, two lines, second line in accent",
    "h2": "32px, 500, -0.012em",
    "h3InSection": "24px, 500, -0.01em",
    "kicker": "13px uppercase, letter-spacing .06em, accent-400",
    "lede": "15.5px / 28px, text at 78% opacity, max 56-60ch",
    "body": "15px / 22px",
    "meta": "13px, neutral-300, font-feature-settings 'tnum' 1",
    "readoutValue": "14px; final result in accent-300 weight 500"
  },
  "layout": {
    "maxWidth": 1200,
    "sidePadding": "clamp(20px,5vw,72px)",
    "sectionPaddingY": 84,
    "heroPadding": "96px 0 72px",
    "listingGrid": "repeat(auto-fit, minmax(min(100%,340px), 1fr)), gap 28px",
    "stickyPanel": "position: sticky; top: 24px",
    "avatarTile": "44px, radius-md, accent-900 fill, accent-200 text",
    "progressBar": "2px, track neutral-800, fill accent",
    "radius": "var(--radius-md) = 8px",
    "diagram": { "viewBoxWidth": 1120, "node": [200, 90], "nodeRadius": 8, "gap": 80, "arrowStroke": 1.25, "labelSize": 12, "minWidth": 760 }
  },
  "effects": {
    "heroGlow": "radial-gradient(1200px 720px at 82% -160px, color-mix(in srgb, var(--color-accent-800) 70%, transparent), transparent 60%) over var(--color-bg)",
    "divider": "linear-gradient(to right, transparent, var(--color-divider) 48px calc(100% - 48px), transparent)",
    "statusDot": "8px circle, accent fill, box-shadow 0 0 8px var(--color-accent)",
    "selectedCard": "outline 1px solid var(--color-accent); outline-offset -1px",
    "cardFlash": "background → color-mix(in srgb, var(--color-accent-900) 70%, var(--color-surface)) for ~900ms",
    "barTransition": "width .8s cubic-bezier(.2,.7,.2,1)",
    "liveTick": "2200ms (6000ms and no flash under prefers-reduced-motion)"
  }
}
