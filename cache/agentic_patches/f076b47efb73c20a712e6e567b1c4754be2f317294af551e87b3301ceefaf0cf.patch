diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..c85a5a8
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,115 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.now = 0
+
+    def __call__(self):
+        return self.now
+
+
+@pytest.mark.parametrize("options", [
+    {"max_attempts": 0}, {"base_delay": 0},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_options(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_backoff_dead_and_statistics():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise RuntimeError("broken")
+
+    job = queue.submit("broken", fail)
+    for now, next_time in [(0, 2), (2, 5), (5, 8)]:
+        clock.now = now
+        assert worker.run_due() == 1
+        assert job.run_at == next_time
+        assert worker.run_due() == 0
+    clock.now = 8
+    assert worker.run_due() == 1
+    assert job.attempts == 4
+    assert worker.dead == [("broken", 4, "RuntimeError('broken')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_retry_succeeds_and_preserves_order():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        log.append("first")
+        if len(log) == 1:
+            raise ValueError("try again")
+
+    job = queue.submit("first", flaky)
+    assert worker.run_due() == 1
+    queue.submit("second", lambda: log.append("second"), delay=2)
+    clock.now = 2
+    assert worker.run_due() == 2
+    assert log == ["first", "first", "second"]
+    assert job.attempts == 2
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_attempt_time_and_snapshot():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail_after_time_moves():
+        clock.now = 100
+        raise ValueError()
+
+    job = queue.submit("first", fail_after_time_moves)
+    queue.submit("later", lambda: None, delay=1)
+    assert worker.run_due() == 1
+    assert job.run_at == 2
+    assert worker.run_due() == 2
+
+
+def test_base_exception_propagates_and_preserves_other_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    error = KeyboardInterrupt()
+
+    def interrupt():
+        raise error
+
+    job = queue.submit("interrupt", interrupt)
+    queue.submit("other", lambda: None)
+    with pytest.raises(KeyboardInterrupt) as caught:
+        worker.run_due()
+    assert caught.value is error
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
+
+
+def test_retry_not_run_twice_when_delay_rounds_to_now():
+    clock = Clock()
+    clock.now = 1e20
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail():
+        raise ValueError()
+
+    job = queue.submit("job", fail)
+    assert worker.run_due() == 1
+    assert job.attempts == 1
+    assert len(queue) == 1
