diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..9ebd7ab
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,108 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.mark.parametrize("settings", [
+    {"max_attempts": 0}, {"base_delay": 0},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_settings(settings):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **settings)
+
+
+def test_retries_backoff_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+    def fail():
+        raise ValueError("bad")
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 1
+    assert job.attempts == 1 and job.run_at == 2
+    assert worker.run_due() == 0
+    clock.t = 2
+    assert worker.run_due() == 1 and job.run_at == 5
+    clock.t = 5
+    assert worker.run_due() == 1 and job.run_at == 8
+    clock.t = 8
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 4, "ValueError('bad')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_success_after_failure_and_original_sequence():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+    def retry():
+        log.append("retry")
+        if len(log) == 1:
+            raise RuntimeError()
+    job = queue.submit("retry", retry)
+    assert worker.run_due() == 1
+    queue.submit("later", lambda: log.append("later"), delay=2)
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert log == ["retry", "retry", "later"]
+    assert job.attempts == 2
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_snapshot_and_attempt_time_when_clock_advances():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, base_delay=1, max_delay=1)
+    def fail():
+        clock.t += 10
+        raise RuntimeError()
+    job = queue.submit("fail", fail)
+    queue.submit("future", lambda: None, delay=5)
+    assert worker.run_due() == 1
+    assert job.run_at == 1
+    assert job.attempts == 1
+    assert len(queue) == 2
+
+
+def test_base_exception_propagates_and_preserves_other_due_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    error = KeyboardInterrupt()
+    def interrupt():
+        raise error
+    job = queue.submit("interrupt", interrupt)
+    queue.submit("other", lambda: None)
+    with pytest.raises(KeyboardInterrupt) as caught:
+        worker.run_due()
+    assert caught.value is error
+    assert job.attempts == 1 and len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1 and worker.done == ["other"]
+
+
+def test_delay_counts_from_each_attempt_and_dead_order():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=2)
+    def fail():
+        raise LookupError("lost")
+    first = queue.submit("first", fail)
+    queue.submit("second", fail)
+    clock.t = 10
+    assert worker.run_due() == 2 and first.run_at == 12
+    clock.t = 12
+    assert worker.run_due() == 2
+    assert [item[0] for item in worker.dead] == ["first", "second"]
