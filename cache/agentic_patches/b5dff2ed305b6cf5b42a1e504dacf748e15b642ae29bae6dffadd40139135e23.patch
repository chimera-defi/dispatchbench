diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..8bb0173
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,60 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_nested_sections_and_literal_dollars():
+    text = """root = base
+[a.b]
+c = ${.root}
+[a]
+x = ${a.b.c}/${y}/$$/$${y}
+y = ${z}
+z = end
+"""
+    assert load(text) == {
+        "": {"root": "base"},
+        "a.b": {"c": "base"},
+        "a": {"x": "base/end/$/${y}", "y": "end", "z": "end"},
+    }
+    assert parse(text)["a"]["y"] == "${z}"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", ".missing", "missing.key"])
+def test_missing_reference_reports_name_and_outer_line(reference):
+    text = f"[a]\nx = ${{y}}\ny = ${{{reference}}}\n"
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == f"unknown reference: {reference}"
+    assert error.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["${unfinished", "$", "hello $world"])
+def test_invalid_syntax_reports_outer_line(value):
+    with pytest.raises(ConfigError) as error:
+        load(f"x = ${{y}}\ny = {value}\n")
+    assert error.value.line == 1
+
+
+def test_cycle_message_excludes_noncyclic_prefix():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n")
+    assert str(error.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert error.value.line == 2
+
+
+def test_file_order_across_repeated_sections_and_left_to_right():
+    text = "[a]\nfirst = ok\n[b]\nx = ${y}${x}\ny = ${y}\n[a]\nlater = ${later}\n"
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == "reference cycle: b.y -> b.y"
+    assert error.value.line == 4
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as error:
+        load("x = ${y}\ny = ${.x}\n")
+    assert str(error.value) == "reference cycle: .x -> .y -> .x"
+    assert error.value.line == 1
