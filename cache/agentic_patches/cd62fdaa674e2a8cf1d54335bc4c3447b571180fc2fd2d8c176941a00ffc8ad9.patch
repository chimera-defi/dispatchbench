diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..4e60184
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,97 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import get, load
+from cfg.parser import parse
+
+
+def test_same_section_and_text():
+    c = load("[app]\nname = demo\ngreet = hello ${name}!\n")
+    assert get(c, "app.greet") == "hello demo!"
+
+
+def test_cross_section_dotted_section_and_unnamed():
+    c = load(
+        "base = root\n"
+        "[a.b]\n"
+        "c = ${.base}-x\n"
+        "[db]\n"
+        "host = ${a.b.c}.local\n"
+    )
+    assert get(c, "db.host") == "root-x.local"
+    assert get(c, "a.b.c") == "root-x"
+
+
+def test_nested_and_several_refs_and_dollar():
+    c = load("[a]\nprice = 5\nb = cost $$${price} and ${price}\nc = ${b}\n")
+    assert get(c, "a.c") == "cost $5 and 5"
+
+
+def test_unknown_reference_uses_written_name():
+    with pytest.raises(ConfigError) as e:
+        load("[db]\nhost = localhost\nurl = ${db.hostt}\n")
+    assert "unknown reference: db.hostt" in str(e.value)
+    assert e.value.line == 3
+
+    with pytest.raises(ConfigError) as e:
+        load("[db]\nurl = ${missing}\n")
+    assert "unknown reference: missing" in str(e.value)
+
+
+def test_unknown_other_section_and_unnamed():
+    with pytest.raises(ConfigError) as e:
+        load("x = ${nope.k}\n")
+    assert "unknown reference: nope.k" in str(e.value)
+    assert e.value.line == 1
+
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nk = ${.gone}\n")
+    assert "unknown reference: .gone" in str(e.value)
+
+
+def test_cycle_file_order_and_left_to_right():
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = ${y}\ny = ${x}\n")
+    assert str(e.value) == "line 2: reference cycle: a.x -> a.y -> a.x"
+    assert e.value.line == 2
+
+    with pytest.raises(ConfigError) as e:
+        load("[a]\ny = ${x}\nx = ${y}\n")
+    assert "reference cycle: a.y -> a.x -> a.y" in str(e.value)
+    assert e.value.line == 2
+
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = ${z}${y}\ny = 1\nz = ${x}\n")
+    assert "reference cycle: a.x -> a.z -> a.x" in str(e.value)
+
+
+def test_cycle_through_sections_and_unnamed():
+    with pytest.raises(ConfigError) as e:
+        load("x = ${a.y}\n[a]\ny = ${.x}\n")
+    assert str(e.value) == "line 1: reference cycle: .x -> a.y -> .x"
+
+
+def test_unterminated_and_bare_dollar_use_outer_line():
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = ${y\n")
+    assert e.value.line == 2
+    assert "unterminated" in str(e.value)
+
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = $oops\n")
+    assert e.value.line == 2
+
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nouter = ${inner}\ninner = pre ${nope\n")
+    assert e.value.line == 2
+
+
+def test_parser_keeps_raw_values():
+    raw = parse("[a]\nx = ${y}\ny = z\n")
+    assert raw["a"]["x"] == "${y}"
+
+
+def test_existing_plain_config():
+    c = load("name = app\n[db]\nhost = localhost\n")
+    assert get(c, "name") == "app"
+    assert get(c, "db.host") == "localhost"
