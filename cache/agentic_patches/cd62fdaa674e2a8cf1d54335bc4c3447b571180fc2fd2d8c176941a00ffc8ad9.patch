--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,72 @@
-from .parser import parse
+from .errors import ConfigError
+from .parser import parse_with_lines
+
+
+def _fq(section: str, key: str) -> str:
+    return f"{section}.{key}" if section else f".{key}"
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    data, defined = parse_with_lines(text)
+    cache: dict[tuple[str, str], str] = {}
+    stack: list[tuple[str, str]] = []
+
+    def resolve(section: str, key: str, origin: int) -> str:
+        ident = (section, key)
+        if ident in cache:
+            return cache[ident]
+        if ident in stack:
+            start = stack.index(ident)
+            chain = [_fq(s, k) for s, k in stack[start:]] + [_fq(section, key)]
+            raise ConfigError("reference cycle: " + " -> ".join(chain), origin)
+        stack.append(ident)
+        try:
+            value = _expand(data[section][key], section, origin)
+        finally:
+            stack.pop()
+        cache[ident] = value
+        return value
+
+    def lookup(ref: str, section: str, origin: int) -> str:
+        if "." in ref:
+            target_section, _, target_key = ref.rpartition(".")
+            written = ref
+        else:
+            target_section, target_key = section, ref
+            written = ref
+        if target_section not in data or target_key not in data[target_section]:
+            raise ConfigError(f"unknown reference: {written}", origin)
+        return resolve(target_section, target_key, origin)
+
+    def _expand(raw: str, section: str, origin: int) -> str:
+        out: list[str] = []
+        i = 0
+        n = len(raw)
+        while i < n:
+            if raw[i] != "$":
+                out.append(raw[i])
+                i += 1
+                continue
+            nxt = raw[i + 1] if i + 1 < n else ""
+            if nxt == "$":
+                out.append("$")
+                i += 2
+                continue
+            if nxt == "{":
+                end = raw.find("}", i + 2)
+                if end < 0:
+                    raise ConfigError("unterminated ${", origin)
+                out.append(lookup(raw[i + 2 : end], section, origin))
+                i = end + 1
+                continue
+            raise ConfigError("unexpected '$'", origin)
+        return "".join(out)
+
+    for section, keys in data.items():
+        for key in list(keys):
+            keys[key] = resolve(section, key, defined[(section, key)])
+    return data
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
