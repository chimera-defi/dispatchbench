diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..5ef3a21
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,65 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_literal_dollars():
+    text = """root = base
+[a.b]
+first = ${second}/${.root}/$$/${second}
+second = ${third}
+third = done
+literal = $${third}
+"""
+    assert parse(text)["a.b"]["first"] == "${second}/${.root}/$$/${second}"
+    values = load(text)
+    assert values["a.b"]["first"] == "done/base/$/done"
+    assert values["a.b"]["literal"] == "${third}"
+    assert load(text + "[x]\nv=${a.b.third}\n")["x"]["v"] == "done"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", ".absent", "a.b.c"])
+def test_unknown_reference_preserves_name_and_outer_line(reference):
+    with pytest.raises(ConfigError) as error:
+        load(f"[a]\nouter = ${{inner}}\ninner = ${{{reference}}}\n")
+    assert str(error.value) == f"unknown reference: {reference}"
+    assert error.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "prefix ${unfinished"])
+def test_invalid_reference_syntax_reports_outer_line(value):
+    with pytest.raises(ConfigError) as error:
+        load(f"start = ${{next}}\nnext = {value}\n")
+    assert error.value.line == 1
+
+
+def test_cycle_starts_at_first_repeated_key():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nstart=${x}\nx=${y}\ny=${x}\n")
+    assert str(error.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert error.value.line == 2
+
+
+def test_cycle_selection_uses_file_order_and_left_to_right():
+    text = "[a]\nstart=${b.x}${c.x}\n[c]\nx=${x}\n[b]\nx=${x}\n"
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == "reference cycle: b.x -> b.x"
+    assert error.value.line == 2
+
+
+def test_reopened_sections_resolve_in_definition_order():
+    text = "[a]\nok=1\n[b]\nx=${x}\n[a]\ny=${y}\n"
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == "reference cycle: b.x -> b.x"
+    assert error.value.line == 4
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as error:
+        load("x=${y}\ny=${.x}\n")
+    assert str(error.value) == "reference cycle: .x -> .y -> .x"
+    assert error.value.line == 1
