diff --git a/inv/money.py b/inv/money.py
index caa7f2f..e546951 100644
--- a/inv/money.py
+++ b/inv/money.py
@@ -1,3 +1,10 @@
+def apply_percent(cents: int, pct: int) -> int:
+    """Return cents reduced by pct percent, rounded half up to the nearest cent."""
+    if isinstance(pct, bool) or not isinstance(pct, int) or not 0 <= pct <= 100:
+        raise ValueError("pct must be an int from 0 to 100 inclusive")
+    return (cents * (100 - pct) + 50) // 100
+
+
 def format_cents(cents: int) -> str:
     """1234 -> '$12.34'; negative values get a leading '-'."""
     sign = "-" if cents < 0 else ""
diff --git a/inv/store.py b/inv/store.py
index c8a5bb8..9344c5d 100644
--- a/inv/store.py
+++ b/inv/store.py
@@ -1,9 +1,11 @@
 from .models import Item
+from .money import apply_percent
 
 
 class Store:
     def __init__(self):
         self.items: dict[str, Item] = {}
+        self.codes: dict[str, int] = {}
 
     def add_item(self, name: str, price_cents: int, qty: int = 1) -> None:
         if name in self.items:
@@ -14,5 +16,19 @@ class Store:
     def remove_item(self, name: str) -> None:
         del self.items[name]
 
-    def total_cents(self) -> int:
-        return sum(i.line_total() for i in self.items.values())
+    def add_code(self, code: str, pct: int) -> None:
+        key = code.casefold()
+        if key in self.codes:
+            raise ValueError(f"code already exists: {code}")
+        # Validate pct before storing. apply_percent rejects out-of-range values.
+        apply_percent(0, pct)
+        self.codes[key] = pct
+
+    def total_cents(self, code: str | None = None) -> int:
+        total = sum(i.line_total() for i in self.items.values())
+        if code is None:
+            return total
+        key = code.casefold()
+        if key not in self.codes:
+            raise KeyError(code)
+        return apply_percent(total, self.codes[key])
