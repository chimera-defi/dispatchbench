diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..abfe059
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,49 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+def test_apply_percent_half_up():
+    assert apply_percent(1005, 10) == 905
+    assert apply_percent(1000, 10) == 900
+    assert apply_percent(1, 50) == 1
+    assert apply_percent(200, 0) == 200
+    assert apply_percent(200, 100) == 0
+
+
+def test_apply_percent_rejects_bad_pct():
+    for pct in (-1, 101, 10.5, True, "10"):
+        with pytest.raises(ValueError):
+            apply_percent(100, pct)
+
+
+def test_add_code_case_and_validation():
+    s = Store()
+    s.add_code("Save10", 10)
+    with pytest.raises(ValueError):
+        s.add_code("save10", 15)
+    with pytest.raises(ValueError):
+        s.add_code("nope", 101)
+    assert "nope" not in s.codes
+
+
+def test_total_with_code():
+    s = Store()
+    s.add_item("pen", 150, 2)
+    s.add_item("pad", 399)
+    s.add_code("TEN", 10)
+    assert s.total_cents() == 699
+    assert s.total_cents("ten") == apply_percent(699, 10)
+    with pytest.raises(KeyError):
+        s.total_cents("missing")
+
+
+def test_cli_total_code():
+    s = Store()
+    s.add_item("pen", 1005)
+    s.add_code("off", 10)
+    assert main(["total"], s) == "$10.05"
+    assert main(["total", "--code", "OFF"], s) == "$9.05"
+    assert main(["total", "--code", "nope"], s) == "unknown code: nope"
