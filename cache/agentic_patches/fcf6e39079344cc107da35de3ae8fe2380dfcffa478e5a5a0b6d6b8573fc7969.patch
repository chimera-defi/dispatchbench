diff --git a/inv/money.py b/inv/money.py
index caa7f2f..6442222 100644
--- a/inv/money.py
+++ b/inv/money.py
@@ -3,3 +3,14 @@ def format_cents(cents: int) -> str:
     sign = "-" if cents < 0 else ""
     cents = abs(cents)
     return f"{sign}${cents // 100}.{cents % 100:02d}"
+
+
+def apply_percent(cents: int, pct: int) -> int:
+    """Return cents reduced by pct percent, rounded half up to a whole cent."""
+    if isinstance(pct, bool) or not isinstance(pct, int) or pct < 0 or pct > 100:
+        raise ValueError("pct must be an int from 0 to 100 inclusive")
+    # Round half away from zero (ROUND_HALF_UP): 904.5 -> 905.
+    reduced = cents * (100 - pct)
+    if reduced < 0:
+        return -((-reduced + 50) // 100)
+    return (reduced + 50) // 100
