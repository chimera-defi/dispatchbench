diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..4dc63d7
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,104 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent, format_cents
+from inv.store import Store
+
+
+def test_apply_percent_rounds_half_up():
+    # 1005 * 90% = 904.5 -> 905
+    assert apply_percent(1005, 10) == 905
+    # 22.5 must round half up, not half-to-even (which would yield 22)
+    assert apply_percent(25, 10) == 23
+    # 0.5 rounds half up to 1; 0.49 rounds down to 0
+    assert apply_percent(1, 50) == 1
+    assert apply_percent(1, 51) == 0
+    assert apply_percent(4, 10) == 4  # 3.6
+    assert apply_percent(6, 10) == 5  # 5.4
+
+
+def test_apply_percent_boundaries():
+    assert apply_percent(1005, 0) == 1005
+    assert apply_percent(1005, 100) == 0
+    assert apply_percent(0, 37) == 0
+    assert apply_percent(200, 25) == 150
+
+
+def test_apply_percent_rejects_pct_outside_0_to_100():
+    for pct in (-1, 101, -100, 1000):
+        with pytest.raises(ValueError):
+            apply_percent(100, pct)
+
+
+def test_apply_percent_rejects_non_int_pct():
+    for pct in (10.0, "10", None, 10.5, True, False):
+        with pytest.raises(ValueError):
+            apply_percent(100, pct)
+
+
+def test_add_code_discounts_the_whole_total():
+    store = Store()
+    store.add_item("a", 1005)
+    store.add_item("b", 1005)
+    store.add_code("Save10", 10)
+    # 2010 * 90% = 1809. Per-line rounding would be 905 + 905 = 1810.
+    assert store.total_cents("save10") == 1809
+    assert store.total_cents("SAVE10") == 1809
+    assert store.total_cents() == 2010
+
+
+def test_add_code_duplicate_any_case_raises_and_keeps_original():
+    store = Store()
+    store.add_item("pen", 1000)
+    store.add_code("Save10", 10)
+    with pytest.raises(ValueError):
+        store.add_code("save10", 50)
+    with pytest.raises(ValueError):
+        store.add_code("SAVE10", 10)
+    assert store.total_cents("SaVe10") == 900
+
+
+def test_add_code_rejects_invalid_pct_and_does_not_store_it():
+    store = Store()
+    store.add_item("pen", 1000)
+    for pct in (-1, 101, 10.0, "10"):
+        with pytest.raises(ValueError):
+            store.add_code("Nope", pct)
+    with pytest.raises(KeyError):
+        store.total_cents("Nope")
+    store.add_code("Nope", 10)
+    assert store.total_cents("nope") == 900
+
+
+def test_unknown_code_raises_keyerror():
+    store = Store()
+    store.add_item("pen", 100)
+    with pytest.raises(KeyError):
+        store.total_cents("missing")
+
+
+def test_cli_total_code_formats_discounted_total():
+    store = Store()
+    store.add_item("pen", 1005)
+    store.add_code("ten", 10)
+    assert main(["total", "--code", "ten"], store) == "$9.05"
+    assert main(["total", "--code", "TEN"], store) == format_cents(905)
+    assert main(["total"], store) == "$10.05"
+
+
+def test_cli_unknown_code_echoes_typed_code():
+    store = Store()
+    store.add_code("ten", 10)
+    assert main(["total", "--code", "Save10"], store) == "unknown code: Save10"
+    assert main(["total", "--code", "no-such"], store) == "unknown code: no-such"
+
+
+def test_plain_total_and_list_unchanged():
+    store = Store()
+    store.add_item("pen", 150, 2)
+    store.add_item("pad", 399)
