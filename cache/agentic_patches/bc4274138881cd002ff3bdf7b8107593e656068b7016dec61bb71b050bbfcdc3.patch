diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..3193f2a
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,97 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.mark.parametrize("options", [
+    {"max_attempts": 0}, {"base_delay": 0}, {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_options(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_retries_backoff_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise RuntimeError("broken")
+
+    job = queue.submit("bad", fail)
+    for time, next_time in [(0, 2), (2, 5), (5, 8)]:
+        clock.t = time
+        assert worker.run_due() == 1
+        assert job.run_at == next_time
+        assert worker.run_due() == 0
+    clock.t = 8
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 4, "RuntimeError('broken')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_retry_order_success_and_attempt_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append("flaky")
+        if len(calls) == 1:
+            clock.t = 10
+            raise ValueError("once")
+
+    job = queue.submit("flaky", flaky)
+    assert worker.run_due() == 1
+    assert job.run_at == 2
+    queue.submit("later", lambda: calls.append("later"), delay=-8)
+    assert worker.run_due() == 2
+    assert calls == ["flaky", "flaky", "later"]
+    assert job.attempts == 2
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_retry_is_not_run_again_in_same_call():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail():
+        clock.t = 100
+        raise ValueError()
+
+    queue.submit("bad", fail)
+    assert worker.run_due() == 1
+    assert len(queue) == 1
+
+
+def test_base_exception_propagates_and_preserves_other_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    interrupt = KeyboardInterrupt()
+
+    def stop():
+        raise interrupt
+
+    job = queue.submit("stop", stop)
+    queue.submit("other", lambda: None)
+    with pytest.raises(KeyboardInterrupt) as caught:
+        worker.run_due()
+    assert caught.value is interrupt
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
