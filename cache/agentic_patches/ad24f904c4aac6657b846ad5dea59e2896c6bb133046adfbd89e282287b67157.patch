--- a/kvcache/cache.py
+++ b/kvcache/cache.py
@@ -18,24 +18,45 @@ class TTLCache:
         self._data: OrderedDict = OrderedDict()  # key -> (value, expires_at); last item is most recently used
         self.stats = Stats()
 
+    def _is_expired(self, expires_at) -> bool:
+        return self.clock() >= expires_at
+
+    def _drop(self, key) -> None:
+        del self._data[key]
+        self.stats.expirations += 1
+
+    def _purge_expired(self) -> None:
+        dead = [key for key, (_, expires_at) in self._data.items() if self._is_expired(expires_at)]
+        for key in dead:
+            self._drop(key)
+
     def get(self, key, default=None):
         if key not in self._data:
             self.stats.misses += 1
             return default
         value, expires_at = self._data[key]
-        self.stats.hits += 1
-        if self.clock() > expires_at:
-            del self._data[key]
-            self.stats.expirations += 1
+        if self._is_expired(expires_at):
+            self._drop(key)
+            self.stats.misses += 1
             return default
+        self.stats.hits += 1
         self._data.move_to_end(key)
         return value
 
     def put(self, key, value) -> None:
-        self._data[key] = (value, self.clock() + self.ttl)
-        if len(self._data) > self.capacity:
+        expires_at = self.clock() + self.ttl
+        if key in self._data:
+            _, old_expires = self._data[key]
+            if self._is_expired(old_expires):
+                self.stats.expirations += 1
+            self._data[key] = (value, expires_at)
+            self._data.move_to_end(key)
+            return
+        self._purge_expired()
+        while len(self._data) >= self.capacity:
             self._data.popitem(last=False)
             self.stats.evictions += 1
+        self._data[key] = (value, expires_at)
 
     def __len__(self) -> int:
-        return len(self._data)
+        return sum(1 for _, expires_at in self._data.values() if not self._is_expired(expires_at))
