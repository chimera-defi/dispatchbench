diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..8b3a8e4
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,68 @@
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+def test_entry_absent_at_exact_expiry():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(10)
+    assert cache.get("a") is None
+    assert len(cache) == 0
+
+
+def test_entry_present_just_before_expiry():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(9)
+    assert cache.get("a") == 1
+    assert len(cache) == 1
+
+
+def test_put_overwrite_counts_as_use():
+    clock = FakeClock()
+    cache = TTLCache(2, 100, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.put("a", 3)  # a is now most recently used
+    cache.put("c", 4)
+    assert cache.get("b") is None
+    assert cache.get("a") == 3
+    assert cache.get("c") == 4
+    assert cache.stats.evictions == 1
+
+
+def test_expired_get_is_miss_not_hit():
+    clock = FakeClock()
+    cache = TTLCache(2, 5, clock)
+    cache.put("a", 1)
+    clock.advance(5)
+    assert cache.get("a") is None
+    assert cache.stats.hits == 0
+    assert cache.stats.misses == 1
+    assert cache.stats.expirations == 1
+
+
+def test_put_drops_expired_before_evicting_live():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("old", 1)
+    clock.advance(10)
+    cache.put("live", 2)
+    cache.put("new", 3)
+    assert cache.get("old") is None
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+    assert cache.stats.evictions == 0
+    assert cache.stats.expirations >= 1
+    assert len(cache) == 2
+
+
+def test_len_ignores_expired_entries():
+    clock = FakeClock()
+    cache = TTLCache(2, 4, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(4)
+    assert len(cache) == 0
