diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..caed5fa
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,112 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_same_section_forward_and_nested_references():
+    config = load("[app]\nurl = https://${host}:${port}/${path}\nhost = ${name}.test\n"
+                  "name = example\nport = 8080\npath = api\n")
+    assert config["app"] == {
+        "url": "https://example.test:8080/api",
+        "host": "example.test",
+        "name": "example",
+        "port": "8080",
+        "path": "api",
+    }
+
+
+def test_qualified_dotted_and_unnamed_section_references():
+    config = load("root = base\ncopy = ${root}\n[app]\n"
+                  "value = ${a.b.c}/${.root}/${copy}\ncopy = local\n"
+                  "[a.b]\nc = ${.copy}\n")
+    assert config["app"]["value"] == "base/base/local"
+    assert config["a.b"]["c"] == "base"
+
+
+def test_nested_references_use_the_target_section():
+    config = load("[app]\nvalue = ${db.host}\nhostname = wrong\n"
+                  "[db]\nhost = ${hostname}\nhostname = localhost\n")
+    assert config["app"]["value"] == "localhost"
+
+
+def test_dollar_escapes_are_not_resolved_again():
+    config = load("literal = $${missing}\ncopy = ${literal}\n"
+                  "mixed = $$$$ $${literal} $$${copy}\n")
+    assert config[""]["literal"] == "${missing}"
+    assert config[""]["copy"] == "${missing}"
+    assert config[""]["mixed"] == "$$ ${literal} $${missing}"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", "absent.host", "a.b.c", ".key", ""])
+def test_unknown_reference_preserves_the_written_name(reference):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[app]\nvalue = ${{{reference}}}\n[db]\nhost = localhost\n")
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "cost $5", "$x", "$$$", "${", "prefix ${key"])
+def test_malformed_dollars_report_the_definition_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"# comment\n\n[app]\nvalue = {value}\n")
+    assert exc.value.line == 4
+
+
+@pytest.mark.parametrize("bad_value", ["${missing}", "$x", "${unfinished"])
+def test_nested_errors_report_the_outermost_definition_line(bad_value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"# comment\n[app]\nouter = ${{middle}}\nmiddle = ${{inner}}\ninner = {bad_value}\n")
+    assert exc.value.line == 3
+
+
+@pytest.mark.parametrize(
+    ("text", "chain", "line"),
+    [
+        ("[a]\nx = ${y}\ny = ${x}\n", "a.x -> a.y -> a.x", 2),
+        ("x = ${x}\n", ".x -> .x", 1),
+        ("[a]\nouter = ${b.x}\n[b]\nx = ${y}\ny = ${x}\n", "b.x -> b.y -> b.x", 2),
+        ("x = ${a.y}\n[a]\ny = ${.x}\n", ".x -> a.y -> .x", 1),
+    ],
+)
+def test_cycles_report_only_the_cycle_and_the_outermost_line(text, chain, line):
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == f"reference cycle: {chain}"
+    assert exc.value.line == line
+
+
+def test_keys_are_resolved_in_file_order_across_reopened_sections():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nok = yes\n[b]\nx = ${x}\n[a]\ny = ${y}\n")
+    assert str(exc.value) == "reference cycle: b.x -> b.x"
+    assert exc.value.line == 4
+
+
+def test_references_are_resolved_left_to_right():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nouter = ${right} ${left}\nleft = ${left}\nright = ${right}\n")
+    assert str(exc.value) == "reference cycle: a.right -> a.right"
+    assert exc.value.line == 2
+
+
+def test_parse_keeps_raw_values_and_existing_structure():
+    text = "# comment\nroot = $${literal}\n[app]\nvalue = ${.root}\n[empty]\n[app]\nblank = \n"
+    assert parse(text) == {
+        "": {"root": "$${literal}"},
+        "app": {"value": "${.root}", "blank": ""},
+        "empty": {},
+    }
+    assert load(text) == {
+        "": {"root": "${literal}"},
+        "app": {"value": "${literal}", "blank": ""},
+        "empty": {},
+    }
+
+
+def test_parsing_finishes_before_resolving_values():
+    with pytest.raises(ConfigError) as exc:
+        load("value = ${missing}\nvalue = duplicate\n")
+    assert str(exc.value) == "line 2: duplicate key 'value'"
+    assert exc.value.line == 2
