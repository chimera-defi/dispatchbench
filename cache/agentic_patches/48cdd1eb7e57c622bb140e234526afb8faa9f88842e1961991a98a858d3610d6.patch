-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    values, lines = _parse(text)
+    resolved: dict[tuple[str, str], str] = {}
+    active: list[tuple[str, str]] = []
+
+    def resolve(section: str, key: str) -> str:
+        name = (section, key)
+        if name in resolved:
+            return resolved[name]
+        if name in active:
+            cycle = active[active.index(name):] + [name]
+            chain = " -> ".join(f"{s}.{k}" for s, k in cycle)
+            raise ConfigError(f"reference cycle: {chain}")
+
+        active.append(name)
+        value = values[section][key]
+        parts: list[str] = []
+        pos = 0
+        while pos < len(value):
+            dollar = value.find("$", pos)
+            if dollar == -1:
+                parts.append(value[pos:])
+                break
+            parts.append(value[pos:dollar])
+            if value.startswith("$$", dollar):
+                parts.append("$")
+                pos = dollar + 2
+            elif value.startswith("${", dollar):
+                end = value.find("}", dollar + 2)
+                if end == -1:
+                    raise ConfigError("unterminated reference")
+                reference = value[dollar + 2:end]
+                if "." in reference:
+                    target_section, _, target_key = reference.rpartition(".")
+                else:
+                    target_section, target_key = section, reference
+                if target_section not in values or target_key not in values[target_section]:
+                    raise ConfigError(f"unknown reference: {reference}")
+                parts.append(resolve(target_section, target_key))
+                pos = end + 1
+            else:
+                raise ConfigError("invalid dollar escape")
+
+        active.pop()
+        resolved[name] = "".join(parts)
+        return resolved[name]
+
+    # The line mapping follows file order, even when sections are reopened.
+    for section, key in lines:
+        try:
+            resolve(section, key)
+        except ConfigError as error:
+            error.line = lines[section, key]
+            raise
+
+    return {
+        section: {key: resolved[section, key] for key in entries}
+        for section, entries in values.items()
+    }
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
