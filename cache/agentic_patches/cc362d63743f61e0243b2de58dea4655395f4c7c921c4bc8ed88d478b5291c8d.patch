diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..f07af52
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,43 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+@pytest.mark.parametrize(
+    ("cents", "pct", "expected"),
+    [(1005, 10, 905), (1004, 10, 904), (123, 0, 123),
+     (123, 100, 0), (-1005, 10, -905)],
+)
+def test_apply_percent(cents, pct, expected):
+    assert apply_percent(cents, pct) == expected
+
+
+@pytest.mark.parametrize("pct", [-1, 101, 1.5, "10", True, None])
+def test_invalid_percent(pct):
+    with pytest.raises(ValueError):
+        apply_percent(100, pct)
+    store = Store()
+    with pytest.raises(ValueError):
+        store.add_code("sale", pct)
+
+
+def test_codes_apply_to_whole_total_and_ignore_case():
+    store = Store()
+    store.add_item("first", 5)
+    store.add_item("second", 5)
+    store.add_code("SaLe", 10)
+    assert store.total_cents() == 10
+    assert store.total_cents("SALE") == 9
+    assert main(["total", "--code", "sale"], store) == "$0.09"
+    assert main(["total"], store) == "$0.10"
+    with pytest.raises(ValueError):
+        store.add_code("sAlE", 20)
+
+
+def test_unknown_code():
+    store = Store()
+    with pytest.raises(KeyError):
+        store.total_cents("Missing")
+    assert main(["total", "--code", "Missing"], store) == "unknown code: Missing"
