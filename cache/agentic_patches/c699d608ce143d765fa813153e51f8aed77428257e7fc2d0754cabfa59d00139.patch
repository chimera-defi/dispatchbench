-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse_with_locations
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    raw, locations = _parse_with_locations(text)
+    resolved: dict[str, dict[str, str]] = {section: {} for section in raw}
+    active: list[tuple[str, str]] = []
+    active_positions: dict[tuple[str, str], int] = {}
+
+    def fail(message: str, line: int) -> None:
+        # Resolution errors retain their exact message while exposing the source line.
+        error = ConfigError(message)
+        error.line = line
+        raise error
+
+    def resolve(section: str, key: str, line: int) -> str:
+        name = (section, key)
+        if key in resolved[section]:
+            return resolved[section][key]
+        if name in active_positions:
+            cycle = active[active_positions[name]:] + [name]
+            fail("reference cycle: " + " -> ".join(f"{s}.{k}" for s, k in cycle), line)
+        active_positions[name] = len(active)
+        active.append(name)
+        value = raw[section][key]
+        parts: list[str] = []
+        i = 0
+        while i < len(value):
+            if value[i] != "$":
+                parts.append(value[i])
+                i += 1
+            elif i + 1 < len(value) and value[i + 1] == "$":
+                parts.append("$")
+                i += 2
+            elif i + 1 < len(value) and value[i + 1] == "{":
+                end = value.find("}", i + 2)
+                if end == -1:
+                    fail("unterminated reference", line)
+                reference = value[i + 2:end]
+                if "." in reference:
+                    target_section, _, target_key = reference.rpartition(".")
+                else:
+                    target_section, target_key = section, reference
+                if target_section not in raw or target_key not in raw[target_section]:
+                    fail(f"unknown reference: {reference}", line)
+                parts.append(resolve(target_section, target_key, line))
+                i = end + 1
+            else:
+                fail("invalid dollar sign", line)
+        active.pop()
+        del active_positions[name]
+        result = "".join(parts)
+        resolved[section][key] = result
+        return result
+
+    for section, key, line in locations:
+        resolve(section, key, line)
+    # Preserve the parser's key order even when dependencies resolved earlier.
+    return {section: {key: resolved[section][key] for key in values}
+            for section, values in raw.items()}
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
