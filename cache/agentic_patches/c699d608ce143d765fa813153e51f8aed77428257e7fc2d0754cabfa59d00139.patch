diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..6e0ab2a
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,57 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_escaping():
+    text = """root = base
+[a.b]
+x = ${y}/${.root}/$$/${a.b.z}
+y = ${z}!
+z = end
+literal = $${z} $$$${z}
+"""
+    config = load(text)
+    assert config['a.b']['x'] == 'end!/base/$/end'
+    assert config['a.b']['literal'] == '${z} $${z}'
+    assert list(config['a.b']) == ['x', 'y', 'z', 'literal']
+    assert parse(text)['a.b']['x'] == '${y}/${.root}/$$/${a.b.z}'
+
+
+@pytest.mark.parametrize('reference', ['missing', 'db.hostt', '.missing', 'a.b.missing'])
+def test_unknown_reference(reference):
+    with pytest.raises(ConfigError) as exc:
+        load(f'[a]\nx = ${{{reference}}}\n')
+    assert str(exc.value) == f'unknown reference: {reference}'
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize('value', ['$', '$x', '${broken'])
+def test_bad_syntax_in_dependency_reports_outer_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f'[a]\nx = ${{y}}\ny = {value}\n')
+    assert exc.value.line == 2
+
+
+def test_cycle_reports_repeated_chain_and_outer_line():
+    with pytest.raises(ConfigError) as exc:
+        load('[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n')
+    assert str(exc.value) == 'reference cycle: a.x -> a.y -> a.x'
+    assert exc.value.line == 2
+
+
+def test_file_order_and_left_to_right_select_cycle():
+    text = '[a]\n[b]\nfirst = ${a.x} ${b.first}\n[a]\nx = ${x}\n'
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == 'reference cycle: a.x -> a.x'
+    assert exc.value.line == 3
+
+
+def test_unnamed_cycle():
+    with pytest.raises(ConfigError) as exc:
+        load('x = ${.y}\ny = ${x}\n')
+    assert str(exc.value) == 'reference cycle: .x -> .y -> .x'
+    assert exc.value.line == 1
