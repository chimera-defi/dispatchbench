diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..a4832d1
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,58 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_escapes_and_nested_values():
+    text = """root = world
+[a.b]
+name = ${.root}
+greeting = Hello ${name}! $$${other} $${name}
+other = ${last}
+last = done
+[a]
+value = ${a.b.greeting}
+"""
+    config = load(text)
+    assert config['a']['value'] == 'Hello world! $done ${name}'
+    assert parse(text)['a.b']['name'] == '${.root}'
+
+
+@pytest.mark.parametrize('reference', ['missing', 'db.hostt', '.absent', 'a.b.c'])
+def test_missing_reference_preserves_name_and_outer_line(reference):
+    text = '[a]\nfirst = ${second}\nsecond = ${' + reference + '}\n'
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert f'unknown reference: {reference}' in str(exc.value)
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize('value', ['${unfinished', '$x', 'end$'])
+def test_invalid_reference_syntax_has_outer_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load('first = ${second}\nsecond = ' + value + '\n')
+    assert exc.value.line == 1
+
+
+def test_cycle_chain_starts_at_first_repeated_key():
+    with pytest.raises(ConfigError) as exc:
+        load('[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n')
+    assert str(exc.value) == 'reference cycle: a.x -> a.y -> a.x'
+    assert exc.value.line == 2
+
+
+def test_cycle_selection_uses_file_order_and_reference_order():
+    text = '[a]\none = ok\n[b]\nfirst = ${second} ${first}\nsecond = ${first}\n[a]\nlater = ${later}\n'
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == 'reference cycle: b.first -> b.second -> b.first'
+    assert exc.value.line == 4
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as exc:
+        load('x = ${y}\ny = ${.x}\n')
+    assert str(exc.value) == 'reference cycle: .x -> .y -> .x'
+    assert exc.value.line == 1
