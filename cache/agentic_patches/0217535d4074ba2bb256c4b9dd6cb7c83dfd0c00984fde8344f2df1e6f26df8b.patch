index bb91b18..a87885a 100644
--- a/inv/cli.py
+++ b/inv/cli.py
@@ -8,6 +8,12 @@ def main(argv: list[str], store: Store) -> str:
         return "usage: total | list"
     cmd = argv[0]
     if cmd == "total":
+        if len(argv) >= 3 and argv[1] == "--code":
+            code = argv[2]
+            try:
+                return format_cents(store.total_cents(code))
+            except KeyError:
+                return f"unknown code: {code}"
         return format_cents(store.total_cents())
     if cmd == "list":
         return "\n".join(f"{i.name} x{i.qty} {format_cents(i.line_total())}" for i in store.items.values())
diff --git a/inv/money.py b/inv/money.py
index caa7f2f..f497081 100644
--- a/inv/money.py
+++ b/inv/money.py
@@ -3,3 +3,12 @@ def format_cents(cents: int) -> str:
     sign = "-" if cents < 0 else ""
     cents = abs(cents)
     return f"{sign}${cents // 100}.{cents % 100:02d}"
+
+
+def apply_percent(cents: int, pct: int) -> int:
+    """Apply a percentage discount, rounding half up to a whole cent."""
+    if type(pct) is not int or not 0 <= pct <= 100:
+        raise ValueError("percentage must be an integer from 0 to 100")
+    numerator = cents * (100 - pct)
+    sign = -1 if numerator < 0 else 1
+    return sign * ((abs(numerator) + 50) // 100)
diff --git a/inv/store.py b/inv/store.py
index c8a5bb8..5fe5cdf 100644
--- a/inv/store.py
+++ b/inv/store.py
@@ -1,9 +1,18 @@
 from .models import Item
+from .money import apply_percent
 
 
 class Store:
     def __init__(self):
         self.items: dict[str, Item] = {}
+        self.codes: dict[str, int] = {}
+
+    def add_code(self, code: str, pct: int) -> None:
+        normalized = code.casefold()
+        if normalized in self.codes:
+            raise ValueError("code already exists")
+        apply_percent(0, pct)
+        self.codes[normalized] = pct
 
     def add_item(self, name: str, price_cents: int, qty: int = 1) -> None:
         if name in self.items:
@@ -14,5 +23,8 @@ class Store:
     def remove_item(self, name: str) -> None:
         del self.items[name]
 
-    def total_cents(self) -> int:
-        return sum(i.line_total() for i in self.items.values())
+    def total_cents(self, code: str | None = None) -> int:
+        total = sum(i.line_total() for i in self.items.values())
+        if code is not None:
+            total = apply_percent(total, self.codes[code.casefold()])
+        return total
