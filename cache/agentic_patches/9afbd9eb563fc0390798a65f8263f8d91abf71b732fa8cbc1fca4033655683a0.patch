diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..dd394fa
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,112 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.mark.parametrize("options", [
+    {"max_attempts": 0}, {"base_delay": 0},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_configuration(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_retry_backoff_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise ValueError("broken")
+
+    job = queue.submit("bad", fail)
+    for attempt, next_time in [(1, 2), (2, 5), (3, 8)]:
+        assert worker.run_due() == 1
+        assert job.attempts == attempt and job.run_at == next_time
+        assert worker.run_due() == 0
+        clock.t = next_time
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 4, "ValueError('broken')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_retry_success_and_original_sequence():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        log.append("retry")
+        if len(log) == 1:
+            raise RuntimeError("once")
+
+    job = queue.submit("first", flaky)
+    assert worker.run_due() == 1
+    queue.submit("second", lambda: log.append("second"), delay=2)
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert log == ["retry", "retry", "second"]
+    assert job.attempts == 2
+    assert worker.done == ["first", "second"]
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_attempt_time_and_due_snapshot():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail_after_clock_moves():
+        clock.t = 100
+        raise RuntimeError()
+
+    job = queue.submit("bad", fail_after_clock_moves)
+    queue.submit("later", lambda: None, delay=1)
+    assert worker.run_due() == 1
+    assert job.run_at == 2
+    assert worker.run_due() == 2
+
+
+def test_interrupt_propagates_and_preserves_unrun_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def interrupt():
+        raise KeyboardInterrupt("stop")
+
+    job = queue.submit("interrupted", interrupt)
+    queue.submit("waiting", lambda: None)
+    with pytest.raises(KeyboardInterrupt, match="stop"):
+        worker.run_due()
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert worker.done == ["waiting"]
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
+
+
+def test_one_attempt_and_dead_order():
+    queue = JobQueue(Clock())
+    worker = Worker(queue, max_attempts=1)
+
+    def fail():
+        raise LookupError("no")
+
+    queue.submit("a", fail)
