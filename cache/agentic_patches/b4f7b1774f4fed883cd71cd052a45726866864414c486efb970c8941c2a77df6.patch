diff --git a/kvcache/cache.py b/kvcache/cache.py
index be3061f..a095dc2 100644
--- a/kvcache/cache.py
+++ b/kvcache/cache.py
@@ -23,19 +23,30 @@ class TTLCache:
             self.stats.misses += 1
             return default
         value, expires_at = self._data[key]
-        self.stats.hits += 1
-        if self.clock() > expires_at:
+        if self.clock() >= expires_at:
             del self._data[key]
             self.stats.expirations += 1
+            self.stats.misses += 1
             return default
+        self.stats.hits += 1
         self._data.move_to_end(key)
         return value
 
     def put(self, key, value) -> None:
-        self._data[key] = (value, self.clock() + self.ttl)
+        now = self.clock()
+        self._expire(now)
+        self._data[key] = (value, now + self.ttl)
+        self._data.move_to_end(key)
         if len(self._data) > self.capacity:
             self._data.popitem(last=False)
             self.stats.evictions += 1
 
+    def _expire(self, now) -> None:
+        expired = [key for key, (_, expires_at) in self._data.items() if now >= expires_at]
+        for key in expired:
+            del self._data[key]
+        self.stats.expirations += len(expired)
+
     def __len__(self) -> int:
+        self._expire(self.clock())
         return len(self._data)
diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..c4e3469
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,67 @@
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+def test_expiration_boundary_is_a_miss():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(9)
+    assert cache.get("a") == 1
+    clock.advance(1)
+    assert cache.get("a", "missing") == "missing"
+    assert (cache.stats.hits, cache.stats.misses, cache.stats.expirations) == (1, 1, 1)
+    assert cache.get("a") is None
+    assert (cache.stats.misses, cache.stats.expirations) == (2, 1)
+
+
+def test_overwrite_updates_recency():
+    cache = TTLCache(2, 10, FakeClock())
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.put("a", 3)
+    cache.put("c", 4)
+    assert cache.get("a") == 3
+    assert cache.get("b") is None
+    assert cache.get("c") == 4
+    assert cache.stats.evictions == 1
+
+
+def test_expired_most_recent_entry_does_not_evict_live_entry():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("old", 1)
+    clock.advance(5)
+    cache.put("live", 2)
+    assert cache.get("old") == 1  # Expired entry will be most recently used.
+    clock.advance(5)
+    cache.put("new", 3)
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+
+
+def test_len_removes_only_expired_entries_and_counts_them_once():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("old", 1)
+    clock.advance(5)
+    cache.put("live", 2)
+    clock.advance(5)
+    assert len(cache) == 1
+    assert len(cache) == 1
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+    assert cache.get("live") == 2
+
+
+def test_overwriting_expired_entry_counts_expiration():
+    clock = FakeClock()
+    cache = TTLCache(1, 10, clock)
+    cache.put("a", 1)
+    clock.advance(10)
+    cache.put("a", 2)
+    assert cache.get("a") == 2
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
