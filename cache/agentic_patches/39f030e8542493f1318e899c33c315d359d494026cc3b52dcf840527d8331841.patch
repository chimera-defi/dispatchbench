diff --git a/cfg/loader.py b/cfg/loader.py
index acd880f..728ed4b 100644
--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,79 @@
-from .parser import parse
+from typing import NoReturn
+
+from .errors import ConfigError
+from .parser import parse_with_locations
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    raw, order = parse_with_locations(text)
+    resolved: dict[tuple[str, str], str] = {}
+
+    def fail(message: str, line: int) -> NoReturn:
+        # Line stays on the attribute. The exception text is the message alone
+        # so cycle text can match exactly while `.line` is still set.
+        err = ConfigError(message)
+        err.line = line
+        raise err
+
+    def resolve(section: str, key: str, stack: list[tuple[str, str]], origin: int) -> str:
+        ident = (section, key)
+        if ident in resolved:
+            return resolved[ident]
+        if ident in stack:
+            start = stack.index(ident)
+            chain = [f"{sec}.{name}" for sec, name in stack[start:] + [ident]]
+            fail(f"reference cycle: {' -> '.join(chain)}", origin)
+        stack.append(ident)
+        try:
+            value = expand(raw[section][key], section, stack, origin)
+        finally:
+            stack.pop()
+        resolved[ident] = value
+        return value
+
+    def resolve_ref(ref: str, section: str, stack: list[tuple[str, str]], origin: int) -> str:
+        if "." in ref:
+            sec, _, key = ref.rpartition(".")
+        else:
+            sec, key = section, ref
+        if sec not in raw or key not in raw[sec]:
+            fail(f"unknown reference: {ref}", origin)
+        return resolve(sec, key, stack, origin)
+
+    def expand(value: str, section: str, stack: list[tuple[str, str]], origin: int) -> str:
+        parts: list[str] = []
+        i = 0
+        n = len(value)
+        while i < n:
+            dollar = value.find("$", i)
+            if dollar < 0:
+                parts.append(value[i:])
+                break
+            if dollar > i:
+                parts.append(value[i:dollar])
+            if dollar + 1 < n and value[dollar + 1] == "$":
+                parts.append("$")
+                i = dollar + 2
+                continue
+            if dollar + 1 < n and value[dollar + 1] == "{":
+                end = value.find("}", dollar + 2)
+                if end < 0:
+                    fail("unterminated '${'", origin)
+                ref = value[dollar + 2 : end]
+                parts.append(resolve_ref(ref, section, stack, origin))
+                i = end + 1
+                continue
+            fail("unexpected '$'", origin)
+        return "".join(parts)
+
+    for section, key, line in order:
+        resolve(section, key, [], line)
+
+    return {
+        section: {key: resolved[(section, key)] for key in keys}
+        for section, keys in raw.items()
+    }
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
