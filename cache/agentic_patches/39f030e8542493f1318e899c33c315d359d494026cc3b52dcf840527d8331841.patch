+
+def parse_with_locations(
+    text: str,
+) -> tuple[dict[str, dict[str, str]], list[tuple[str, str, int]]]:
+    """Parse like `parse` and return `(section, key, line)` entries in file order.
+
+    `line` is the 1-based line where that key was defined. Values are still raw.
