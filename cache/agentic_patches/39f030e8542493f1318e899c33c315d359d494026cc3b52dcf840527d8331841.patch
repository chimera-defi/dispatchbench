diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..24bb88c
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,255 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import get, load
+from cfg.parser import parse
+
+
+def test_same_section_cross_section_and_text():
+    text = """\
+name = app
+[db]
+host = localhost
+port = 5432
+net = ${host}:${port}
+url = postgres://${net}/${.name}
+"""
+    c = load(text)
+    assert get(c, "db.net") == "localhost:5432"
+    assert get(c, "db.url") == "postgres://localhost:5432/app"
+    assert get(c, "name") == "app"
+
+
+def test_dotted_section_splits_on_last_dot():
+    text = """\
+[a.b]
+c = hello
+[a]
+b.c = no
+[x]
+y = ${a.b.c}
+z = pre-${a.b.c}-post
+"""
+    c = load(text)
+    assert get(c, "x.y") == "hello"
+    assert get(c, "x.z") == "pre-hello-post"
+    assert c["a"]["b.c"] == "no"
+
+
+def test_unnamed_section_and_short_name_does_not_fall_back():
+    text = """\
+base = root
+[db]
+host = ${.base}
+"""
+    assert get(load(text), "db.host") == "root"
+
+    with pytest.raises(ConfigError) as e:
+        load("base = root\n[db]\nhost = ${base}\n")
+    assert str(e.value) == "unknown reference: base"
+    assert e.value.line == 3
+
+
+def test_several_refs_forward_and_nested_values():
+    text = """\
+a = (${b})/${c}/${b}
+b = [${d}]
+c = ${d}-ok
+d = X
+"""
+    c = load(text)
+    assert c[""]["d"] == "X"
+    assert c[""]["b"] == "[X]"
+    assert c[""]["c"] == "X-ok"
+    assert c[""]["a"] == "([X])/X-ok/[X]"
+
+
+def test_dollar_escape_is_literal_and_not_rescanned():
+    text = """\
+price = $$5
+literal = $${not.a.ref}
+odd = $$$$
+b = $$not
+a = ${b}
+wrapped = ${literal}
+"""
+    c = load(text)
+    assert c[""]["price"] == "$5"
+    assert c[""]["literal"] == "${not.a.ref}"
+    assert c[""]["odd"] == "$$"
+    assert c[""]["b"] == "$not"
+    assert c[""]["a"] == "$not"
+    assert c[""]["wrapped"] == "${not.a.ref}"
+
+
+def test_parse_keeps_raw_values():
+    raw = parse("a = ${b}\nb = c\nprice = $$5\n")
+    assert raw[""]["a"] == "${b}"
+    assert raw[""]["price"] == "$$5"
+    assert load("a = ${b}\nb = c\n")[""]["a"] == "c"
+
+
+def test_unknown_reference_uses_the_written_name_and_outer_line():
+    with pytest.raises(ConfigError) as e:
+        load("[db]\nhost = ${db.hostt}\n")
+    assert str(e.value) == "unknown reference: db.hostt"
+    assert e.value.line == 2
+
+    with pytest.raises(ConfigError) as e:
+        load("[db]\nhost = ${missing}\n")
+    assert str(e.value) == "unknown reference: missing"
+    assert e.value.line == 2
+
+    with pytest.raises(ConfigError) as e:
+        load("[db]\nhost = ${.missing}\n")
+    assert str(e.value) == "unknown reference: .missing"
+
+    with pytest.raises(ConfigError) as e:
+        load("x = ${a.b.c}\n")
+    assert str(e.value) == "unknown reference: a.b.c"
+    assert e.value.line == 1
+
+    text = """\
+[s]
+a = ${b}
+
+# inner is the bad one
+b = ${no.such}
+"""
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "unknown reference: no.such"
+    assert e.value.line == 2
+
+
+def test_unknown_in_later_key_uses_that_keys_line():
+    text = """\
+# comment
+
+[db]
+host = localhost
+name = ${db.hostt}
+"""
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 5
+    assert str(e.value) == "unknown reference: db.hostt"
+
+
+def test_self_and_mutual_cycles():
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = ${x}\n")
+    assert str(e.value) == "reference cycle: a.x -> a.x"
+    assert e.value.line == 2
+
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = ${y}\ny = ${x}\n")
+    assert str(e.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert e.value.line == 2
+
+    with pytest.raises(ConfigError) as e:
+        load("x = ${y}\ny = ${z}\nz = ${x}\n")
+    assert str(e.value) == "reference cycle: .x -> .y -> .z -> .x"
+    assert e.value.line == 1
+
+
+def test_cycle_chain_starts_at_the_repeated_key_and_line_is_outermost():
+    text = """\
+[s]
+a = ${b}
+b = ${c}
+c = ${b}
+"""
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "reference cycle: s.b -> s.c -> s.b"
+    assert e.value.line == 2
+
+
+def test_dotted_section_cycle_names():
+    text = """\
+[a.b]
+c = ${d}
+d = ${a.b.c}
+"""
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "reference cycle: a.b.c -> a.b.d -> a.b.c"
+    assert e.value.line == 2
+
+
+def test_cycle_across_unnamed_section():
+    text = """\
+x = ${a.y}
+[a]
+y = ${.x}
+"""
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "reference cycle: .x -> a.y -> .x"
+    assert e.value.line == 1
+
+
+def test_file_order_reports_the_first_cycle():
+    text = """\
+[a]
+p = 1
+[b]
+x = ${y}
+y = ${x}
+[a]
+q = ${q}
+"""
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "reference cycle: b.x -> b.y -> b.x"
+    assert e.value.line == 4
+
+
+def test_refs_in_a_value_resolve_left_to_right():
+    text = """\
+[s]
+a = ${b}${d}
+b = ${c}
+c = ${b}
+d = ${e}
+e = ${d}
+"""
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "reference cycle: s.b -> s.c -> s.b"
+    assert e.value.line == 2
+
+
+def test_unterminated_and_bare_dollar():
+    with pytest.raises(ConfigError) as e:
+        load("a = ${foo\n")
+    assert e.value.line == 1
+    assert "unterminated" in str(e.value)
+
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = pre ${foo\n")
+    assert e.value.line == 2
+
+    with pytest.raises(ConfigError) as e:
+        load("a = $bad\n")
+    assert e.value.line == 1
+
+    with pytest.raises(ConfigError) as e:
+        load("a = $$\nb = $$$\n")
+    assert e.value.line == 2
+
+    text = """\
+[s]
+a = ${b}
+b = $bad
+"""
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 2
+
+
+def test_empty_sections_and_plain_values_stay():
+    c = load("# only\n\n[a]\n\n[b]\n")
+    assert c == {"": {}, "a": {}, "b": {}}
+    assert load("a =\nb = x${a}y\n")[""]["b"] == "xy"
