diff --git a/cfg/loader.py b/cfg/loader.py
index acd880f..ca86360 100644
--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,91 @@
-from .parser import parse
+from .errors import ConfigError
+from .parser import _scan
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    sections, order = _scan(text)
+    resolved: dict[tuple[str, str], str] = {}
+    # Stack identity is (section, key). Display names collide when a section contains dots
+    # (section "a.b" key "c" and section "a" key "b.c" both print as a.b.c).
+    stack: list[tuple[str, str]] = []
+    stack_set: set[tuple[str, str]] = set()
+
+    def resolve_key(section: str, key: str, origin_line: int) -> str:
+        ident = (section, key)
+        if ident in resolved:
+            return resolved[ident]
+        if ident in stack_set:
+            start = stack.index(ident)
+            chain = [_qualify(s, k) for s, k in stack[start:]]
+            chain.append(_qualify(section, key))
+            # Line stays on the root key even when the repeated name is deeper in the chain.
+            raise ConfigError("reference cycle: " + " -> ".join(chain), origin_line)
+        stack.append(ident)
+        stack_set.add(ident)
+        try:
+            value = _expand(sections[section][key], section, origin_line, resolve_ref)
+        finally:
+            stack.pop()
+            stack_set.discard(ident)
+        resolved[ident] = value
+        return value
+
+    def resolve_ref(ref: str, current_section: str, origin_line: int) -> str:
+        section, key = _split_ref(ref, current_section)
+        if section not in sections or key not in sections[section]:
+            raise ConfigError(f"unknown reference: {ref}", origin_line)
+        return resolve_key(section, key, origin_line)
+
+    for section, key, line in order:
+        resolve_key(section, key, line)
+    for section, key, _line in order:
+        sections[section][key] = resolved[(section, key)]
+    return sections
+
+
+def _qualify(section: str, key: str) -> str:
+    """Fully qualified name: `section.key`, or `.key` for the unnamed section."""
+    if section == "":
+        return f".{key}"
+    return f"{section}.{key}"
+
+
+def _split_ref(ref: str, current_section: str) -> tuple[str, str]:
+    """Split a reference body into (section, key). No dot means the current section."""
+    if "." not in ref:
+        return current_section, ref
+    section, _, key = ref.rpartition(".")
+    return section, key
+
+
+def _expand(raw: str, section: str, origin_line: int, resolve_ref) -> str:
+    """Replace references in `raw` left to right. `origin_line` is the root key's line."""
+    parts: list[str] = []
+    i = 0
+    n = len(raw)
+    while i < n:
+        if raw[i] != "$":
+            j = raw.find("$", i)
+            if j < 0:
