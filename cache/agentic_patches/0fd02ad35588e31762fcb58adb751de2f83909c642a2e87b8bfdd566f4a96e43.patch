index 0000000..8739af5
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,302 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import get, load
+from cfg.parser import parse
+
+
+def test_parse_leaves_references_raw():
+    raw = parse("a = ${b}\nb = c\n")
+    assert raw[""]["a"] == "${b}"
+    assert raw[""]["b"] == "c"
+
+
+def test_same_section_nested_and_text():
+    text = "\n".join([
+        "[db]",
+        "host = localhost",
+        "port = 5432",
+        "name = ${host}",
+        "dsn = postgres://${host}:${port}/app",
+        "again = ${name}-${name}",
+    ])
+    c = load(text)
+    assert get(c, "db.name") == "localhost"
+    assert get(c, "db.dsn") == "postgres://localhost:5432/app"
+    assert get(c, "db.again") == "localhost-localhost"
+
+
+def test_cross_section_last_dot_and_unnamed():
+    text = "\n".join([
+        "base = app",
+        "[a.b]",
+        "c = hello",
+        "[db]",
+        "host = ${.base}",
+        "path = ${a.b.c}/${host}",
+        "explicit = ${db.host}",
+    ])
+    c = load(text)
+    assert get(c, "base") == "app"
+    assert c["db"]["host"] == "app"
+    assert c["db"]["path"] == "hello/app"
+    assert c["db"]["explicit"] == "app"
+
+
+def test_same_section_does_not_see_unnamed_key():
+    text = "\n".join([
+        "name = app",
+        "[db]",
+        "name = dbname",
+        "label = ${name}",
+    ])
+    assert load(text)["db"]["label"] == "dbname"
+
+
+def test_dollar_escape_is_literal_and_not_rescanned():
+    text = "\n".join([
+        "[a]",
+        "x = $$",
+        "y = pre${x}post",
+        "z = $$${x}",
+        "w = ${x}${x}",
+    ])
+    c = load(text)
+    assert c["a"]["x"] == "$"
+    assert c["a"]["y"] == "pre$post"
+    assert c["a"]["z"] == "$$"
+    assert c["a"]["w"] == "$$"
+
+
+def test_chain_and_shared_target():
+    text = "\n".join([
+        "d = Z",
+        "b = ${d}",
+        "c = ${d}",
+        "a = ${b}${c}",
+    ])
+    c = load(text)
+    assert c[""]["a"] == "ZZ"
+    assert c[""]["b"] == "Z"
+
+
+def test_later_key_in_reopened_section():
+    text = "\n".join([
+        "[a]",
+        "x = ${z}",
+        "[b]",
+        "q = 1",
+        "[a]",
+        "z = hi${b.q}",
+    ])
+    assert load(text)["a"]["x"] == "hi1"
+
+
+def test_unknown_reference_uses_written_name_and_outer_line():
+    text = "\n".join([
+        "[db]",
+        "host = localhost",
+        "x = ${db.hostt}",
+        "y = ${missing}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 3
+    assert str(e.value) == "line 3: unknown reference: db.hostt"
+
+
+def test_unknown_same_section_and_missing_section():
+    text = "\n".join([
+        "[db]",
+        "x = ${hostt}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "line 2: unknown reference: hostt"
+
+    text = "\n".join([
+        "[a]",
+        "x = ${no.such}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 2
+    assert str(e.value) == "line 2: unknown reference: no.such"
+
+
+def test_nested_unknown_reports_outermost_line():
+    text = "\n".join([
+        "# comment",
+        "",
+        "[a]",
+        "x = ${y}",
+        "y = ${z}",
+        "z = ${missing}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 4
+    assert str(e.value) == "line 4: unknown reference: missing"
+
+
+def test_direct_error_uses_that_keys_line_when_it_comes_first():
+    text = "\n".join([
+        "[a]",
+        "z = ${missing}",
+        "x = ${z}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 2
+    assert str(e.value) == "line 2: unknown reference: missing"
+
+
+def test_cycle_message_and_outer_line():
+    text = "\n".join([
+        "[a]",
+        "x = ${y}",
+        "y = ${x}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 2
+    assert str(e.value) == "line 2: reference cycle: a.x -> a.y -> a.x"
+
+
+def test_cycle_starts_at_first_repeat_not_the_root():
+    text = "\n".join([
+        "[a]",
+        "x = ${y}",
+        "y = ${z}",
+        "z = ${y}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 2
+    assert str(e.value) == "line 2: reference cycle: a.y -> a.z -> a.y"
+
+
+def test_self_cycle_and_three_cycle():
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = ${x}\n")
+    assert str(e.value) == "line 2: reference cycle: a.x -> a.x"
+
+    text = "\n".join([
+        "[a]",
+        "x = ${y}",
+        "y = ${z}",
+        "z = ${x}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "line 2: reference cycle: a.x -> a.y -> a.z -> a.x"
+
+
+def test_unnamed_and_cross_section_cycles():
+    with pytest.raises(ConfigError) as e:
+        load("x = ${y}\ny = ${.x}\n")
+    assert str(e.value) == "line 1: reference cycle: .x -> .y -> .x"
+
+    text = "\n".join([
+        "[a]",
+        "x = ${b.y}",
+        "[b]",
+        "y = ${a.x}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "line 2: reference cycle: a.x -> b.y -> a.x"
+
+
+def test_file_order_picks_the_first_cycle():
+    # a is opened before b, then reopened. File order is a.x, b.y, a.z.
+    # Walking sections in dict order would enter a.z before b.y and report the reverse chain.
+    text = "\n".join([
+        "[a]",
+        "x = 1",
+        "[b]",
+        "y = ${a.z}",
+        "[a]",
+        "z = ${b.y}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 4
+    assert str(e.value) == "line 4: reference cycle: b.y -> a.z -> b.y"
+
+
+def test_left_to_right_refs_pick_the_first_cycle():
+    text = "\n".join([
+        "[a]",
+        "x = ${y}${z}",
+        "y = ${x}",
+        "z = ${x}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "line 2: reference cycle: a.x -> a.y -> a.x"
+
+    text = "\n".join([
+        "[a]",
+        "x = ${z}${y}",
+        "y = ${x}",
+        "z = ${x}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "line 2: reference cycle: a.x -> a.z -> a.x"
+
+
+def test_left_to_right_errors_stop_at_the_first_problem():
+    text = "\n".join([
+        "[a]",
+        "url = $x${missing}",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 2
+    assert str(e.value) == "line 2: unexpected $"
+
+    text = "\n".join([
+        "[a]",
+        "url = ${missing}$",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert str(e.value) == "line 2: unknown reference: missing"
+
+
+def test_unterminated_reference():
+    text = "\n".join([
+        "[a]",
+        "x = hello ${foo",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 2
+    assert str(e.value) == "line 2: unterminated ${"
+
+
+def test_unterminated_inside_nested_value_uses_outer_line():
+    text = "\n".join([
+        "[a]",
+        "x = ${y}",
+        "y = ${foo",
+    ])
+    with pytest.raises(ConfigError) as e:
+        load(text)
+    assert e.value.line == 2
+    assert str(e.value) == "line 2: unterminated ${"
+
+
+def test_lone_dollar_variants():
+    for raw in ("$", "$foo", "hello$", "pre $ post", "$ {x}"):
+        with pytest.raises(ConfigError) as e:
+            load(f"k = {raw}\n")
+        assert e.value.line == 1
+        assert str(e.value) == "line 1: unexpected $"
+
+
+def test_plain_config_unchanged():
+    text = "name = app\n# comment\n[db]\nhost = localhost\nport= 5432\n"
+    assert load(text) == parse(text)
