diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..be00dec
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,58 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_resolves_references_and_escapes():
+    text = """root = base
+[a.b]
+name = ${.root}
+message = ${name}/$$/${other}/$${name}
+other = ${last}
+last = done
+[elsewhere]
+value = ${a.b.message}
+"""
+    result = load(text)
+    assert result['a.b']['message'] == 'base/$/done/${name}'
+    assert result['elsewhere']['value'] == 'base/$/done/${name}'
+    assert parse(text)['a.b']['name'] == '${.root}'
+
+
+@pytest.mark.parametrize('reference', ['missing', 'db.hostt', '.absent', 'a.b.c'])
+def test_unknown_reference_preserves_name_and_outer_line(reference):
+    with pytest.raises(ConfigError) as exc:
+        load(f'[a]\nfirst = ${{second}}\nsecond = ${{{reference}}}\n')
+    assert str(exc.value) == f'unknown reference: {reference}'
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize('value', ['${unfinished', '$', '$x', 'text $ end'])
+def test_invalid_reference_syntax_has_outer_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f'[a]\nfirst = ${{second}}\nsecond = {value}\n')
+    assert exc.value.line == 2
+
+
+def test_cycle_reports_repeated_segment_and_outer_line():
+    with pytest.raises(ConfigError) as exc:
+        load('[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n')
+    assert str(exc.value) == 'reference cycle: a.x -> a.y -> a.x'
+    assert exc.value.line == 2
+
+
+def test_first_cycle_follows_file_order_and_reference_order():
+    text = '[a]\nfirst = ok\n[b]\nx = ${y}${x}\ny = ${x}\n[a]\nz = ${z}\n'
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == 'reference cycle: b.x -> b.y -> b.x'
+    assert exc.value.line == 4
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as exc:
+        load('x = ${y}\ny = ${.x}\n')
+    assert str(exc.value) == 'reference cycle: .x -> .y -> .x'
+    assert exc.value.line == 1
