diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..2a5c9ce
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,219 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, t=0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.mark.parametrize(
+    "options",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": -1},
+        {"base_delay": 0},
+        {"base_delay": -1},
+        {"base_delay": 3, "max_delay": 2},
+    ],
+)
+def test_rejects_invalid_options(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_default_retries_then_succeeds():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append(clock())
+        if len(calls) < 3:
+            raise ValueError("temporary")
+
+    job = queue.submit("flaky", flaky)
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    for now, expected_run_at in [(0, 2), (2, 6)]:
+        clock.t = now
+        assert worker.run_due() == 1
+        assert job.run_at == expected_run_at
+        clock.t = expected_run_at - 1
+        assert worker.run_due() == 0
+
+    clock.t = 6
+    assert worker.run_due() == 1
+    assert calls == [0, 2, 6]
+    assert job.attempts == 3
+    assert len(queue) == 0
+    assert worker.done == ["flaky"]
+    assert worker.dead == []
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 2, "dead": 0}
+
+
+def test_backoff_is_capped_and_dead_records_last_exception():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=5, base_delay=2, max_delay=5)
+    calls = []
+
+    def fail():
+        calls.append(clock())
+        raise RuntimeError(f"failure {len(calls)}")
+
+    job = queue.submit("bad", fail)
+    for now, expected_run_at in [(0, 2), (2, 6), (6, 11), (11, 16)]:
+        clock.t = now
+        assert worker.run_due() == 1
+        assert job.run_at == expected_run_at
+        assert job.attempts == len(calls)
+        assert worker.dead == []
+
+    clock.t = 16
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 5, "RuntimeError('failure 5')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 5, "dead": 1}
+    assert job.attempts == 5
+    assert len(queue) == 0
+    clock.t = 100
+    assert worker.run_due() == 0
+
+
+def test_dead_jobs_are_recorded_in_death_order():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=1, base_delay=1, max_delay=1)
+
+    def fail():
+        raise ValueError("bad")
+
+    queue.submit("later", fail, delay=1)
+    queue.submit("first", fail)
+    queue.submit("second", fail)
+    assert worker.run_due() == 2
+    clock.t = 1
+    assert worker.run_due() == 1
+    assert worker.dead == [
+        ("first", 1, "ValueError('bad')"),
+        ("second", 1, "ValueError('bad')"),
+        ("later", 1, "ValueError('bad')"),
+    ]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 3, "dead": 3}
+
+
+@pytest.mark.parametrize("exception_type", [KeyboardInterrupt, SystemExit, BaseException])
+def test_base_exception_propagates_without_requeueing(exception_type):
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    error = exception_type("stop")
+
+    def interrupt():
+        raise error
+
+    job = queue.submit("interrupt", interrupt)
+    queue.submit("remaining", lambda: None)
+    with pytest.raises(exception_type) as caught:
+        worker.run_due()
+    assert caught.value is error
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert worker.done == ["remaining"]
+
+
+def test_retry_preserves_sequence_among_equal_due_times():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append("original")
+        if len(calls) == 1:
+            raise ValueError("retry")
+
+    job = queue.submit("original", flaky)
+    original_seq = job.seq
+    queue.submit("later", lambda: calls.append("later"), delay=2)
+    assert worker.run_due() == 1
+    assert job.seq == original_seq
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert calls == ["original", "original", "later"]
+
+
+def test_delay_starts_at_attempt_time_even_if_callable_advances_clock():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    queue.submit("advance", lambda: setattr(clock, "t", 10))
+
+    def fail():
+        clock.t = 100
+        raise ValueError("retry")
+
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 2
+    assert job.run_at == 12
+    assert job.attempts == 1
+    assert len(queue) == 1
+
+
+def test_run_due_uses_initial_snapshot_even_if_clock_advances():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def submit_and_advance():
+        queue.submit("new", lambda: None)
+        clock.t = 10
+
+    queue.submit("first", submit_and_advance)
+    queue.submit("future", lambda: None, delay=1)
+    assert worker.run_due() == 1
+    assert worker.done == ["first"]
+    assert worker.run_due() == 2
+    assert worker.done == ["first", "new", "future"]
+
+
+def test_retry_is_not_run_twice_when_delay_rounds_to_now():
+    clock = Clock(float(2 ** 60))
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail():
+        raise ValueError("retry")
+
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock()
+    assert job.attempts == 1
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+
+
+def test_jobs_with_same_name_have_independent_failures():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=2)
+
+    def fail():
+        raise ValueError("retry")
+
+    first = queue.submit("same", fail)
+    second = queue.submit("same", fail)
+    assert worker.run_due() == 2
+    assert worker.dead == []
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert first.attempts == second.attempts == 2
+    assert worker.dead == [("same", 2, "ValueError('retry')")] * 2
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 2}
