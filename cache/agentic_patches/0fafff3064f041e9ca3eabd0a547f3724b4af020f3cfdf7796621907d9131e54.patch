+
         ran = 0
-        while (job := self.queue.pop_due()) is not None:
-            job.fn()
-            self.done.append(job.name)
-            ran += 1
+        try:
+            for job in jobs:
+                attempted_at = self.queue.clock()
+                job.attempts += 1
+                ran += 1
+                try:
+                    job.fn()
+                except Exception as exc:
+                    job.failures += 1
+                    self._failed_attempts += 1
+                    if job.failures >= self.max_attempts:
+                        self.dead.append((job.name, job.attempts, repr(exc)))
+                    else:
+                        delay = min(
