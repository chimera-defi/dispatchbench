@@ -0,0 +1,116 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.time = 0
+
+    def __call__(self):
+        return self.time
+
+
+@pytest.mark.parametrize("settings", [
+    {"max_attempts": 0}, {"base_delay": 0},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_settings(settings):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **settings)
+
+
+def test_retries_backoff_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise ValueError("bad")
+
+    job = queue.submit("bad", fail)
+    queue.submit("good", lambda: None)
+    assert worker.run_due() == 2
+    assert job.attempts == 1 and job.run_at == 2
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 1, "dead": 0}
+    clock.time = 1
+    assert worker.run_due() == 0
+    clock.time = 2
+    assert worker.run_due() == 1 and job.run_at == 5
+    clock.time = 5
+    assert worker.run_due() == 1 and job.run_at == 8
+    clock.time = 8
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 4, "ValueError('bad')")]
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 4, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_retry_keeps_order_and_can_succeed():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def sometimes_fails():
+        log.append("first")
+        if len(log) == 1:
+            raise RuntimeError()
+
+    job = queue.submit("first", sometimes_fails)
+    assert worker.run_due() == 1
+    queue.submit("second", lambda: log.append("second"), delay=2)
+    clock.time = 2
+    assert worker.run_due() == 2
+    assert log == ["first", "first", "second"]
+    assert job.attempts == 2
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_snapshot_and_attempt_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def advance():
+        clock.time = 100
+        queue.submit("new", lambda: None)
+
+    queue.submit("advance", advance)
+    job = queue.submit("fail", lambda: (_ for _ in ()).throw(ValueError()))
+    queue.submit("later", lambda: None, delay=1)
+    assert worker.run_due() == 2
+    assert job.run_at == 102
+    assert worker.run_due() == 2
+
+
+def test_rounding_to_now_does_not_repeat_retry():
+    clock = Clock()
+    clock.time = 10**20  # adding 1 to this float rounds back to the same value
+    clock.time = float(clock.time)
+    queue = JobQueue(clock)
+    worker = Worker(queue, base_delay=1)
+    job = queue.submit("bad", lambda: (_ for _ in ()).throw(ValueError()))
+    assert worker.run_due() == 1
+    assert job.attempts == 1 and job.run_at == clock.time
+    assert worker.run_due() == 1
+
+
+def test_base_exception_propagates_and_preserves_unstarted_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    error = KeyboardInterrupt()
+
+    def interrupt():
+        raise error
+
+    job = queue.submit("interrupt", interrupt)
+    queue.submit("remaining", lambda: None)
+    with pytest.raises(KeyboardInterrupt) as caught:
+        worker.run_due()
+    assert caught.value is error
+    assert job.attempts == 1 and len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1 and worker.done == ["remaining"]
