diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..b8191f9
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,50 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+@pytest.mark.parametrize("cents,pct,expected", [
+    (1005, 10, 905),
+    (1004, 10, 904),
+    (123, 0, 123),
+    (123, 100, 0),
+    (-1005, 10, -905),
+])
+def test_apply_percent(cents, pct, expected):
+    assert apply_percent(cents, pct) == expected
+
+
+@pytest.mark.parametrize("pct", [-1, 101, 1.5, "10", None, True])
+def test_invalid_percentage(pct):
+    with pytest.raises(ValueError):
+        apply_percent(100, pct)
+    store = Store()
+    with pytest.raises(ValueError):
+        store.add_code("SAVE", pct)
+    with pytest.raises(KeyError):
+        store.total_cents("SAVE")
+
+
+def test_codes_apply_to_whole_total_case_insensitively():
+    store = Store()
+    store.add_item("one", 5)
+    store.add_item("two", 5)
+    store.add_code("SaVe", 10)
+    assert store.total_cents() == 10
+    assert store.total_cents("save") == 9
+    assert store.total_cents("SAVE") == 9
+    with pytest.raises(ValueError):
+        store.add_code("sAvE", 20)
+    with pytest.raises(KeyError):
+        store.total_cents("missing")
+
+
+def test_cli_discount_and_unknown_code():
+    store = Store()
+    store.add_item("item", 1005)
+    store.add_code("save", 10)
+    assert main(["total"], store) == "$10.05"
+    assert main(["total", "--code", "SAVE"], store) == "$9.05"
+    assert main(["total", "--code", "NoSuchCode"], store) == "unknown code: NoSuchCode"
