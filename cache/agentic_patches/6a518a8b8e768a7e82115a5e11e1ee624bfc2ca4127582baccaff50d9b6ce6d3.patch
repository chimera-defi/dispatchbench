--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,124 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_same_section_forward_and_nested_references():
+    config = load("[app]\na = prefix ${b} / ${c} suffix\nb = ${c}\nc = value\n")
+    assert config["app"] == {
+        "a": "prefix value / value suffix",
+        "b": "value",
+        "c": "value",
+    }
+
+
+def test_cross_section_dotted_section_and_unnamed_section():
+    config = load(
+        "base = root\n"
+        "alias = ${base}\n"
+        "[app]\n"
+        "path = ${a.b.c}/${.alias}/${db.host}\n"
+        "[a.b]\n"
+        "c = ${.base}\n"
+        "[db]\n"
+        "host = localhost\n"
+    )
+    assert config["app"]["path"] == "root/root/localhost"
+    assert config[""]["alias"] == "root"
+
+
+def test_unqualified_reference_uses_section_of_referenced_value():
+    config = load("[a]\nx = ${b.y}\nz = wrong\n[b]\ny = ${z}\nz = right\n")
+    assert config["a"]["x"] == "right"
+
+
+def test_dollar_escapes_and_substitutions_are_not_rescanned():
+    config = load(
+        "literal = $${missing}\n"
+        "dollar = $$\n"
+        "result = ${literal} ${dollar} $${also_missing} $$$$ $$${dollar}\n"
+    )
+    assert config[""]["literal"] == "${missing}"
+    assert config[""]["result"] == "${missing} $ ${also_missing} $$ $$"
+
+
+def test_empty_values_can_be_referenced():
+    assert load("empty =\nx = a${empty}b\n")[""]["x"] == "ab"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", "a.b.c", ".key", ""])
+def test_unknown_reference_preserves_written_name(reference):
+    with pytest.raises(ConfigError) as error:
+        load(f"[db]\nx = ${{{reference}}}\n")
+    assert str(error.value) == f"unknown reference: {reference}"
+    assert error.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "before $ after", "$$$"])
+def test_invalid_dollar(value):
+    with pytest.raises(ConfigError) as error:
+        load(f"\nkey = {value}\n")
+    assert error.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["${", "before ${missing", "$$${missing"])
+def test_unterminated_reference(value):
+    with pytest.raises(ConfigError) as error:
+        load(f"\nkey = {value}\n")
+    assert error.value.line == 2
+
+
+@pytest.mark.parametrize(
+    "source, message, line",
+    [
+        ("[a]\nx = ${y}\ny = ${x}\n", "reference cycle: a.x -> a.y -> a.x", 2),
+        ("x = ${x}\n", "reference cycle: .x -> .x", 1),
+        (
+            "start = ${a.x}\n[a]\nx = ${b.y}\n[b]\ny = ${a.x}\n",
+            "reference cycle: a.x -> b.y -> a.x",
+            1,
+        ),
+    ],
+)
+def test_cycles(source, message, line):
+    with pytest.raises(ConfigError) as error:
+        load(source)
+    assert str(error.value) == message
+    assert error.value.line == line
+
+
+@pytest.mark.parametrize("inner", ["${missing}", "$bad", "${unfinished", "${b}"])
+def test_nested_resolution_errors_use_outermost_definition_line(inner):
+    with pytest.raises(ConfigError) as error:
+        load(f"# comment\n[a]\nouter = ${{b}}\nb = {inner}\n")
+    assert error.value.line == 3
+
+
+def test_file_order_is_preserved_when_sections_are_reopened():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nok = value\n[b]\nx = ${x}\n[a]\ny = ${y}\n")
+    assert str(error.value) == "reference cycle: b.x -> b.x"
+    assert error.value.line == 4
+
+
+def test_references_are_resolved_left_to_right():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nstart = ${y} ${x}\nx = ${x}\ny = ${y}\n")
+    assert str(error.value) == "reference cycle: a.y -> a.y"
+    assert error.value.line == 2
+
+
+def test_shared_dependencies_do_not_form_a_cycle():
+    config = load("a = ${b}${c}${b}\nb = ${d}\nc = ${d}\nd = done\n")
+    assert config[""]["a"] == "donedonedone"
+
+
+def test_parse_keeps_raw_values_and_parser_errors_take_precedence():
+    source = "[a]\nx = ${missing} $$\n"
+    assert parse(source)["a"]["x"] == "${missing} $$"
+    with pytest.raises(ConfigError) as error:
+        load(source + "x = duplicate\n")
+    assert error.value.line == 3
+    assert "duplicate key" in str(error.value)
