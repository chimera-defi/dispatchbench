diff --git a/inv/cli.py b/inv/cli.py
index bb91b18..7067866 100644
--- a/inv/cli.py
+++ b/inv/cli.py
@@ -8,7 +8,15 @@ def main(argv: list[str], store: Store) -> str:
         return "usage: total | list"
     cmd = argv[0]
     if cmd == "total":
+        if len(argv) >= 3 and argv[1] == "--code":
+            code = argv[2]
+            try:
+                cents = store.total_cents(code)
+            except KeyError:
+                return f"unknown code: {code}"
+            return format_cents(cents)
         return format_cents(store.total_cents())
+
     if cmd == "list":
         return "\n".join(f"{i.name} x{i.qty} {format_cents(i.line_total())}" for i in store.items.values())
     return f"unknown command: {cmd}"
diff --git a/inv/money.py b/inv/money.py
index caa7f2f..97ff15b 100644
--- a/inv/money.py
+++ b/inv/money.py
@@ -3,3 +3,15 @@ def format_cents(cents: int) -> str:
     sign = "-" if cents < 0 else ""
     cents = abs(cents)
     return f"{sign}${cents // 100}.{cents % 100:02d}"
+
+
+def apply_percent(cents: int, pct: int) -> int:
+    """Return cents reduced by pct percent, rounded half up to a whole cent.
+
+    Half-cent ties round toward +infinity (904.5 -> 905). pct must be an int
+    from 0 to 100 inclusive.
+    """
+    if isinstance(pct, bool) or not isinstance(pct, int) or not 0 <= pct <= 100:
+        raise ValueError("pct must be an int from 0 to 100 inclusive")
+    # Floor division of (n + 50) rounds ties toward +infinity for both signs.
+    return (cents * (100 - pct) + 50) // 100
diff --git a/inv/store.py b/inv/store.py
index c8a5bb8..8d57635 100644
--- a/inv/store.py
+++ b/inv/store.py
@@ -1,9 +1,11 @@
 from .models import Item
+from .money import apply_percent
 
 
 class Store:
     def __init__(self):
         self.items: dict[str, Item] = {}
+        self._codes: dict[str, int] = {}
 
     def add_item(self, name: str, price_cents: int, qty: int = 1) -> None:
         if name in self.items:
@@ -14,5 +16,19 @@ class Store:
     def remove_item(self, name: str) -> None:
         del self.items[name]
 
-    def total_cents(self) -> int:
-        return sum(i.line_total() for i in self.items.values())
+    def add_code(self, code: str, pct: int) -> None:
+        # Validate before storing so a rejected pct cannot occupy the code.
+        apply_percent(0, pct)
+        key = code.casefold()
+        if key in self._codes:
+            raise ValueError(f"code already exists: {code}")
+        self._codes[key] = pct
+
+    def total_cents(self, code: str | None = None) -> int:
+        total = sum(i.line_total() for i in self.items.values())
+        if code is None:
+            return total
+        key = code.casefold()
+        if key not in self._codes:
+            raise KeyError(code)
+        return apply_percent(total, self._codes[key])
