diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..a5bf1c9
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,76 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+def test_apply_percent_half_up():
+    # 1005 * 90 / 100 = 904.5, which rounds half up to 905 (not banker's 904).
+    assert apply_percent(1005, 10) == 905
+    assert apply_percent(1004, 10) == 904  # 903.6
+    assert apply_percent(1006, 10) == 905  # 905.4
+    assert apply_percent(1, 50) == 1  # 0.5
+    assert apply_percent(3, 50) == 2  # 1.5
+    assert apply_percent(5, 50) == 3  # 2.5
+    assert apply_percent(2, 50) == 1
+    assert apply_percent(100, 0) == 100
+    assert apply_percent(100, 100) == 0
+    assert apply_percent(0, 37) == 0
+    assert apply_percent(-5, 50) == -2  # -2.5 rounds half up toward +infinity
+    assert apply_percent(-1005, 10) == -904
+
+
+def test_apply_percent_rejects_bad_pct():
+    for pct in (-1, 101, 10.0, "10", None, True, False):
+        with pytest.raises(ValueError):
+            apply_percent(100, pct)
+
+
+def test_add_code_case_and_validation():
+    s = Store()
+    with pytest.raises(ValueError):
+        s.add_code("SAVE", 150)
+    s.add_code("SAVE", 10)
+    with pytest.raises(ValueError):
+        s.add_code("save", 20)
+    with pytest.raises(ValueError):
+        s.add_code("Save", 10)
+    with pytest.raises(ValueError):
+        s.add_code("nope", -1)
+
+
+def test_total_cents_applies_code_to_whole_total():
+    s = Store()
+    s.add_item("a", 1)
+    s.add_item("b", 1)
+    s.add_code("HALF", 50)
+    # Per line, 0.5 rounds up to 1 twice (2). The whole total is 2 -> 1.
+    assert s.total_cents("half") == 1
+    assert s.total_cents() == 2
+    with pytest.raises(KeyError):
+        s.total_cents("missing")
+
+
+def test_cli_total_code():
+    s = Store()
+    s.add_item("pen", 150, 2)
+    s.add_item("pad", 399)
+    s.add_code("TEN", 10)
+    assert s.total_cents() == 699
+    assert s.total_cents("ten") == 629  # 629.1
+    assert main(["total"], s) == "$6.99"
+    assert main(["total", "--code", "TEN"], s) == "$6.29"
+    assert main(["total", "--code", "nope"], s) == "unknown code: nope"
+    assert main(["total", "--code", "NoPe"], s) == "unknown code: NoPe"
+    assert main(["list"], s) == "pen x2 $3.00\npad x1 $3.99"
+
+
+def test_cli_half_up_example():
+    s = Store()
+    s.add_item("widget", 1005)
+    s.add_code("off", 10)
+    assert s.total_cents("OFF") == 905
+    assert main(["total", "--code", "off"], s) == "$9.05"
+    s.add_code("FREE", 100)
+    assert main(["total", "--code", "free"], s) == "$0.00"
