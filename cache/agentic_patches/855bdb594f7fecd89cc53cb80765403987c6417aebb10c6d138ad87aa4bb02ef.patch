diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..1d58ff1
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,220 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, t=0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+def fail():
+    raise RuntimeError("failed")
+
+
+@pytest.mark.parametrize("options", [
+    {"max_attempts": 0},
+    {"max_attempts": -1},
+    {"base_delay": 0},
+    {"base_delay": -1},
+    {"max_delay": 1},
+    {"base_delay": 5, "max_delay": 4},
+])
+def test_invalid_configuration(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_default_retries_and_dead_letter():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    job = queue.submit("broken", fail)
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+
+    for attempt, now, next_time in [(1, 0, 2), (2, 2, 6)]:
+        clock.t = now
+        assert worker.run_due() == 1
+        assert job.attempts == attempt
+        assert job.run_at == next_time
+        assert len(queue) == 1
+        assert worker.dead == []
+        clock.t = next_time - 1
+        assert worker.run_due() == 0
+
+    clock.t = 6
+    assert worker.run_due() == 1
+    assert job.attempts == 3
+    assert worker.dead == [("broken", 3, "RuntimeError('failed')")]
+    assert worker.done == []
+    assert len(queue) == 0
+    assert worker.run_due() == 0
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 3, "dead": 1}
+
+
+def test_success_after_retry_counts_every_attempt():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def transient():
+        calls.append(clock.t)
+        if len(calls) == 1:
+            raise ValueError("temporary")
+
+    job = queue.submit("transient", transient)
+    successful = queue.submit("successful", lambda: None)
+    assert worker.run_due() == 2
+    assert job.attempts == successful.attempts == 1
+    assert worker.done == ["successful"]
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+    assert calls == [0, 2]
+    assert worker.done == ["successful", "transient"]
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_exponential_backoff_is_capped():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=6, base_delay=3, max_delay=10)
+    job = queue.submit("broken", fail)
+
+    for delay in [3, 6, 10, 10, 10]:
+        attempted_at = clock.t
+        assert worker.run_due() == 1
+        assert job.run_at == attempted_at + delay
+        clock.t = job.run_at
+    assert worker.run_due() == 1
+    assert worker.dead == [("broken", 6, "RuntimeError('failed')")]
+
+
+def test_dead_jobs_are_recorded_in_death_order_with_last_exception():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=2)
+    calls = []
+
+    def changing_error():
+        calls.append(None)
+        raise ValueError(f"failure {len(calls)}")
+
+    queue.submit("later", changing_error, delay=1)
+    queue.submit("earlier", fail)
+    assert worker.run_due() == 1
+    clock.t = 1
+    assert worker.run_due() == 1
+    clock.t = 3
+    assert worker.run_due() == 2
+    assert worker.dead == [
+        ("earlier", 2, "RuntimeError('failed')"),
+        ("later", 2, "ValueError('failure 2')"),
+    ]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 2}
+
+
+def test_single_attempt_and_equal_delay_limits_are_valid():
+    queue = JobQueue(Clock())
+    worker = Worker(queue, 1, 1, 1)
+    job = queue.submit("broken", fail)
+    assert worker.run_due() == 1
+    assert job.attempts == 1
+    assert len(queue) == 0
+    assert worker.dead == [("broken", 1, "RuntimeError('failed')")]
+
+
+@pytest.mark.parametrize("exception", [KeyboardInterrupt(), SystemExit(7), BaseException("stop")])
+def test_base_exceptions_propagate_without_retrying(exception):
+    queue = JobQueue(Clock())
+    worker = Worker(queue)
+
+    def interrupt():
+        raise exception
+
+    job = queue.submit("interrupt", interrupt)
+    remaining = queue.submit("remaining", lambda: None)
+    with pytest.raises(type(exception)) as caught:
+        worker.run_due()
+    assert caught.value is exception
+    assert job.attempts == 1
+    assert remaining.attempts == 0
+    assert len(queue) == 1
+    assert worker.dead == []
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert worker.done == ["remaining"]
+
+
+def test_retry_preserves_original_sequence_for_equal_due_times():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def transient():
+        calls.append("first")
+        if len(calls) == 1:
+            raise RuntimeError("retry")
+
+    job = queue.submit("first", transient)
+    original_seq = job.seq
+    queue.submit("second", lambda: calls.append("second"), delay=2)
+    assert worker.run_due() == 1
+    queue.submit("third", lambda: calls.append("third"), delay=2)
+    assert job.seq == original_seq
+    clock.t = 2
+    assert worker.run_due() == 3
+    assert calls == ["first", "first", "second", "third"]
+
+
+def test_delay_uses_attempt_start_and_due_jobs_are_snapshotted():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def slow_failure():
+        clock.t = 100
+        queue.submit("new", lambda: None)
+        fail()
+
+    job = queue.submit("slow", slow_failure)
+    future = queue.submit("future", lambda: None, delay=5)
+    assert worker.run_due() == 1
+    assert job.run_at == 2
+    assert job.attempts == 1
+    assert future.attempts == 0
+    assert worker.done == []
+    assert len(queue) == 3
+
+
+def test_each_attempt_uses_its_own_start_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def advance_clock():
+        clock.t = 10
+
+    queue.submit("advance", advance_clock)
+    job = queue.submit("broken", fail)
+    assert worker.run_due() == 2
+    assert job.run_at == 12
+
+
+def test_retry_is_not_repeated_when_delay_rounds_to_now():
+    clock = Clock(float(2 ** 54))
+    queue = JobQueue(clock)
+    worker = Worker(queue, base_delay=1)
+    job = queue.submit("broken", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock.t
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert job.attempts == 2
