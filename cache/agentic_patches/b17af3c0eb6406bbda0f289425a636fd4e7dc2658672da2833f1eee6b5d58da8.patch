     def run_due(self) -> int:
-        """Run every job that is due now, earliest first. Returns how many jobs ran."""
+        """Run jobs due at the start, at most once each, and return attempts made."""
+        now = self.queue.clock()
+        due = sorted(job for job in self.queue._heap if job.run_at <= now)
         ran = 0
-        while (job := self.queue.pop_due()) is not None:
-            job.fn()
-            self.done.append(job.name)
+        for job in due:
+            # Remove only the next job so an interrupt leaves the others queued.
+            self.queue._heap.remove(job)
+            heapq.heapify(self.queue._heap)
+            attempted_at = self.queue.clock()
+            job.attempts += 1
             ran += 1
+            try:
+                job.fn()
+            except Exception as exc:
+                self._failed_attempts += 1
+                if job.attempts >= self.max_attempts:
+                    self.dead.append((job.name, job.attempts, repr(exc)))
+                else:
+                    delay = min(self.max_delay, self.base_delay * 2 ** (job.attempts - 1))
+                    job.run_at = attempted_at + delay
+                    heapq.heappush(self.queue._heap, job)
+            else:
+                self.done.append(job.name)
         return ran
+
+    def stats(self):
+        return {"succeeded": len(self.done), "failed_attempts": self._failed_attempts,
+                "dead": len(self.dead)}
diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..f3914a6
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,94 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.time = 0
+
+    def __call__(self):
+        return self.time
+
+
+def test_retry_delays_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise RuntimeError("oops")
+
+    job = queue.submit("failure", fail)
+    for time, next_time in [(0, 2), (2, 5), (5, 8)]:
+        clock.time = time
+        assert worker.run_due() == 1
+        assert job.run_at == next_time
+        assert worker.run_due() == 0
+    clock.time = 8
+    assert worker.run_due() == 1
+    assert job.attempts == 4
+    assert worker.dead == [("failure", 4, "RuntimeError('oops')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+
+
+def test_retry_keeps_sequence_and_succeeds():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        log.append("first")
+        if len(log) == 1:
+            raise ValueError("retry")
+
+    job = queue.submit("first", flaky)
+    assert worker.run_due() == 1
+    queue.submit("second", lambda: log.append("second"), delay=2)
+    clock.time = 2
+    assert worker.run_due() == 2
+    assert log == ["first", "first", "second"]
+    assert job.attempts == 2
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_due_snapshot_and_attempt_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail():
+        clock.time = 10
+        raise ValueError()
+
+    job = queue.submit("failure", fail)
+    queue.submit("later", lambda: None, delay=1)
+    assert worker.run_due() == 1
+    assert job.run_at == 2
+    assert worker.run_due() == 2
+
+
+def test_base_exception_propagates_and_leaves_other_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    def interrupt():
+        raise KeyboardInterrupt()
+    job = queue.submit("interrupt", interrupt)
+    queue.submit("other", lambda: None)
+    with pytest.raises(KeyboardInterrupt):
+        worker.run_due()
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"max_attempts": 0}, {"base_delay": 0}, {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_settings(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
