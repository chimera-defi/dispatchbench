index be3061f..907f656 100644
--- a/kvcache/cache.py
+++ b/kvcache/cache.py
@@ -19,23 +19,51 @@ class TTLCache:
         self.stats = Stats()
 
     def get(self, key, default=None):
-        if key not in self._data:
+        item = self._data.get(key)
+        if item is None:
             self.stats.misses += 1
             return default
-        value, expires_at = self._data[key]
-        self.stats.hits += 1
-        if self.clock() > expires_at:
+        value, expires_at = item
+        if self.clock() >= expires_at:
             del self._data[key]
+            self.stats.misses += 1
             self.stats.expirations += 1
             return default
         self._data.move_to_end(key)
+        self.stats.hits += 1
         return value
 
     def put(self, key, value) -> None:
-        self._data[key] = (value, self.clock() + self.ttl)
-        if len(self._data) > self.capacity:
-            self._data.popitem(last=False)
-            self.stats.evictions += 1
+        now = self.clock()
+        if key in self._data:
+            # Replacing a key is a use: it becomes the most recently used entry
+            # and its lifetime starts again from this write.
+            self._data[key] = (value, now + self.ttl)
+            self._data.move_to_end(key)
+            return
+        # Expired entries occupy slots. Free those before evicting anything live.
+        while len(self._data) >= self.capacity:
+            if not self._drop_expired(now):
+                self._data.popitem(last=False)
+                self.stats.evictions += 1
+                break
+        self._data[key] = (value, now + self.ttl)
+
+    def _drop_expired(self, now) -> bool:
+        """Drop the least-recently-used expired entry. Return whether one was dropped."""
+        expired_key = None
+        found = False
+        for key, (_, expires_at) in self._data.items():
+            if now >= expires_at:
+                expired_key = key
+                found = True
+                break
+        if not found:
+            return False
+        del self._data[expired_key]
+        self.stats.expirations += 1
+        return True
 
     def __len__(self) -> int:
-        return len(self._data)
+        now = self.clock()
+        return sum(1 for _, expires_at in self._data.values() if now < expires_at)
