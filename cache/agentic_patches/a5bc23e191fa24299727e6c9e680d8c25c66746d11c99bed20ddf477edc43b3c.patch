+def test_put_reclaims_expired_lru_instead_of_counting_an_eviction():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("old", 1)  # expires at 10
+    clock.advance(5)
+    cache.put("live", 2)  # expires at 15
+    clock.advance(5)  # now 10: old is expired, live is still live
+    assert len(cache) == 1
+
+    cache.put("incoming", 3)
+    assert cache.stats.evictions == 0
+    assert cache.stats.expirations == 1
+    assert cache.get("old") is None
+    assert cache.get("live") == 2
+    assert cache.get("incoming") == 3
+    assert cache.stats.expirations == 1
+    assert len(cache) == 2
+
