diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..ddde04f
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,159 @@
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+def test_entry_is_gone_at_exact_ttl_and_live_just_before():
+    clock = FakeClock(100)
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", "v")  # written at 100, gone from 110 on
+
+    clock.advance(9)  # 109
+    assert cache.get("a") == "v"
+    assert len(cache) == 1
+    assert cache.stats.hits == 1
+    assert cache.stats.expirations == 0
+
+    clock.advance(1)  # 110
+    assert len(cache) == 0
+    assert cache.get("a", "gone") == "gone"
+    assert cache.stats.hits == 1
+    assert cache.stats.misses == 1
+    assert cache.stats.expirations == 1
+
+    # A second lookup has already dropped the entry: still a miss, not another expiration.
+    assert cache.get("a", "gone") == "gone"
+    assert cache.stats.misses == 2
+    assert cache.stats.expirations == 1
+    assert cache.stats.hit_rate() == 1 / 3
+
+
+def test_put_overwrite_counts_as_recent_use():
+    clock = FakeClock()
+    cache = TTLCache(2, 100, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.put("a", 3)  # touch a so b is the least recently used
+    cache.put("c", 4)
+
+    assert cache.get("b") is None
+    assert cache.get("a") == 3
+    assert cache.get("c") == 4
+    assert cache.stats.evictions == 1
+    assert cache.stats.expirations == 0
+    assert cache.stats.misses == 1
+    assert cache.stats.hits == 2
+
+
+def test_put_overwrite_refreshes_ttl():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)  # expires at 10
+    cache.put("b", 2)  # expires at 10
+    clock.advance(6)
+    cache.put("a", 7)  # expires at 16, and a is most recently used
+    clock.advance(4)  # now 10: original deadline, refreshed a is still live
+    assert cache.get("a") == 7
+    assert len(cache) == 1  # b expired at 10
+    assert cache.stats.hits == 1
+    assert cache.stats.expirations == 0
+
+
+def test_get_of_expired_entry_is_a_miss_not_a_hit():
+    clock = FakeClock()
+    cache = TTLCache(2, 5, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    assert cache.get("a") == 1
+
+    clock.advance(5)
+    assert cache.get("a", "nope") == "nope"
+    assert cache.get("b") is None
+    assert cache.stats.hits == 1
+    assert cache.stats.misses == 2
+    assert cache.stats.expirations == 2
+    assert cache.stats.evictions == 0
+    assert cache.stats.hit_rate() == 1 / 3
+    assert len(cache) == 0
+
+
+def test_len_counts_only_unexpired_entries():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("a", 1)  # expires at 10
+    clock.advance(3)
+    cache.put("b", 2)  # expires at 13
+    clock.advance(7)  # now 10: a is gone, b is live
+    assert len(cache) == 1
+    cache.put("c", 3)  # expires at 20
+    assert len(cache) == 2
+    clock.advance(3)  # now 13: b is gone, c is live
+    assert len(cache) == 1
+    # Observing length does not itself record expirations.
+    assert cache.stats.expirations == 0
+    assert cache.stats.hits == 0
+    assert cache.stats.misses == 0
+
