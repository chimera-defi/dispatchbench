+def test_put_reclaims_expired_slot_that_is_not_lru():
+    """A live least-recent entry must survive when a newer slot is already expired."""
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("stale", "s")  # expires at 10
+    clock.advance(4)
+    cache.put("keep", "k")  # expires at 14
+    assert cache.get("stale") == "s"  # stale becomes newest, but its deadline stays 10
+    clock.advance(6)  # now 10: stale expired, keep is the older live entry
+    assert len(cache) == 1
+
+    cache.put("fresh", "f")
+    assert cache.stats.evictions == 0
+    assert cache.stats.expirations == 1
+    assert cache.get("keep") == "k"
+    assert cache.get("fresh") == "f"
+    assert cache.get("stale") is None
+    assert cache.stats.expirations == 1
+    assert cache.stats.hits == 3  # stale (before expiry), keep, fresh
+    assert cache.stats.misses == 1
+
+    # The cache is full of live entries now, so the next insert evicts the older live key.
+    cache.put("extra", "e")
+    assert cache.stats.evictions == 1
+    assert cache.stats.expirations == 1
+    assert cache.get("keep") is None
+    assert cache.get("fresh") == "f"
+    assert cache.get("extra") == "e"
+
