+def test_full_cache_of_expired_entries_does_not_evict_the_new_live_entry():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(10)
+    assert len(cache) == 0
+
+    cache.put("c", 3)
+    assert cache.get("c") == 3
+    assert len(cache) == 1
+    assert cache.stats.evictions == 0
+    assert cache.stats.expirations == 1
+    assert cache.stats.hits == 1
