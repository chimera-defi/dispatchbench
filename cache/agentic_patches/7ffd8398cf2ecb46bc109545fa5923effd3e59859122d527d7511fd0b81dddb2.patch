@@ -0,0 +1,55 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_escaping():
+    text = """root = home
+[a.b]
+x = ${y}/$${literal}/$$/${.root}/${a.b.z}
+y = ${z}
+z = end
+"""
+    assert load(text)["a.b"]["x"] == "end/${literal}/$/home/end"
+    assert parse(text)["a.b"]["y"] == "${z}"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", ".missing", "a.b.c"])
+def test_missing_reference_reports_name_and_outer_line(reference):
+    text = f"[a]\nx = ${{y}}\ny = ${{{reference}}}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 2
+
+
+def test_cycle_reports_first_repeated_key_and_outer_line():
+    text = "[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert exc.value.line == 2
+
+
+def test_cycle_order_follows_file_order_and_reference_order():
+    text = "[b]\nx = ${y}${z}\ny = ${x}\nz = ${z}\n[a]\nx = ${x}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == "reference cycle: b.x -> b.y -> b.x"
+    assert exc.value.line == 2
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${.y}\ny = ${x}\n")
+    assert str(exc.value) == "reference cycle: .x -> .y -> .x"
+    assert exc.value.line == 1
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "${missing"])
+def test_invalid_reference_reports_outer_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"x = ${{y}}\ny = {value}\n")
+    assert exc.value.line == 1
