+        self.max_attempts = max_attempts
+        self.base_delay = base_delay
+        self.max_delay = max_delay
+        self.done: list[str] = []  # names of jobs that succeeded, in completion order
+        self.dead: list[tuple[str, int, str]] = []
+        self._failed_attempts = 0
+
+    def stats(self) -> dict[str, int]:
+        return {
+            "succeeded": len(self.done),
+            "failed_attempts": self._failed_attempts,
+            "dead": len(self.dead),
+        }
 
     def run_due(self) -> int:
-        """Run every job that is due now, earliest first. Returns how many jobs ran."""
-        ran = 0
+        """Run jobs that were already due when this call started looking.
+
+        A job requeued while this call is running stays queued, even if its new
+        run time is already due. Returns how many attempts ran. Exceptions that
+        are not `Exception` subclasses propagate and are not requeued.
+        """
+        due: list[Job] = []
         while (job := self.queue.pop_due()) is not None:
+            due.append(job)
+
+        ran = 0
+        index = 0
+        try:
+            for index, job in enumerate(due):
+                self._attempt(job)
+                ran += 1
+        except BaseException:
+            # The job that raised is already out of the queue and must stay out.
+            # Jobs from this batch that have not started go back as they were.
+            for pending in due[index + 1:]:
+                self.queue.requeue(pending)
+            raise
+        return ran
+
+    def _attempt(self, job: Job) -> None:
+        # Backoff is measured from the clock value at which this attempt runs,
+        # not from the job's previous run_at and not from a clock fn() moves.
+        attempted_at = self.queue.clock()
+        job.attempts += 1
+        try:
