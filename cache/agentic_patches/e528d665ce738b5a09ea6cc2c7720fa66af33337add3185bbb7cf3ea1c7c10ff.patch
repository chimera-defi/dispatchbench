 from .queue import JobQueue
 
 
 class Worker:
-    def __init__(self, queue: JobQueue):
+    """Run due jobs. Failures retry with exponential backoff until `max_attempts`."""
+
+    def __init__(self, queue: JobQueue, max_attempts: int = 3, base_delay: int = 2, max_delay: int = 60):
+        if max_attempts < 1:
+            raise ValueError(f"max_attempts must be >= 1, got {max_attempts}")
+        if base_delay < 1:
+            raise ValueError(f"base_delay must be >= 1, got {base_delay}")
