diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..87bb8ed
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,256 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0
+
+    def __call__(self):
+        return self.t
+
+
+def _raise(exc):
+    def fn():
+        raise exc
+    return fn
+
+
+def test_defaults_keep_worker_queue_calls_working():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q)
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert w.dead == []
+
+    job = q.submit("a", _raise(RuntimeError("nope")))
+    assert w.run_due() == 1
+    assert job.attempts == 1
+    assert job.run_at == 2  # base_delay * 2 ** 0, from t=0
+    assert len(q) == 1 and w.done == [] and w.dead == []
+
+    clk.t = 2
+    assert w.run_due() == 1
+    assert job.attempts == 2
+    assert job.run_at == 2 + 4  # base_delay * 2 ** 1, from the second attempt
+
+    clk.t = 6
+    assert w.run_due() == 1
+    assert w.dead == [("a", 3, "RuntimeError('nope')")]
+    assert len(q) == 0
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 3, "dead": 1}
+
+
+def test_rejects_bad_retry_parameters():
+    q = JobQueue(Clock())
+    with pytest.raises(ValueError):
+        Worker(q, max_attempts=0)
+    with pytest.raises(ValueError):
+        Worker(q, max_attempts=-1)
+    with pytest.raises(ValueError):
+        Worker(q, base_delay=0)
+    with pytest.raises(ValueError):
+        Worker(q, base_delay=-3)
+    with pytest.raises(ValueError):
+        Worker(q, base_delay=5, max_delay=4)
+    Worker(q, max_attempts=1, base_delay=1, max_delay=1)
+
+
+def test_success_after_retries_counts_every_attempt():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=4, base_delay=2, max_delay=60)
+    calls = {"n": 0}
+
+    def flaky():
+        calls["n"] += 1
+        if calls["n"] < 3:
+            raise ValueError("not yet")
+
+    job = q.submit("a", flaky)
+    assert w.run_due() == 1
+    clk.t = job.run_at
+    assert w.run_due() == 1
+    clk.t = job.run_at
+    assert w.run_due() == 1
+
+    assert calls["n"] == 3
+    assert job.attempts == 3
+    assert w.done == ["a"]
+    assert w.dead == []
+    assert len(q) == 0
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 2, "dead": 0}
+
+
+def test_dead_preserves_death_order_and_last_exception_repr():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=1)
+
+    q.submit("a", _raise(ValueError("bad")))
+    q.submit("b", _raise(RuntimeError("worse")))
+    assert w.run_due() == 2
+    assert w.dead == [
+        ("a", 1, "ValueError('bad')"),
+        ("b", 1, "RuntimeError('worse')"),
+    ]
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 2, "dead": 2}
+    assert len(q) == 0
+
+
+def test_backoff_is_capped_and_counted_from_attempt_time():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=5, base_delay=3, max_delay=10)
+    job = q.submit("a", _raise(RuntimeError("x")), delay=0)
+
+    clk.t = 10  # attempt runs late; delay is not counted from the old run_at of 0
+    assert w.run_due() == 1
+    assert job.attempts == 1
+    assert job.run_at == 10 + 3
+
+    clk.t = 12
+    assert w.run_due() == 0  # not due until 13
+    clk.t = 13
+    assert w.run_due() == 1
+    assert job.attempts == 2
+    assert job.run_at == 13 + 6
+
+    clk.t = 19
+    assert w.run_due() == 1
+    assert job.run_at == 19 + 10  # 3 * 4 == 12, capped at max_delay
+
+    clk.t = 29
+    assert w.run_due() == 1
+    assert job.run_at == 29 + 10
+    clk.t = 39
+    assert w.run_due() == 1
+    assert w.dead == [("a", 5, "RuntimeError('x')")]
+
+
+def test_retried_job_keeps_seq_against_jobs_submitted_later_and_earlier():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=5, max_delay=60)
+    log = []
+    state = {"failed": False}
+
+    def fail_once():
+        if not state["failed"]:
+            state["failed"] = True
+            raise RuntimeError("once")
+        log.append("retry")
+
+    early = q.submit("early", lambda: log.append("early"), delay=5)
+    retried = q.submit("retry", fail_once)
+    assert w.run_due() == 1
+    assert retried.attempts == 1
+    assert retried.run_at == 5
+    assert early.seq < retried.seq
+
+    later = q.submit("later", lambda: log.append("later"), delay=5)
+    assert later.seq > retried.seq
+    clk.t = 5
+    assert w.run_due() == 3
+    assert log == ["early", "retry", "later"]
+
+
+def test_run_due_does_not_run_jobs_that_become_due_mid_call():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=4, base_delay=1, max_delay=10)
+    log = []
+
+    def fail_and_jump():
+        log.append(f"fail@{clk.t}")
+        clk.t += 100
+        raise RuntimeError("boom")
+
+    def submit_sibling():
+        log.append("ok")
+        q.submit("fresh", lambda: log.append("fresh"))
+
+    job = q.submit("fail", fail_and_jump)
+    q.submit("ok", submit_sibling)
+    q.submit("waiting", lambda: log.append("waiting"), delay=5)
+
+    # At the start only fail and ok are due. The failure moves the clock to 100,
+    # which makes the retry (run_at 1), waiting, and the job submitted by ok
+    # all due — none of them may run in this call.
+    assert w.run_due() == 2
+    assert log == ["fail@0", "ok"]
+    assert job.attempts == 1
+    assert job.run_at == 1
+    assert clk.t == 100
+
+    assert w.run_due() == 3
+    assert log == ["fail@0", "ok", "fail@100", "waiting", "fresh"]
+    assert job.attempts == 2
+
+
+def test_clock_moved_by_the_failing_job_does_not_shift_backoff():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=60)
+
+    def fail():
+        clk.t = 40
+        raise RuntimeError("moved")
+
+    job = q.submit("a", fail)
+    assert w.run_due() == 1
+    assert job.run_at == 2
+    clk.t = 2
+    assert w.run_due() == 1
+    assert job.attempts == 2
+
+
+def test_base_exception_propagates_without_requeue():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=60)
+    log = []
+
+    class Halt(BaseException):
+        pass
+
+    job = q.submit("halt", _raise(Halt()))
+    other = q.submit("other", lambda: log.append("other"))
+    q.submit("later", lambda: log.append("later"), delay=5)
+
+    with pytest.raises(Halt):
+        w.run_due()
+
+    assert job.attempts == 1
+    assert w.done == []
+    assert w.dead == []
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert len(q) == 2  # other restored, later never popped; halt not requeued
+
+    assert w.run_due() == 1
+    assert log == ["other"]
+    assert other.attempts == 1
+
+    clk.t = 10_000
+    assert w.run_due() == 1
+    assert log == ["other", "later"]
+    assert job.attempts == 1
+
+
+def test_keyboard_interrupt_propagates_unchanged():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q)
+    job = q.submit("k", _raise(KeyboardInterrupt()))
+
+    with pytest.raises(KeyboardInterrupt):
+        w.run_due()
+
+    assert len(q) == 0
+    assert job.attempts == 1
+    assert w.dead == []
+    assert w.done == []
+    clk.t = 10_000
+    assert w.run_due() == 0
