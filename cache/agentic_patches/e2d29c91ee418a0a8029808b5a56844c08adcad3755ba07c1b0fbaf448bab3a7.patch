diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..bea1b37
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,47 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_escaping():
+    config = load("""root = global
+[a.b]
+x = ${y} / ${.root} / $$${other.z} / $${y}
+y = ${other.z}
+[other]
+z = done
+""")
+    assert config["a.b"]["x"] == "done / global / $done / ${y}"
+    assert config["a.b"]["y"] == "done"
+    assert parse("x = ${missing}")[""]["x"] == "${missing}"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", ".missing"])
+def test_missing_reference_preserves_name_and_outer_line(reference):
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nx = ${y}\ny = ${" + reference + "}\n")
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 2
+
+
+def test_cycle_reports_first_repeated_key_and_outer_line():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n")
+    assert str(exc.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert exc.value.line == 2
+
+
+def test_unnamed_cycle_and_left_to_right_order():
+    with pytest.raises(ConfigError) as exc:
+        load("start = ${b}${a}\na = ${a}\nb = ${b}\n")
+    assert str(exc.value) == "reference cycle: .b -> .b"
+    assert exc.value.line == 1
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "${missing"])
+def test_malformed_reference_uses_outer_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${y}\ny = " + value + "\n")
+    assert exc.value.line == 1
