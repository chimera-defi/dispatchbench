diff --git a/jobq/queue.py b/jobq/queue.py
index 6f9f569..4d47a23 100644
--- a/jobq/queue.py
+++ b/jobq/queue.py
@@ -23,5 +23,16 @@ class JobQueue:
             return heapq.heappop(self._heap)
         return None
 
+    def take_due(self, now) -> list[Job]:
+        """Remove the jobs due at a given time, in queue order."""
+        jobs = []
+        while self._heap and self._heap[0].run_at <= now:
+            jobs.append(heapq.heappop(self._heap))
+        return jobs
+
+    def requeue(self, job: Job) -> None:
+        """Put an existing job back without changing its sequence number."""
+        heapq.heappush(self._heap, job)
+
     def __len__(self) -> int:
         return len(self._heap)
diff --git a/jobq/worker.py b/jobq/worker.py
index c90a7df..aa7d50e 100644
--- a/jobq/worker.py
+++ b/jobq/worker.py
@@ -2,15 +2,43 @@ from .queue import JobQueue
 
 
 class Worker:
-    def __init__(self, queue: JobQueue):
+    def __init__(self, queue: JobQueue, max_attempts=3, base_delay=2, max_delay=60):
+        if max_attempts < 1 or base_delay < 1 or max_delay < base_delay:
+            raise ValueError("invalid retry configuration")
         self.queue = queue
-        self.done: list[str] = []     # names of jobs that succeeded, in completion order
+        self.max_attempts = max_attempts
+        self.base_delay = base_delay
+        self.max_delay = max_delay
+        self.done: list[str] = []
+        self.dead: list[tuple[str, int, str]] = []
+        self._failed_attempts = 0
 
     def run_due(self) -> int:
-        """Run every job that is due now, earliest first. Returns how many jobs ran."""
+        """Run the jobs due at the start of this call, once each."""
+        jobs = self.queue.take_due(self.queue.clock())
         ran = 0
-        while (job := self.queue.pop_due()) is not None:
-            job.fn()
-            self.done.append(job.name)
+        for index, job in enumerate(jobs):
+            attempt_time = self.queue.clock()
+            job.attempts += 1
             ran += 1
+            try:
+                job.fn()
+            except Exception as exc:
+                self._failed_attempts += 1
+                if job.attempts >= self.max_attempts:
+                    self.dead.append((job.name, job.attempts, repr(exc)))
+                else:
+                    delay = min(self.max_delay, self.base_delay * 2 ** (job.attempts - 1))
+                    job.run_at = attempt_time + delay
+                    self.queue.requeue(job)
+            except BaseException:
+                for pending in jobs[index + 1:]:
+                    self.queue.requeue(pending)
+                raise
+            else:
+                self.done.append(job.name)
         return ran
+
+    def stats(self):
+        return {"succeeded": len(self.done), "failed_attempts": self._failed_attempts,
+                "dead": len(self.dead)}
