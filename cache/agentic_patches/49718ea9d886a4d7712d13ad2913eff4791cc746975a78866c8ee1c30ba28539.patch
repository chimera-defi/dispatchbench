diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..995421c
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,104 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.now = 0
+
+    def __call__(self):
+        return self.now
+
+
+@pytest.mark.parametrize("options", [
+    {"max_attempts": 0}, {"base_delay": 0},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_options(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_backoff_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+    def fail():
+        raise ValueError("broken")
+    job = queue.submit("bad", fail)
+    for now, next_time in [(0, 2), (2, 5), (5, 8)]:
+        clock.now = now
+        assert worker.run_due() == 1
+        assert job.run_at == next_time
+        assert worker.run_due() == 0
+    clock.now = 8
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 4, "ValueError('broken')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_success_after_retry_and_original_sequence():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+    def flaky():
+        log.append("first")
+        if len(log) == 1:
+            raise RuntimeError()
+    job = queue.submit("first", flaky)
+    assert worker.run_due() == 1
+    queue.submit("second", lambda: log.append("second"), delay=2)
+    clock.now = 2
+    assert worker.run_due() == 2
+    assert log == ["first", "first", "second"]
+    assert job.attempts == 2
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_snapshot_and_attempt_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    def advance():
+        clock.now = 10
+    queue.submit("advance", advance)
+    def fail():
+        raise RuntimeError()
+    job = queue.submit("fail", fail)
+    queue.submit("later", lambda: None, delay=5)
+    assert worker.run_due() == 2
+    assert job.run_at == 12
+    assert worker.run_due() == 1
+
+
+def test_base_exception_propagates_and_preserves_pending_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    error = KeyboardInterrupt()
+    def interrupt():
+        raise error
+    job = queue.submit("interrupt", interrupt)
+    queue.submit("pending", lambda: None)
+    with pytest.raises(KeyboardInterrupt) as caught:
+        worker.run_due()
+    assert caught.value is error
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
+
+
+def test_retry_not_run_twice_when_delay_rounds_to_now():
+    clock = Clock()
+    clock.now = 10**20
+    queue = JobQueue(clock)
+    worker = Worker(queue, base_delay=1.0)
+    job = queue.submit("fail", lambda: (_ for _ in ()).throw(ValueError()))
+    assert worker.run_due() == 1
+    assert job.attempts == 1
+    assert worker.run_due() == 1
