diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..ef3158f
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,209 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0
+
+    def __call__(self):
+        return self.t
+
+
+def test_defaults_match_previous_constructor():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q)
+    assert w.max_attempts == 3 and w.base_delay == 2 and w.max_delay == 60
+    q.submit("a", lambda: None)
+    assert w.run_due() == 1 and w.done == ["a"]
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": -1},
+        {"base_delay": 0},
+        {"base_delay": -2},
+        {"base_delay": 5, "max_delay": 4},
+    ],
+)
+def test_rejects_bad_retry_settings(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_equal_max_delay_is_allowed():
+    Worker(JobQueue(Clock()), base_delay=5, max_delay=5)
+
+
+def test_exponential_backoff_from_attempt_clock_and_dead_letter():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=60)
+    seen = []
+
+    def boom():
+        seen.append(clk.t)
+        raise RuntimeError("x")
+
+    job = q.submit("j", boom)
+    assert w.run_due() == 1
+    assert job.attempts == 1 and len(q) == 1 and w.dead == []
+    clk.t = 1
+    assert w.run_due() == 0
+    clk.t = 2
+    assert w.run_due() == 1 and job.attempts == 2
+    clk.t = 5
+    assert w.run_due() == 0
+    clk.t = 6
+    assert w.run_due() == 1
+    assert seen == [0, 2, 6]
+    assert job.attempts == 3
+    assert w.dead == [("j", 3, repr(RuntimeError("x")))]
+    assert len(q) == 0
+    assert w.done == []
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 3, "dead": 1}
+
+
+def test_delay_is_capped_and_uses_clock_at_attempt():
+    clk = Clock()
+    clk.t = 5
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=5, base_delay=2, max_delay=5)
+    state = {"n": 0}
+
+    def boom():
+        state["n"] += 1
+        if state["n"] == 1:
+            clk.t = 100
+        raise RuntimeError("e")
+
+    job = q.submit("j", boom)
+    assert w.run_due() == 1
+    assert job.attempts == 1
+    # First failure used the clock at the start of the attempt (5), delay 2.
+    clk.t = 6
+    assert w.run_due() == 0
+    clk.t = 7
+    assert w.run_due() == 1 and job.attempts == 2
+    # Second failure: delay min(5, 2 * 2) = 4, from t=7.
+    clk.t = 10
+    assert w.run_due() == 0
+    clk.t = 11
+    assert w.run_due() == 1 and job.attempts == 3
+    # Third failure: uncapped delay would be 8, capped at 5, from t=11.
+    clk.t = 15
+    assert w.run_due() == 0
+    clk.t = 16
+    assert w.run_due() == 1 and job.attempts == 4
+
+
+def test_success_after_failures_records_attempts():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=4, base_delay=2, max_delay=30)
+    calls = {"n": 0}
+
+    def flaky():
+        calls["n"] += 1
+        if calls["n"] < 3:
+            raise ValueError("not yet")
+
+    job = q.submit("f", flaky)
+    assert w.run_due() == 1
+    clk.t = 2
+    assert w.run_due() == 1
+    clk.t = 6
+    assert w.run_due() == 1
+    assert job.attempts == 3
+    assert w.done == ["f"] and w.dead == [] and len(q) == 0
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 2, "dead": 0}
+
+
+def test_keyboard_interrupt_propagates_without_requeue():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3)
+
+    def boom():
+        raise KeyboardInterrupt()
+
+    job = q.submit("k", boom)
+    with pytest.raises(KeyboardInterrupt):
+        w.run_due()
+    assert len(q) == 0
+    assert w.dead == [] and w.done == []
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert job.attempts == 1
+
+
+def test_retry_keeps_seq_ahead_of_later_submissions():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=10)
+    log = []
+    state = {"n": 0}
+
+    def fail_once():
+        state["n"] += 1
+        if state["n"] == 1:
+            q.submit("later", lambda: log.append("later"), delay=2)
+            raise RuntimeError("once")
+        log.append("first")
+
+    q.submit("first", fail_once)
+    assert w.run_due() == 1
+    clk.t = 2
+    assert w.run_due() == 2
+    assert log == ["first", "later"]
+    assert w.done == ["first", "later"]
+
+
+def test_run_due_does_not_rerun_a_job_requeued_in_the_same_call():
+    clk = Clock()
+    clk.t = 5
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=5, base_delay=2, max_delay=60)
+    calls = {"n": 0}
+
+    def boom():
+        calls["n"] += 1
+        clk.t = 100
+        raise RuntimeError("again")
+
+    q.submit("j", boom)
+    assert w.run_due() == 1
+    assert calls["n"] == 1
+    assert w.stats()["failed_attempts"] == 1
+    assert w.run_due() == 1
+    assert calls["n"] == 2
+
+
+def test_dead_order_and_attempt_count_across_jobs():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=2, base_delay=1, max_delay=1)
+
+    def make(name, ok):
+        def fn():
+            if not ok:
+                raise RuntimeError(name)
+        return fn
+
+    q.submit("bad-a", make("bad-a", False))
+    q.submit("good", make("good", True))
+    q.submit("bad-b", make("bad-b", False))
+    assert w.run_due() == 3
+    clk.t = 1
+    assert w.run_due() == 2
+    assert w.done == ["good"]
+    assert w.dead == [
+        ("bad-a", 2, repr(RuntimeError("bad-a"))),
+        ("bad-b", 2, repr(RuntimeError("bad-b"))),
+    ]
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 4, "dead": 2}
