diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..8d71440
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,95 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.now = 0
+
+    def __call__(self):
+        return self.now
+
+
+def test_retry_delays_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise RuntimeError("oops")
+
+    job = queue.submit("bad", fail)
+    for time, next_time in [(0, 2), (2, 5), (5, 8)]:
+        clock.now = time
+        assert worker.run_due() == 1
+        assert job.run_at == next_time
+        assert worker.run_due() == 0
+    clock.now = 8
+    assert worker.run_due() == 1
+    assert job.attempts == 4
+    assert worker.dead == [("bad", 4, "RuntimeError('oops')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+
+
+def test_retry_order_and_eventual_success():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        log.append("first")
+        if log.count("first") == 1:
+            raise ValueError("first failure")
+
+    job = queue.submit("first", flaky)
+    assert worker.run_due() == 1
+    queue.submit("second", lambda: log.append("second"), delay=2)
+    clock.now = 2
+    assert worker.run_due() == 2
+    assert log == ["first", "first", "second"]
+    assert job.attempts == 2
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_snapshot_and_attempt_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail_after_time_moves():
+        clock.now = 100
+        raise ValueError()
+
+    job = queue.submit("bad", fail_after_time_moves)
+    queue.submit("later", lambda: None, delay=1)
+    assert worker.run_due() == 1
+    assert job.run_at == 2
+    assert len(queue) == 2
+    assert worker.run_due() == 2
+
+
+def test_base_exception_propagates_and_other_jobs_remain():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def interrupt():
+        raise KeyboardInterrupt()
+
+    job = queue.submit("interrupt", interrupt)
+    queue.submit("other", lambda: None)
+    with pytest.raises(KeyboardInterrupt):
+        worker.run_due()
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
+
+
+@pytest.mark.parametrize("settings", [dict(max_attempts=0), dict(base_delay=0), dict(base_delay=3, max_delay=2)])
+def test_invalid_settings(settings):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **settings)
