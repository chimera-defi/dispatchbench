diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..b693a2d
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,37 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+def test_apply_percent_rounds_total_half_up():
+    assert apply_percent(1005, 10) == 905
+    assert apply_percent(101, 50) == 51
+    assert apply_percent(-101, 50) == -51
+    assert apply_percent(123, 0) == 123
+    assert apply_percent(123, 100) == 0
+
+
+@pytest.mark.parametrize("pct", [-1, 101, 1.5, "10", True, None])
+def test_invalid_percentages(pct):
+    with pytest.raises(ValueError):
+        apply_percent(100, pct)
+    with pytest.raises(ValueError):
+        Store().add_code("bad", pct)
+
+
+def test_codes_apply_to_whole_total_case_insensitively():
+    store = Store()
+    store.add_item("a", 5)
+    store.add_item("b", 5)
+    store.add_code("SaVe", 10)
+    assert store.total_cents() == 10
+    assert store.total_cents("save") == 9
+    assert main(["total", "--code", "SAVE"], store) == "$0.09"
+    with pytest.raises(ValueError):
+        store.add_code("sAvE", 20)
+    with pytest.raises(KeyError):
+        store.total_cents("Missing")
+    assert main(["total", "--code", "Missing"], store) == "unknown code: Missing"
+    assert main(["total"], store) == "$0.10"
