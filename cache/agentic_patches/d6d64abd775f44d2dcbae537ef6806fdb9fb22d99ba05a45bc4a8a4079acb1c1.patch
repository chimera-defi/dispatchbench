diff --git a/cfg/loader.py b/cfg/loader.py
index acd880f..d6497a3 100644
--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,65 @@
-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    values, definitions = _parse(text)
+    resolved: dict[tuple[str, str], str] = {}
+    stack: list[tuple[str, str]] = []
+    active: dict[tuple[str, str], int] = {}
+
+    def fail(message: str, line: int) -> None:
+        # Resolution errors have an exact message; retain the source line separately.
+        error = ConfigError(message)
+        error.line = line
+        raise error
+
+    def resolve(section: str, key: str, line: int) -> str:
+        name = (section, key)
+        if name in resolved:
+            return resolved[name]
+        if name in active:
+            cycle = stack[active[name]:] + [name]
+            fail("reference cycle: " + " -> ".join(f"{s}.{k}" for s, k in cycle), line)
+
+        active[name] = len(stack)
+        stack.append(name)
+        value = values[section][key]
+        parts: list[str] = []
+        i = 0
+        while i < len(value):
+            if value[i] != "$":
+                parts.append(value[i])
+                i += 1
+            elif value.startswith("$$", i):
+                parts.append("$")
+                i += 2
+            elif value.startswith("${", i):
+                end = value.find("}", i + 2)
+                if end == -1:
+                    fail("unterminated reference", line)
+                reference = value[i + 2:end]
+                if "." in reference:
+                    ref_section, ref_key = reference.rsplit(".", 1)
+                else:
+                    ref_section, ref_key = section, reference
+                if ref_section not in values or ref_key not in values[ref_section]:
+                    fail(f"unknown reference: {reference}", line)
+                parts.append(resolve(ref_section, ref_key, line))
+                i = end + 1
+            else:
+                fail("invalid dollar sign", line)
+        stack.pop()
+        del active[name]
+        resolved[name] = "".join(parts)
+        return resolved[name]
+
+    for section, key, line in definitions:
+        resolve(section, key, line)
+    for (section, key), value in resolved.items():
+        values[section][key] = value
+    return values
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
