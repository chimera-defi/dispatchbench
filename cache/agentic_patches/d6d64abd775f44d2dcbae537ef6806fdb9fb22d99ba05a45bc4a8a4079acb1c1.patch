diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..547ba4d
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,64 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_escaping():
+    text = """root = origin
+[a.b]
+name = world
+message = Hello ${name}, ${.root}! $$${other}
+other = ${chain}
+chain = done
+[a]
+x = ${a.b.message}
+"""
+    config = load(text)
+    assert config['a.b']['message'] == 'Hello world, origin! $done'
+    assert config['a']['x'] == 'Hello world, origin! $done'
+    assert parse(text)['a']['x'] == '${a.b.message}'
+
+
+@pytest.mark.parametrize('reference', ['missing', 'db.hostt', '.absent'])
+def test_unknown_reference_keeps_name_and_outermost_line(reference):
+    text = f'[a]\nouter = ${{inner}}\ninner = ${{{reference}}}\n'
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == f'unknown reference: {reference}'
+    assert error.value.line == 2
+
+
+def test_cycle_reports_repeated_portion_and_outermost_line():
+    with pytest.raises(ConfigError) as error:
+        load('[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n')
+    assert str(error.value) == 'reference cycle: a.x -> a.y -> a.x'
+    assert error.value.line == 2
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as error:
+        load('x = ${y}\ny = ${.x}\n')
+    assert str(error.value) == 'reference cycle: .x -> .y -> .x'
+    assert error.value.line == 1
+
+
+def test_file_order_and_left_to_right_determine_first_error():
+    text = '[a]\nfirst = ok\n[b]\nx = ${y}${missing}\ny = ${x}\n[a]\nlater = ${absent}\n'
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == 'reference cycle: b.x -> b.y -> b.x'
+    assert error.value.line == 4
+
+
+@pytest.mark.parametrize('value', ['$', '$x', '${unfinished'])
+def test_malformed_reference_reports_outermost_line(value):
+    with pytest.raises(ConfigError) as error:
+        load(f'[a]\nx = ${{y}}\ny = {value}\n')
+    assert error.value.line == 2
+
+
+def test_escaped_dollars_are_not_reinterpreted():
+    config = load('x = $${missing}\ny = ${x} $$ $${x}\n')
+    assert config['']['y'] == '${missing} $ ${x}'
