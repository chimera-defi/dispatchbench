diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..48cd5dd
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,64 @@
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+def test_expiration_boundary_is_a_miss():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(9)
+    assert cache.get("a") == 1
+    clock.advance(1)
+    assert cache.get("a", "missing") == "missing"
+    assert (cache.stats.hits, cache.stats.misses, cache.stats.expirations) == (1, 1, 1)
+    assert cache.get("a") is None
+    assert (cache.stats.misses, cache.stats.expirations) == (2, 1)
+
+
+def test_overwrite_makes_key_most_recently_used():
+    cache = TTLCache(2, 10, FakeClock())
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.put("a", 3)
+    cache.put("c", 4)
+    assert cache.get("a") == 3
+    assert cache.get("b") is None
+    assert cache.get("c") == 4
+    assert cache.stats.evictions == 1
+
+
+def test_put_removes_expired_entries_before_evicting_live_entries():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("old", 1)
+    clock.advance(5)
+    cache.put("live", 2)
+    cache.get("old")  # The expired entry will be more recent in LRU order.
+    clock.advance(5)
+    cache.put("new", 3)
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+    assert (cache.stats.evictions, cache.stats.expirations) == (0, 1)
+
+
+def test_len_removes_all_expired_entries_once():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("c", 3)
+    clock.advance(5)
+    assert len(cache) == 1
+    assert len(cache) == 1
+    assert (cache.stats.expirations, cache.stats.evictions) == (2, 0)
+
+
+def test_overwriting_expired_key_counts_expiration():
+    clock = FakeClock()
+    cache = TTLCache(1, 10, clock)
+    cache.put("a", 1)
+    clock.advance(10)
+    cache.put("a", 2)
+    assert cache.get("a") == 2
+    assert (cache.stats.expirations, cache.stats.evictions) == (1, 0)
