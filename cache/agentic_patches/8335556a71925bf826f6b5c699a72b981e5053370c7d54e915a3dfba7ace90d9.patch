diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..c959e11
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,67 @@
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+def test_expiration_boundary_is_a_miss_not_a_hit():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("key", "value")
+    clock.advance(9)
+    assert cache.get("key") == "value"
+    clock.advance(1)
+    assert cache.get("key", "missing") == "missing"
+    assert (cache.stats.hits, cache.stats.misses, cache.stats.expirations) == (1, 1, 1)
+    assert cache.get("key") is None
+    assert (cache.stats.hits, cache.stats.misses, cache.stats.expirations) == (1, 2, 1)
+
+
+def test_overwrite_makes_key_most_recently_used():
+    cache = TTLCache(2, 10, FakeClock())
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.put("a", 3)
+    cache.put("c", 4)
+    assert cache.get("a") == 3
+    assert cache.get("b") is None
+    assert cache.get("c") == 4
+    assert cache.stats.evictions == 1
+
+
+def test_put_removes_expired_entry_even_when_it_is_not_lru():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("old", 1)
+    clock.advance(5)
+    cache.put("live", 2)
+    assert cache.get("old") == 1  # The older entry is now most recently used.
+    clock.advance(5)
+    cache.put("new", 3)
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+    assert cache.get("old") is None
+    assert (cache.stats.evictions, cache.stats.expirations) == (0, 1)
+
+
+def test_len_counts_only_live_entries_and_records_expirations_once():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("old", 1)
+    clock.advance(5)
+    cache.put("live", 2)
+    clock.advance(5)
+    assert len(cache) == 1
+    assert len(cache) == 1
+    assert cache.stats.expirations == 1
+    clock.advance(5)
+    assert len(cache) == 0
+    assert cache.stats.expirations == 2
+
+
+def test_overwriting_expired_key_counts_expiration():
+    clock = FakeClock()
+    cache = TTLCache(1, 10, clock)
+    cache.put("key", 1)
+    clock.advance(10)
+    cache.put("key", 2)
+    assert cache.get("key") == 2
+    assert (cache.stats.expirations, cache.stats.evictions) == (1, 0)
