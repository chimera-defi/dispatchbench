--- a/inv/money.py
+++ b/inv/money.py
@@ -1,3 +1,11 @@
+def apply_percent(cents: int, pct: int) -> int:
+    """Apply a percentage discount, rounding half up to whole cents."""
+    if type(pct) is not int or not 0 <= pct <= 100:
+        raise ValueError("pct must be an integer from 0 to 100")
+    amount = cents * (100 - pct)
+    return (amount + 50) // 100 if amount >= 0 else -((-amount + 50) // 100)
+
+
 def format_cents(cents: int) -> str:
     """1234 -> '$12.34'; negative values get a leading '-'."""
     sign = "-" if cents < 0 else ""
