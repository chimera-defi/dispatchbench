diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..a1c78a9
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,232 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, t=0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"max_attempts": 0},
+    {"max_attempts": -1},
+    {"base_delay": 0},
+    {"base_delay": -1},
+    {"max_delay": 1},
+    {"base_delay": 4, "max_delay": 3},
+])
+def test_rejects_invalid_settings(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_default_retries_and_last_exception():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    errors = iter([ValueError("first"), RuntimeError("second"), OSError("last")])
+
+    def fail():
+        raise next(errors)
+
+    job = queue.submit("bad", fail)
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert job.attempts == 1
+    assert job.run_at == 2
+    assert worker.run_due() == 0
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+    assert job.run_at == 6
+    clock.t = 5
+    assert worker.run_due() == 0
+    clock.t = 6
+    assert worker.run_due() == 1
+    assert job.attempts == 3
+    assert worker.dead == [("bad", 3, "OSError('last')")]
+    assert worker.done == []
+    assert len(queue) == 0
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 3, "dead": 1}
+
+
+def test_success_after_failure():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append(clock.t)
+        if len(calls) == 1:
+            raise ValueError("retry")
+
+    job = queue.submit("flaky", flaky)
+    successful = queue.submit("good", lambda: None)
+    assert worker.run_due() == 2
+    assert worker.done == ["good"]
+    assert successful.attempts == 1
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert calls == [0, 2]
+    assert job.attempts == 2
+    assert worker.done == ["good", "flaky"]
+    assert worker.dead == []
+    assert len(queue) == 0
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_backoff_is_capped():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=5, base_delay=2, max_delay=5)
+
+    def fail():
+        raise RuntimeError("failed")
+
+    job = queue.submit("bad", fail)
+    for delay in [2, 4, 5, 5]:
+        attempted_at = clock.t
+        assert worker.run_due() == 1
+        assert job.run_at == attempted_at + delay
+        clock.t = job.run_at
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 5, "RuntimeError('failed')")]
+    assert len(queue) == 0
+
+
+def test_dead_jobs_are_in_death_order():
+    queue = JobQueue(Clock())
+    worker = Worker(queue, max_attempts=1, base_delay=1, max_delay=1)
+
+    def fail():
+        raise ValueError("bad")
+
+    queue.submit("second", fail, delay=-1)
+    queue.submit("first", fail, delay=-2)
+    assert worker.run_due() == 2
+    assert worker.dead == [("first", 1, "ValueError('bad')"),
+                           ("second", 1, "ValueError('bad')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 2, "dead": 2}
+    assert len(queue) == 0
+
+
+def test_retry_preserves_original_sequence():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append("retry")
+        if calls.count("retry") == 1:
+            raise ValueError("retry")
+
+    queue.submit("earlier", lambda: calls.append("earlier"), delay=2)
+    job = queue.submit("retry", flaky)
+    original_seq = job.seq
+    queue.submit("later", lambda: calls.append("later"), delay=2)
+    assert worker.run_due() == 1
+    assert job.seq == original_seq
+    queue.submit("latest", lambda: calls.append("latest"), delay=2)
+    clock.t = 2
+    assert worker.run_due() == 4
+    assert calls == ["retry", "earlier", "retry", "later", "latest"]
+
+
+def test_attempt_time_is_used_even_if_job_advances_clock():
+    clock = Clock(10)
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def advance():
+        clock.t = 20
+
+    def fail():
+        clock.t = 100
+        raise ValueError("bad")
+
+    queue.submit("advance", advance)
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 2
+    assert job.run_at == 22
+    assert job.attempts == 1
+    assert len(queue) == 1
+
+
+def test_only_jobs_due_at_start_are_run():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def advance_and_submit():
+        clock.t = 10
+        queue.submit("new", lambda: calls.append("new"))
+
+    queue.submit("advance", advance_and_submit)
+    future = queue.submit("future", lambda: calls.append("future"), delay=5)
+    assert worker.run_due() == 1
+    assert future.attempts == 0
+    assert calls == []
+    assert worker.run_due() == 2
+    assert calls == ["future", "new"]
+
+
+def test_retry_rounding_to_now_waits_for_next_call():
+    clock = Clock(1e20)
+    queue = JobQueue(clock)
+    worker = Worker(queue, base_delay=1)
+
+    def fail():
+        raise ValueError("bad")
+
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock.t
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+
+
+@pytest.mark.parametrize("error", [KeyboardInterrupt(), SystemExit(2), BaseException("stop")])
+def test_base_exceptions_propagate_without_retry(error):
+    queue = JobQueue(Clock())
+    worker = Worker(queue)
+
+    def interrupt():
+        raise error
+
+    interrupted = queue.submit("interrupt", interrupt)
+    untouched = queue.submit("untouched", lambda: None)
+    with pytest.raises(type(error)) as raised:
+        worker.run_due()
+    assert raised.value is error
+    assert interrupted.attempts == 1
+    assert untouched.attempts == 0
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert worker.done == ["untouched"]
+
+
+def test_failures_stay_with_job_across_workers():
+    clock = Clock()
+    queue = JobQueue(clock)
+
+    def fail():
+        raise ValueError("bad")
+
+    job = queue.submit("bad", fail)
+    assert Worker(queue).run_due() == 1
+    clock.t = 2
+    worker = Worker(queue, max_attempts=2)
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+    assert worker.dead == [("bad", 2, "ValueError('bad')")]
