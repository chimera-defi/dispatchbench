diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..6aa0451
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,115 @@
+import pytest
+
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+from kvcache.stats import Stats
+
+
+def test_entry_is_live_before_expiration():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+
+    clock.advance(9)
+
+    assert cache.get("a") == 1
+    assert cache.stats == Stats(hits=1)
+
+
+@pytest.mark.parametrize("elapsed", [10, 11])
+def test_expired_lookup_counts_as_miss_once_per_lookup(elapsed):
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(elapsed)
+
+    assert cache.get("a", "missing") == "missing"
+    assert cache.stats == Stats(misses=1, expirations=1)
+    assert cache.get("a", "missing") == "missing"
+    assert cache.stats == Stats(misses=2, expirations=1)
+
+
+def test_overwrite_refreshes_recency_and_ttl():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("a", 3)
+    cache.put("c", 4)
+
+    assert cache.stats == Stats(evictions=1)
+    assert cache.get("b") is None
+    clock.advance(5)
+    assert cache.get("a") == 3
+    clock.advance(5)
+    assert cache.get("a") is None
+    assert cache.stats == Stats(hits=1, misses=2, evictions=1, expirations=1)
+
+
+@pytest.mark.parametrize("expired_is_most_recent", [False, True])
+def test_put_removes_expired_entry_before_evicting_live_entry(expired_is_most_recent):
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("expired", 1)
+    clock.advance(1)
+    cache.put("live", 2)
+    if expired_is_most_recent:
+        assert cache.get("expired") == 1
+    clock.advance(9)
+
+    cache.put("new", 3)
+
+    assert cache.stats == Stats(hits=int(expired_is_most_recent), expirations=1)
+    assert len(cache) == 2
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+
+
+def test_put_removes_all_expired_entries():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("live", 3)
+    assert cache.get("a") == 1
+    clock.advance(5)
+
+    cache.put("new", 4)
+
+    assert cache.stats == Stats(hits=1, expirations=2)
+    assert len(cache) == 2
+    assert cache.get("live") == 3
+    assert cache.get("new") == 4
+
+
+def test_overwriting_expired_entry_counts_as_expiration():
+    clock = FakeClock()
+    cache = TTLCache(1, 10, clock)
+    cache.put("a", 1)
+    clock.advance(10)
+
+    cache.put("a", 2)
+
+    assert cache.stats == Stats(expirations=1)
+    assert len(cache) == 1
+    assert cache.get("a") == 2
+
+
+def test_len_counts_only_live_entries_and_expires_each_entry_once():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("c", 3)
+    clock.advance(5)
+
+    assert len(cache) == 1
+    assert cache.stats == Stats(expirations=2)
+    assert len(cache) == 1
+    assert cache.stats == Stats(expirations=2)
+    clock.advance(5)
+    assert len(cache) == 0
+    assert cache.stats == Stats(expirations=3)
