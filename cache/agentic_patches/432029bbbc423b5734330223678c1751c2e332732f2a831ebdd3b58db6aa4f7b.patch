diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..4c8a141
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,114 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, now=0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+
+@pytest.mark.parametrize("options", [
+    {"max_attempts": 0}, {"base_delay": 0},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_configuration(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_backoff_dead_and_statistics():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise ValueError("oops")
+
+    job = queue.submit("bad", fail)
+    for attempt, next_time in [(1, 2), (2, 5), (3, 8), (4, None)]:
+        assert worker.run_due() == 1
+        assert job.attempts == attempt
+        if next_time is not None:
+            assert job.run_at == next_time
+            assert worker.run_due() == 0
+            clock.now = next_time
+    assert worker.dead == [("bad", 4, "ValueError('oops')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_retry_success_and_original_order():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append("first")
+        if len(calls) == 1:
+            raise RuntimeError("retry")
+
+    job = queue.submit("first", flaky)
+    assert worker.run_due() == 1
+    queue.submit("second", lambda: calls.append("second"), delay=2)
+    clock.now = 2
+    assert worker.run_due() == 2
+    assert calls == ["first", "first", "second"]
+    assert job.attempts == 2
+    assert worker.done == ["first", "second"]
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_attempt_time_and_initial_due_snapshot():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail_after_time_passes():
+        clock.now = 10
+        raise ValueError()
+
+    job = queue.submit("bad", fail_after_time_passes)
+    queue.submit("later", lambda: None, delay=1)
+    assert worker.run_due() == 1
+    assert job.run_at == 2
+    assert worker.run_due() == 2
+
+
+def test_retry_rounded_to_now_waits_for_next_call():
+    clock = Clock(1e20)
+    queue = JobQueue(clock)
+    worker = Worker(queue, base_delay=1)
+
+    def fail():
+        raise ValueError()
+
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock.now
+    assert worker.run_due() == 1
+
+
+def test_interrupt_propagates_and_preserves_other_due_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    interrupt = KeyboardInterrupt()
+
