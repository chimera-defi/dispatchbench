@@ -0,0 +1,135 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_same_section_forward_and_nested_references():
+    config = load("[app]\nurl = https://${host}:${port}/${path}\nhost = ${name}.test\nname = example\nport = 443\npath = api\n")
+    assert config["app"]["url"] == "https://example.test:443/api"
+    assert config["app"]["host"] == "example.test"
+
+
+def test_cross_section_references_use_target_section_for_nested_references():
+    config = load("[app]\nhost = local\nurl = ${db.host}/${db.host}\n[db]\nhost = ${name}\nname = database\n")
+    assert config["app"]["url"] == "database/database"
+
+
+def test_last_dot_separates_section_and_key():
+    config = load("[app]\nx = ${a.b.c}\n[a.b]\nc = value\n")
+    assert config["app"]["x"] == "value"
+
+
+def test_unnamed_section_references():
+    config = load("name = example\nalias = ${name}\n[app]\nname = local\nx = ${.alias}/${name}\n")
+    assert config[""]["alias"] == "example"
+    assert config["app"]["x"] == "example/local"
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("", ""),
+        ("plain text", "plain text"),
+        ("$$", "$"),
+        ("$$$$", "$$"),
+        ("$${missing}", "${missing}"),
+        ("$$${key}$$", "$value$"),
+        ("before ${empty} after", "before  after"),
+        ("${key}${key}", "valuevalue"),
+    ],
+)
+def test_value_scanning(value, expected):
+    config = load(f"result = {value}\nkey = value\nempty =\n")
+    assert config[""]["result"] == expected
+
+
+def test_resolved_dollars_are_not_interpreted_again():
+    config = load("a = ${b}\nb = ${c}\nc = $${missing} $$\n")
+    assert config[""] == dict.fromkeys(("a", "b", "c"), "${missing} $")
+
+
+@pytest.mark.parametrize("reference", ["hostt", "db.hostt", "missing.host", "a.b.c", ".missing", "", " db.host "])
+def test_unknown_reference_preserves_name(reference):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[app]\nx = ${{{reference}}}\n[db]\nhost = localhost\n")
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "price $5", "$$$", "${", "text ${key", "${key}$"])
+def test_invalid_reference_syntax(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[app]\nx = {value}\nkey = value\n")
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["${missing}", "$bad", "${unterminated"])
+def test_nested_errors_report_outermost_definition_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"# header\n[app]\nouter = ${{other.middle}}\n[other]\nmiddle = ${{bad}}\nbad = {value}\n")
+    assert exc.value.line == 3
+
+
+@pytest.mark.parametrize(
+    ("text", "chain", "line"),
+    [
+        ("[a]\nx = ${x}\n", "a.x -> a.x", 2),
+        ("[a]\nx = ${y}\ny = ${x}\n", "a.x -> a.y -> a.x", 2),
+        ("x = ${y}\ny = ${x}\n", ".x -> .y -> .x", 1),
+        ("[a]\nouter = ${b.x}\n[b]\nx = ${y}\ny = ${x}\n", "b.x -> b.y -> b.x", 2),
+        ("[a]\nx = ${b.y}\n[b]\ny = ${a.x}\n", "a.x -> b.y -> a.x", 2),
+        ("x = ${a.b.y}\n[a.b]\ny = ${.x}\n", ".x -> a.b.y -> .x", 1),
+    ],
+)
+def test_cycles(text, chain, line):
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == f"reference cycle: {chain}"
+    assert exc.value.line == line
+
+
+def test_resolution_follows_file_order_across_reopened_sections():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nplain = value\n[b]\nx = ${x}\n[a]\ny = ${y}\n")
+    assert str(exc.value) == "reference cycle: b.x -> b.x"
+    assert exc.value.line == 4
+
+
+def test_resolution_follows_file_order_across_unnamed_section():
+    with pytest.raises(ConfigError) as exc:
+        load("outer = ${b.x}\n[a]\nx = ${x}\n[b]\nx = ${x}\n")
+    assert str(exc.value) == "reference cycle: b.x -> b.x"
+    assert exc.value.line == 1
+
+
+def test_references_are_resolved_from_left_to_right():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nouter = ${right} ${left}\nleft = ${left}\nright = ${right}\n")
+    assert str(exc.value) == "reference cycle: a.right -> a.right"
+    assert exc.value.line == 2
+
+
+def test_left_reference_error_precedes_later_syntax_error():
+    with pytest.raises(ConfigError) as exc:
+        load("outer = ${missing} ${\n")
+    assert str(exc.value) == "unknown reference: missing"
+    assert exc.value.line == 1
+
+
+def test_parse_keeps_raw_values():
+    assert parse("x = $bad ${missing} $$\n") == {"": {"x": "$bad ${missing} $$"}}
+
+
+def test_parse_errors_precede_resolution_errors():
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${missing}\nx = duplicate\n")
+    assert str(exc.value) == "line 2: duplicate key 'x'"
+    assert exc.value.line == 2
+
+
+def test_empty_sections_and_values_are_preserved():
+    assert load("[empty]\n[app]\nx =\ny = ${x}\n") == {
+        "": {}, "empty": {}, "app": {"x": "", "y": ""},
+    }
