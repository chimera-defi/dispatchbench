diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..71759c1
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,63 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_nested_references_sections_and_literals():
+    text = """root = global
+[a.b]
+c = ${x}/${.root}/$$/${x}
+x = ${y}
+y = value
+[other]
+result = ${a.b.c}-$5
+"""
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert error.value.line == 7
+    config = load(text.replace("-$5", "-$$5"))
+    assert config["a.b"]["c"] == "value/global/$/value"
+    assert config["other"]["result"] == "value/global/$/value-$5"
+    assert parse(text)["a.b"]["c"] == "${x}/${.root}/$$/${x}"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", ".absent"])
+def test_missing_reference_preserves_name_and_outer_line(reference):
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nfirst = ${second}\nsecond = ${" + reference + "}\n")
+    assert f"unknown reference: {reference}" in str(error.value)
+    assert error.value.line == 2
+
+
+def test_cycle_chain_and_outer_line():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n")
+    assert str(error.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert error.value.line == 2
+
+
+def test_file_order_and_left_to_right_determine_cycle():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nx = ${b.z}${x}\n[b]\nz = ${.root}\nroot = ok\n[]\n")
+    assert error.value.line == 6  # Parsing errors take precedence over resolution.
+
+    with pytest.raises(ConfigError) as error:
+        load("root = ${a.x}\n[a]\nx = ${b.z}${x}\n[b]\nz = ${.root}\n")
+    assert str(error.value) == "reference cycle: .root -> a.x -> b.z -> .root"
+    assert error.value.line == 1
+
+
+@pytest.mark.parametrize("value", ["${unfinished", "$", "$x", "prefix $ end"])
+def test_invalid_dollars_and_unterminated_reference(value):
+    with pytest.raises(ConfigError) as error:
+        load(f"[a]\nx = ${{y}}\ny = {value}\n")
+    assert error.value.line == 2
+
+
+def test_reopened_section_resolves_in_file_order():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nfirst = ok\n[b]\nfirst = ${first}\n[a]\nsecond = ${second}\n")
+    assert str(error.value) == "reference cycle: b.first -> b.first"
+    assert error.value.line == 4
