diff --git a/cfg/loader.py b/cfg/loader.py
index acd880f..18c88d9 100644
--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,63 @@
-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse_with_locations
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    raw, locations = _parse_with_locations(text)
+    resolved: dict[str, dict[str, str]] = {section: {} for section in raw}
+    stack: list[tuple[str, str]] = []
+    active: dict[tuple[str, str], int] = {}
+
+    def resolve(section: str, key: str) -> str:
+        name = (section, key)
+        if key in resolved[section]:
+            return resolved[section][key]
+        if name in active:
+            cycle = stack[active[name]:] + [name]
+            raise ConfigError("reference cycle: " + " -> ".join(f"{s}.{k}" for s, k in cycle))
+
+        active[name] = len(stack)
+        stack.append(name)
+        value = raw[section][key]
+        parts: list[str] = []
+        i = 0
+        while i < len(value):
+            if value[i] != "$":
+                parts.append(value[i])
+                i += 1
+            elif value.startswith("$$", i):
+                parts.append("$")
+                i += 2
+            elif value.startswith("${", i):
+                end = value.find("}", i + 2)
+                if end == -1:
+                    raise ConfigError("unterminated reference")
+                reference = value[i + 2:end]
+                if "." in reference:
+                    target_section, _, target_key = reference.rpartition(".")
+                else:
+                    target_section, target_key = section, reference
+                if target_section not in raw or target_key not in raw[target_section]:
+                    raise ConfigError(f"unknown reference: {reference}")
+                parts.append(resolve(target_section, target_key))
+                i = end + 1
+            else:
+                raise ConfigError("invalid dollar sign")
+        stack.pop()
+        del active[name]
+        result = "".join(parts)
+        resolved[section][key] = result
+        return result
+
+    for (section, key), line in locations.items():
+        try:
+            resolve(section, key)
+        except ConfigError as error:
+            error.line = line
+            raise
+    return {section: {key: resolved[section][key] for key in values}
+            for section, values in raw.items()}
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
