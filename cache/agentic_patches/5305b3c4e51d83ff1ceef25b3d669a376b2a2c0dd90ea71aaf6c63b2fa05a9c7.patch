diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..87f84dc
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,101 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, now=0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+
+@pytest.mark.parametrize("options", [
+    {"max_attempts": 0}, {"base_delay": 0},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_settings(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_retries_backoff_cap_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        clock.now += 1  # Delay is measured from the start of the attempt.
+        raise ValueError("bad")
+
+    job = queue.submit("broken", fail)
+    for attempt, when in enumerate((0, 2, 5, 8), 1):
+        clock.now = when
+        assert worker.run_due() == 1
+        assert job.attempts == attempt
+        if attempt < 4:
+            assert job.run_at == (2, 5, 8)[attempt - 1]
+            clock.now = job.run_at - 1
+            assert worker.run_due() == 0
+    assert worker.dead == [("broken", 4, "ValueError('bad')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_retry_success_and_original_sequence():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def sometimes():
+        calls.append("first")
+        if len(calls) == 1:
+            raise RuntimeError("retry")
+
+    job = queue.submit("first", sometimes)
+    assert worker.run_due() == 1
+    queue.submit("second", lambda: calls.append("second"), delay=2)
+    clock.now = 2
+    assert worker.run_due() == 2
+    assert calls == ["first", "first", "second"]
+    assert job.attempts == 2
+    assert worker.done == ["first", "second"]
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_snapshot_excludes_retries_and_new_jobs_even_if_due():
+    clock = Clock(1e20)  # Adding the delay rounds back to the same float.
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail():
+        queue.submit("new", lambda: None)
+        raise RuntimeError()
+
+    job = queue.submit("retry", fail)
+    assert worker.run_due() == 1
+    assert job.attempts == 1
+    assert len(queue) == 2
+
+
+def test_interrupt_propagates_and_preserves_other_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    interrupt = KeyboardInterrupt()
+
+    def stop():
+        raise interrupt
+
+    job = queue.submit("stop", stop)
+    queue.submit("later", lambda: None)
+    with pytest.raises(KeyboardInterrupt) as caught:
+        worker.run_due()
+    assert caught.value is interrupt
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
