diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..b83d82c
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,126 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0
+
+    def __call__(self):
+        return self.t
+
+
+def test_retry_backoff_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+    times = []
+
+    def fail():
+        times.append(clock.t)
+        raise ValueError(f"failure {len(times)}")
+
+    job = queue.submit("broken", fail)
+    for time in (0, 2, 5, 8):
+        clock.t = time
+        assert worker.run_due() == 1
+        assert job.attempts == len(times)
+        if time != 8:
+            assert worker.run_due() == 0
+    assert times == [0, 2, 5, 8]
+    assert worker.dead == [("broken", 4, "ValueError('failure 4')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_retry_success_and_original_sequence():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        log.append("old")
+        if len(log) == 1:
+            raise RuntimeError("try again")
+
+    job = queue.submit("old", flaky)
+    assert worker.run_due() == 1
+    queue.submit("new", lambda: log.append("new"), delay=2)
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert log == ["old", "old", "new"]
+    assert job.attempts == 2
+    assert worker.done == ["old", "new"]
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_snapshot_and_attempt_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def advance():
+        clock.t = 10
+        queue.submit("submitted", lambda: calls.append("submitted"))
+
+    def fail():
+        calls.append("failed")
+        clock.t = 20
+        raise RuntimeError()
+
+    queue.submit("advance", advance)
+    job = queue.submit("fail", fail)
+    queue.submit("later", lambda: calls.append("later"), delay=1)
+    assert worker.run_due() == 2
+    assert job.run_at == 12  # measured when fail started, not when it raised
+    assert calls == ["failed"]
+    assert worker.run_due() == 3
+    assert job.attempts == 2
+
+
+def test_base_exception_propagates_and_preserves_other_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    interrupt = KeyboardInterrupt("stop")
+
+    def stop():
+        raise interrupt
+
+    job = queue.submit("stop", stop)
+    queue.submit("next", lambda: None)
+    with pytest.raises(KeyboardInterrupt) as caught:
+        worker.run_due()
+    assert caught.value is interrupt
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"max_attempts": 0}, {"base_delay": 0},
+    {"base_delay": 4, "max_delay": 3},
+])
+def test_invalid_configuration(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_dead_order_and_single_attempt():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=1)
+
+    def fail():
+        raise RuntimeError("bad")
+
+    queue.submit("first", fail)
+    queue.submit("second", fail)
+    assert worker.run_due() == 2
+    assert worker.dead == [("first", 1, "RuntimeError('bad')"),
+                           ("second", 1, "RuntimeError('bad')")]
