diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..099666c
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,83 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import get, load
+
+
+def test_same_section_and_text():
+    c = load("[a]\nname = app\ngreet = hi ${name}!\n")
+    assert get(c, "a.greet") == "hi app!"
+
+
+def test_cross_section_dotted_section_and_unnamed():
+    c = load(
+        "base = root\n"
+        "[a.b]\n"
+        "c = ${.base}-${a.b.d}\n"
+        "d = leaf\n"
+    )
+    assert get(c, "a.b.c") == "root-leaf"
+    assert get(c, "base") == "root"
+
+
+def test_nested_and_dollar_escape():
+    c = load("[a]\nx = ${y}/$${z}\ny = ${z}\nz = ok\n")
+    assert get(c, "a.x") == "ok/${z}"
+
+
+def test_unknown_reference_uses_written_name_and_outer_line():
+    with pytest.raises(ConfigError) as e:
+        load("[db]\nhost = ${db.hostt}\nport = 1\n")
+    assert e.value.line == 2
+    assert "unknown reference: db.hostt" in str(e.value)
+
+    with pytest.raises(ConfigError) as e:
+        load("[db]\nhost = localhost\nurl = ${missing}\n")
+    assert e.value.line == 3
+    assert "unknown reference: missing" in str(e.value)
+
+    with pytest.raises(ConfigError) as e:
+        load("a = ${no.such}\n")
+    assert e.value.line == 1
+    assert "unknown reference: no.such" in str(e.value)
+
+
+def test_cycle_file_order_and_left_to_right():
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = ${y}\ny = ${x}\n")
+    assert e.value.line == 2
+    assert str(e.value) == "line 2: reference cycle: a.x -> a.y -> a.x"
+
+    # y is reached through x first; the repeated key starts the chain.
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nz = ${x}\nx = ${y}\ny = ${x}\n")
+    assert e.value.line == 2
+    assert str(e.value) == "line 2: reference cycle: a.x -> a.y -> a.x"
+
+    with pytest.raises(ConfigError) as e:
+        load("x = ${y}\ny = ${x}\n")
+    assert str(e.value) == "line 1: reference cycle: .x -> .y -> .x"
+
+    # Left reference cycles before the right one is considered.
+    with pytest.raises(ConfigError) as e:
+        load("[a]\np = ${x}${m}\nx = ${p}\nm = ${n}\nn = ${m}\n")
+    assert e.value.line == 2
+    assert str(e.value) == "line 2: reference cycle: a.p -> a.x -> a.p"
+
+
+def test_unterminated_and_bare_dollar_use_outer_line():
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = ${y\ny = ok\n")
+    assert e.value.line == 2
+    assert "unterminated" in str(e.value)
+
+    with pytest.raises(ConfigError) as e:
+        load("[a]\nx = ${y}\ny = pre $ post\n")
+    assert e.value.line == 2
+    assert "invalid $" in str(e.value)
+
+
+def test_plain_values_unchanged():
+    c = load("name = app\n[db]\nhost = localhost\n")
+    assert get(c, "name") == "app"
+    assert get(c, "db.host") == "localhost"
