--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,74 @@
-from .parser import parse
+from .errors import ConfigError
+from .parser import parse_with_lines
+
+
+def _fq(section: str, key: str) -> str:
+    return f".{key}" if section == "" else f"{section}.{key}"
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
-    """Parse config text and return the resolved values."""
-    return parse(text)
+    """Parse config text and return values with ${...} references resolved."""
+    raw, defined_at = parse_with_lines(text)
+    resolved: dict[tuple[str, str], str] = {}
+
+    def resolve(section: str, key: str, stack: list[str], line: int) -> str:
+        ident = (section, key)
+        if ident in resolved:
+            return resolved[ident]
+        name = _fq(section, key)
+        if name in stack:
+            start = stack.index(name)
+            chain = stack[start:] + [name]
+            raise ConfigError("reference cycle: " + " -> ".join(chain), line)
+        stack.append(name)
+        try:
+            value = _expand(raw[section][key], section, stack, line)
+        finally:
+            stack.pop()
+        resolved[ident] = value
+        return value
+
+    def lookup(ref: str, section: str, stack: list[str], line: int) -> str:
+        if "." in ref:
+            target_section, target_key = ref.rsplit(".", 1)
+        else:
+            target_section, target_key = section, ref
+        if target_section not in raw or target_key not in raw[target_section]:
+            raise ConfigError(f"unknown reference: {ref}", line)
+        return resolve(target_section, target_key, stack, line)
+
+    def _expand(value: str, section: str, stack: list[str], line: int) -> str:
+        parts: list[str] = []
+        i = 0
+        while i < len(value):
+            if value[i] != "$":
+                parts.append(value[i])
+                i += 1
+                continue
+            nxt = value[i + 1] if i + 1 < len(value) else ""
+            if nxt == "$":
+                parts.append("$")
+                i += 2
+                continue
+            if nxt == "{":
+                end = value.find("}", i + 2)
+                if end < 0:
+                    raise ConfigError("unterminated reference", line)
+                parts.append(lookup(value[i + 2 : end], section, stack, line))
+                i = end + 1
+                continue
+            raise ConfigError("invalid $", line)
+        return "".join(parts)
+
+    for section, keys in raw.items():
+        for key in keys:
+            if (section, key) not in resolved:
+                resolve(section, key, [], defined_at[(section, key)])
+
+    return {
+        section: {key: resolved[(section, key)] for key in keys}
+        for section, keys in raw.items()
+    }
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
