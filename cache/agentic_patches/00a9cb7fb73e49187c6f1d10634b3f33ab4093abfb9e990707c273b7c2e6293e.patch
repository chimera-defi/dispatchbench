@@ -0,0 +1,137 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_nested_forward_references_and_multiple_substitutions():
+    config = load(
+        "[app]\n"
+        "url = https://${host}:${port}/${path}?host=${host}\n"
+        "host = ${server}\n"
+        "server = example.com\n"
+        "port = 443\n"
+        "path = api\n"
+    )
+    assert config["app"]["url"] == "https://example.com:443/api?host=example.com"
+    assert config["app"]["host"] == "example.com"
+
+
+def test_sections_last_dot_and_unnamed_section():
+    config = load(
+        "root = global\n"
+        "copy = ${root}\n"
+        "[app]\n"
+        "root = local\n"
+        "value = ${root}/${.root}/${a.b.c}/${db.host}\n"
+        "[a.b]\n"
+        "c = dotted\n"
+        "[db]\n"
+        "host = ${.copy}\n"
+    )
+    assert config["app"]["value"] == "local/global/dotted/global"
+
+
+def test_unqualified_references_use_the_referenced_values_section():
+    config = load("[a]\nx = ${b.y}\nz = wrong\n[b]\ny = ${z}\nz = right")
+    assert config["a"]["x"] == "right"
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("", ""),
+        ("plain text", "plain text"),
+        ("$$", "$"),
+        ("$$$$", "$$"),
+        ("$${missing}", "${missing}"),
+        ("before $$ after", "before $ after"),
+        ("$$${target}", "$ok"),
+        ("${target}$$${target}", "ok$ok"),
+    ],
+)
+def test_literals_and_escapes(raw, expected):
+    assert load(f"value = {raw}\ntarget = ok")[""]["value"] == expected
+
+
+def test_substituted_dollars_are_not_interpreted_again():
+    config = load("value = ${literal}\nliteral = $${missing} $$")
+    assert config[""]["value"] == "${missing} $"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", "absent.host", "a.b.c", ".key", ""])
+def test_unknown_reference_preserves_original_name(reference):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[app]\nvalue = ${{{reference}}}\n[db]\nhost = localhost")
+    assert f"unknown reference: {reference}" in str(exc.value)
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("raw", ["$", "$x", "text $!", "$$$", "${", "${missing"])
+def test_malformed_references(raw):
+    with pytest.raises(ConfigError) as exc:
+        load(f"# comment\n[app]\nvalue = {raw}")
+    assert exc.value.line == 3
+
+
+@pytest.mark.parametrize("bad_value", ["${missing}", "${absent.key}", "$bad", "${"])
+def test_nested_errors_use_outermost_line(bad_value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"\n[app]\nouter = ${{next}}\nnext = ${{bad}}\nbad = {bad_value}")
+    assert exc.value.line == 3
+
+
+@pytest.mark.parametrize(
+    ("text", "chain", "line"),
+    [
+        ("[a]\nx = ${y}\ny = ${x}", "a.x -> a.y -> a.x", 2),
+        ("x = ${x}", ".x -> .x", 1),
+        ("[a]\nx = ${x}", "a.x -> a.x", 2),
+        ("[a]\nouter = ${x}\nx = ${y}\ny = ${x}", "a.x -> a.y -> a.x", 2),
+        ("x = ${a.y}\n[a]\ny = ${.x}", ".x -> a.y -> .x", 1),
+        ("[a.b]\nx = ${y}\ny = ${x}", "a.b.x -> a.b.y -> a.b.x", 2),
+    ],
+)
+def test_cycles_report_exact_chain_and_outermost_line(text, chain, line):
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == f"reference cycle: {chain}"
+    assert exc.value.line == line
+
+
+def test_file_order_is_preserved_when_sections_are_reopened():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nok = fine\n[b]\nx = ${x}\n[a]\ny = ${y}")
+    assert str(exc.value) == "reference cycle: b.x -> b.x"
+    assert exc.value.line == 4
+
+
+def test_references_are_resolved_left_to_right():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nouter = ${y}${x}\nx = ${x}\ny = ${y}")
+    assert str(exc.value) == "reference cycle: a.y -> a.y"
+    assert exc.value.line == 2
+
+
+def test_errors_are_reached_during_left_to_right_resolution():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nouter = ${x}$invalid\nx = ${missing}")
+    assert str(exc.value) == "unknown reference: missing"
+    assert exc.value.line == 2
+
+
+def test_parser_still_returns_raw_values():
+    assert parse("x = ${missing} $$ $bad")[""]["x"] == "${missing} $$ $bad"
+
+
+def test_parsing_finishes_before_resolution():
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${missing}\nx = duplicate")
+    assert str(exc.value) == "line 2: duplicate key 'x'"
+    assert exc.value.line == 2
+
+
+def test_empty_config_and_empty_sections_are_preserved():
+    assert load("") == {"": {}}
+    assert load("[empty]") == {"": {}, "empty": {}}
