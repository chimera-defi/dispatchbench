diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..091d5eb
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,46 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_escaping():
+    config = load("root = home\n[a.b]\nc = ${.root}/$$${name}\nname = ${other}\nother = value\n[a]\nx = ${a.b.c} + ${a.b.name}\n")
+    assert config["a.b"]["c"] == "home/$value"
+    assert config["a"]["x"] == "home/$value + value"
+    assert parse("x = ${missing}\n")[""]["x"] == "${missing}"
+
+
+@pytest.mark.parametrize("value, message", [
+    ("${db.hostt}", "unknown reference: db.hostt"),
+    ("${missing}", "unknown reference: missing"),
+    ("${unfinished", "unterminated"),
+    ("$x", "dollar"),
+    ("$", "dollar"),
+])
+def test_resolution_errors_use_outermost_line(value, message):
+    with pytest.raises(ConfigError, match=message) as error:
+        load(f"[a]\nx = ${{y}}\ny = {value}\n")
+    assert error.value.line == 2
+
+
+def test_cycle_reports_first_repeated_key_and_outer_line():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nouter = ${x}\nx = ${y}\ny = ${x}\n")
+    assert str(error.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert error.value.line == 2
+
+
+def test_cycles_follow_file_order_even_when_sections_repeat():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nok = 1\n[b]\nx = ${x}\n[a]\ny = ${y}\n")
+    assert str(error.value) == "reference cycle: b.x -> b.x"
+    assert error.value.line == 4
+
+
+def test_references_follow_left_to_right_order():
+    with pytest.raises(ConfigError) as error:
+        load("x = ${y}${z}\ny = ${y}\nz = ${z}\n")
+    assert str(error.value) == "reference cycle: .y -> .y"
+    assert error.value.line == 1
