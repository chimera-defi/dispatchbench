index acd880f..2d481e5 100644
--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,62 @@
-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    values, definitions = _parse(text)
+    resolved = {section: {} for section in values}
+    stack = []
+    active = {}
+
+    def resolve(section, key):
+        name = (section, key)
+        if key in resolved[section]:
+            return resolved[section][key]
+        if name in active:
+            cycle = stack[active[name]:] + [name]
+            raise ConfigError("reference cycle: " + " -> ".join(
+                f"{s}.{k}" for s, k in cycle
+            ))
+        active[name] = len(stack)
+        stack.append(name)
+        raw = values[section][key]
+        parts = []
+        i = 0
+        while i < len(raw):
+            if raw[i] != "$":
+                parts.append(raw[i])
+                i += 1
+            elif raw.startswith("$$", i):
+                parts.append("$")
+                i += 2
+            elif raw.startswith("${", i):
+                end = raw.find("}", i + 2)
+                if end == -1:
+                    raise ConfigError("unterminated reference")
+                reference = raw[i + 2:end]
+                if "." in reference:
+                    target_section, _, target_key = reference.rpartition(".")
+                else:
+                    target_section, target_key = section, reference
+                if target_section not in values or target_key not in values[target_section]:
+                    raise ConfigError(f"unknown reference: {reference}")
+                parts.append(resolve(target_section, target_key))
+                i = end + 1
+            else:
+                raise ConfigError("invalid dollar sign")
+        stack.pop()
+        del active[name]
+        resolved[section][key] = "".join(parts)
+        return resolved[section][key]
+
+    for section, key, line in definitions:
+        try:
+            resolve(section, key)
+        except ConfigError as error:
+            error.line = line
+            raise
+    return resolved
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
