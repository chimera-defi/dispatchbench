diff --git a/kvcache/cache.py b/kvcache/cache.py
index be3061f..994d496 100644
--- a/kvcache/cache.py
+++ b/kvcache/cache.py
@@ -19,23 +19,37 @@ class TTLCache:
         self.stats = Stats()
 
     def get(self, key, default=None):
-        if key not in self._data:
+        item = self._data.get(key)
+        if item is None:
             self.stats.misses += 1
             return default
-        value, expires_at = self._data[key]
-        self.stats.hits += 1
-        if self.clock() > expires_at:
+        value, expires_at = item
+        if self.clock() >= expires_at:
             del self._data[key]
             self.stats.expirations += 1
+            self.stats.misses += 1
             return default
+        self.stats.hits += 1
         self._data.move_to_end(key)
         return value
 
     def put(self, key, value) -> None:
-        self._data[key] = (value, self.clock() + self.ttl)
+        now = self.clock()
+        self._data[key] = (value, now + self.ttl)
+        # Overwrite is a use: the key becomes most recently used.
+        self._data.move_to_end(key)
         if len(self._data) > self.capacity:
+            self._drop_expired(now)
+        while len(self._data) > self.capacity:
             self._data.popitem(last=False)
             self.stats.evictions += 1
 
+    def _drop_expired(self, now) -> None:
+        expired = [k for k, (_, expires_at) in self._data.items() if now >= expires_at]
+        for key in expired:
+            del self._data[key]
+            self.stats.expirations += 1
+
     def __len__(self) -> int:
-        return len(self._data)
+        now = self.clock()
+        return sum(1 for _, expires_at in self._data.values() if now < expires_at)
