diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..e898d20
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,72 @@
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+def test_entry_is_gone_at_exact_expiry():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(9)
+    assert cache.get("a") == 1
+    clock.advance(1)
+    assert cache.get("a") is None
+    assert len(cache) == 0
+
+
+def test_put_overwrite_counts_as_use():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.put("a", 3)  # a is now most recently used
+    cache.put("c", 4)  # must evict b, not a
+    assert cache.get("b") is None
+    assert cache.get("a") == 3
+    assert cache.get("c") == 4
+    assert cache.stats.evictions == 1
+
+
+def test_expired_get_is_miss_not_hit():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(10)
+    assert cache.get("a") is None
+    assert cache.stats.hits == 0
+    assert cache.stats.misses == 1
+    assert cache.stats.expirations == 1
+    # a second lookup is a plain miss; the entry is already gone
+    assert cache.get("a") is None
+    assert cache.stats.hits == 0
+    assert cache.stats.misses == 2
+    assert cache.stats.expirations == 1
+
+
+def test_expired_slot_is_reclaimed_before_live_eviction():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(5)
+    cache.put("b", 2)
+    clock.advance(5)  # a expires at t=10; b expires at t=15
+    assert len(cache) == 1
+    cache.put("c", 3)
+    assert cache.stats.evictions == 0
+    assert cache.stats.expirations == 1
+    assert cache.get("a") is None
+    assert cache.get("b") == 2
+    assert cache.get("c") == 3
+    assert len(cache) == 2
+
+
+def test_len_ignores_expired_entries():
+    clock = FakeClock()
+    cache = TTLCache(4, 10, clock)
+    cache.put("a", 1)
+    clock.advance(3)
+    cache.put("b", 2)
+    assert len(cache) == 2
+    clock.advance(7)  # a written at 0 expires at 10; b written at 3 expires at 13
+    assert len(cache) == 1
+    clock.advance(3)
+    assert len(cache) == 0
