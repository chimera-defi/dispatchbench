 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    values, locations = _parse_with_locations(text)
+    resolved: dict[tuple[str, str], str] = {}
+    stack: list[tuple[str, str]] = []
+    active: dict[tuple[str, str], int] = {}
+
+    def resolve(section: str, key: str) -> str:
+        name = (section, key)
+        if name in resolved:
+            return resolved[name]
+        if name in active:
+            cycle = stack[active[name]:] + [name]
+            raise ConfigError("reference cycle: " + " -> ".join(f"{s}.{k}" for s, k in cycle))
+
+        active[name] = len(stack)
+        stack.append(name)
+        raw = values[section][key]
+        parts = []
+        i = 0
+        while i < len(raw):
+            if raw[i] != "$":
+                parts.append(raw[i])
+                i += 1
+            elif raw.startswith("$$", i):
+                parts.append("$")
+                i += 2
+            elif raw.startswith("${", i):
+                end = raw.find("}", i + 2)
+                if end == -1:
+                    raise ConfigError("unterminated reference")
+                reference = raw[i + 2:end]
+                if "." in reference:
+                    target_section, _, target_key = reference.rpartition(".")
+                else:
+                    target_section, target_key = section, reference
+                if target_section not in values or target_key not in values[target_section]:
+                    raise ConfigError(f"unknown reference: {reference}")
+                parts.append(resolve(target_section, target_key))
+                i = end + 1
+            else:
+                raise ConfigError("invalid dollar sign")
+        stack.pop()
+        del active[name]
+        resolved[name] = "".join(parts)
+        return resolved[name]
+
+    for (section, key), line in locations.items():
+        try:
+            resolve(section, key)
+        except ConfigError as error:
+            error.line = line
+            raise
+    return {section: {key: resolved[section, key] for key in entries}
+            for section, entries in values.items()}
 
 
