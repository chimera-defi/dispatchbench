@@ -0,0 +1,60 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_escaping():
+    text = """root = base
+[a.b]
+c = ${.root}/$$/${next}/${next}
+next = ${other.x}
+[other]
+x = end
+"""
+    assert parse(text)["a.b"]["c"] == "${.root}/$$/${next}/${next}"
+    assert load(text)["a.b"]["c"] == "base/$/end/end"
+    assert load("[x]\na = $${missing}\nb = $$${a}\n")["x"]["b"] == "$${missing}"
+
+
+def test_dotted_sections_and_local_references():
+    config = load("[a.b]\nc = ok\n[x]\nc = local\nv = ${a.b.c}:${c}\n")
+    assert config["x"]["v"] == "ok:local"
+
+
+@pytest.mark.parametrize("ref", ["missing", "db.hostt", ".missing", "a.b.c"])
+def test_missing_reference_preserves_name_and_outer_line(ref):
+    with pytest.raises(ConfigError) as error:
+        load(f"[a]\nfirst = ${{second}}\nsecond = ${{{ref}}}\n")
+    assert str(error.value) == f"unknown reference: {ref}"
+    assert error.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "${unfinished"])
+def test_invalid_dollar_and_unterminated_reference(value):
+    with pytest.raises(ConfigError) as error:
+        load(f"outer = ${{inner}}\ninner = {value}\n")
+    assert error.value.line == 1
+
+
+def test_cycle_reports_repeated_key_and_outer_line():
+    with pytest.raises(ConfigError) as error:
+        load("start = ${a.x}\n[a]\nx = ${y}\ny = ${x}\n")
+    assert str(error.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert error.value.line == 1
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as error:
+        load("x = ${y}\ny = ${.x}\n")
+    assert str(error.value) == "reference cycle: .x -> .y -> .x"
+    assert error.value.line == 1
+
+
+def test_first_cycle_uses_file_and_reference_order():
+    text = "[a]\nfirst = ok\n[b]\nx = ${y}${x}\ny = ${x}\n[a]\nlater = ${later}\n"
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == "reference cycle: b.x -> b.y -> b.x"
+    assert error.value.line == 4
