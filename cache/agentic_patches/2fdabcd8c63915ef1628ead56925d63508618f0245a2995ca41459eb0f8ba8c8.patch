diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..03b791c
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,47 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+def test_apply_percent_half_up():
+    assert apply_percent(1005, 10) == 905
+    assert apply_percent(1000, 10) == 900
+    assert apply_percent(1, 50) == 1
+    assert apply_percent(199, 0) == 199
+    assert apply_percent(199, 100) == 0
+
+
+def test_apply_percent_rejects_bad_pct():
+    for pct in (-1, 101, 10.0, True, "10"):
+        with pytest.raises(ValueError):
+            apply_percent(100, pct)
+
+
+def test_add_code_case_and_duplicate():
+    s = Store()
+    s.add_code("Save10", 10)
+    with pytest.raises(ValueError):
+        s.add_code("save10", 10)
+    with pytest.raises(ValueError):
+        s.add_code("nope", 101)
+
+
+def test_total_with_code():
+    s = Store()
+    s.add_item("pen", 1005)
+    s.add_code("SAVE", 10)
+    assert s.total_cents() == 1005
+    assert s.total_cents("save") == 905
+    with pytest.raises(KeyError):
+        s.total_cents("missing")
+
+
+def test_cli_code():
+    s = Store()
+    s.add_item("pen", 1005)
+    s.add_code("SAVE", 10)
+    assert main(["total"], s) == "$10.05"
+    assert main(["total", "--code", "save"], s) == "$9.05"
+    assert main(["total", "--code", "Nope"], s) == "unknown code: Nope"
