 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    config, locations = _parse_with_locations(text)
+    resolved: dict[tuple[str, str], str] = {}
+    stack: list[tuple[str, str]] = []
+    active: dict[tuple[str, str], int] = {}
+
+    def resolve(section: str, key: str) -> str:
+        name = (section, key)
+        if name in resolved:
+            return resolved[name]
+        if name in active:
+            cycle = stack[active[name]:] + [name]
+            chain = " -> ".join(f"{s}.{k}" for s, k in cycle)
+            raise ConfigError(f"reference cycle: {chain}")
+
+        active[name] = len(stack)
+        stack.append(name)
+        try:
+            value = config[section][key]
+            parts: list[str] = []
+            position = 0
+            while position < len(value):
+                dollar = value.find("$", position)
+                if dollar == -1:
+                    parts.append(value[position:])
+                    break
+                parts.append(value[position:dollar])
+                if value.startswith("$$", dollar):
+                    parts.append("$")
+                    position = dollar + 2
+                elif value.startswith("${", dollar):
+                    end = value.find("}", dollar + 2)
+                    if end == -1:
+                        raise ConfigError("unterminated reference")
+                    reference = value[dollar + 2:end]
+                    target_section, dot, target_key = reference.rpartition(".")
+                    if not dot:
+                        target_section = section
+                    if target_section not in config or target_key not in config[target_section]:
+                        raise ConfigError(f"unknown reference: {reference}")
+                    parts.append(resolve(target_section, target_key))
+                    position = end + 1
+                else:
+                    raise ConfigError("invalid dollar in value")
+            resolved[name] = "".join(parts)
+            return resolved[name]
+        finally:
+            stack.pop()
+            del active[name]
+
+    for (section, key), line in locations.items():
+        try:
+            config[section][key] = resolve(section, key)
+        except ConfigError as error:
+            error.line = line
+            raise
+    return config
 
 
