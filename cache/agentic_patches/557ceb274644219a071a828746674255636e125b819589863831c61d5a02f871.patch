diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..1c1ee0c
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,63 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_escapes_and_sections():
+    text = """root = home
+[a.b]
+c = ${.root}/$$${suffix}
+suffix = end
+[a]
+x = ${a.b.c}:${y}:${y}
+y = ok
+"""
+    assert load(text)["a"]["x"] == "home/$end:ok:ok"
+    assert parse(text)["a"]["x"] == "${a.b.c}:${y}:${y}"
+
+
+@pytest.mark.parametrize("reference", ["db.hostt", "missing.key", ".absent", "absent"])
+def test_unknown_reference_reports_original_name_and_outer_line(reference):
+    with pytest.raises(ConfigError, match="unknown reference:") as error:
+        load("[a]\nx = ${y}\ny = ${" + reference + "}\n")
+    assert str(error.value) == f"unknown reference: {reference}"
+    assert error.value.line == 2
+
+
+def test_cycle_reports_first_repeated_key_and_outer_line():
+    text = "[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n"
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert error.value.line == 2
+
+
+def test_file_order_and_reference_order_determine_cycle():
+    text = "[a]\nfirst = ${b.x} ${z}\nz = ${z}\n[b]\nx = ${x}\n"
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == "reference cycle: b.x -> b.x"
+    assert error.value.line == 2
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as error:
+        load("x = ${y}\ny = ${.x}\n")
+    assert str(error.value) == "reference cycle: .x -> .y -> .x"
+    assert error.value.line == 1
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "${unfinished"])
+def test_invalid_syntax_reports_outer_line(value):
+    with pytest.raises(ConfigError) as error:
+        load("first = ${second}\nsecond = " + value + "\n")
+    assert error.value.line == 1
+
+
+def test_revisited_section_preserves_definition_order():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nx = ok\n[b]\ny = ${y}\n[a]\nz = ${z}\n")
+    assert str(error.value) == "reference cycle: b.y -> b.y"
+    assert error.value.line == 4
