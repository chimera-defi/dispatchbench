+def test_same_job_object_is_requeued():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=60)
+    job = q.submit("j", lambda: (_ for _ in ()).throw(RuntimeError("x")))
+    w.run_due()
+    clk.t = job.run_at
+    again = q.pop_due()
+    assert again is job
+    assert again.attempts == 1
