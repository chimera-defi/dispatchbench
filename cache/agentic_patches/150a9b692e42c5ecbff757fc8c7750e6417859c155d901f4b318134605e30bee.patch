+def test_run_due_does_not_run_jobs_that_become_due_mid_call():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=10)
+    log = []
+    calls = {"n": 0}
+
+    def fail_once():
+        calls["n"] += 1
+        clk.t = 50
+        if calls["n"] == 1:
+            q.submit("child", lambda: log.append("child"))
+            raise RuntimeError("x")
+        log.append("fail-ok")
+
+    job = q.submit("fail", fail_once)
+    q.submit("later", lambda: log.append("later"), delay=5)
+
+    assert w.run_due() == 1
+    assert calls["n"] == 1
+    assert log == []
+    assert job.attempts == 1
+    # Counted from t=0, before fn moved the clock. Already due at t=50.
+    assert job.run_at == 2
+    assert len(q) == 3  # retry, later, and the child submitted mid-call
+
+    assert w.run_due() == 3
+    assert log == ["fail-ok", "later", "child"]
+    assert job.attempts == 2
+    assert w.stats() == {"succeeded": 3, "failed_attempts": 1, "dead": 0}
+
