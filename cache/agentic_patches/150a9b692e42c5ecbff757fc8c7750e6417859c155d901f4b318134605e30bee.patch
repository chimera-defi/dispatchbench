+def test_exception_subclass_is_retried_not_propagated():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=2, base_delay=1, max_delay=1)
+
+    class CustomError(Exception):
+        pass
+
+    q.submit("c", lambda: (_ for _ in ()).throw(CustomError("nope")))
+    assert w.run_due() == 1
+    clk.t = 1
+    assert w.run_due() == 1
+    assert w.dead == [("c", 2, repr(CustomError("nope")))]
+
