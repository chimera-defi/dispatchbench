+def test_keyboard_interrupt_propagates_and_is_not_requeued():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=60)
+    log = []
+    err = KeyboardInterrupt("stop")
+
+    def victim():
+        raise err
+
+    job = q.submit("victim", victim)
+    q.submit("other", lambda: log.append("other"))
+    q.submit("third", lambda: log.append("third"))
+    q.submit("later", lambda: log.append("later"), delay=5)
+
+    with pytest.raises(KeyboardInterrupt) as raised:
+        w.run_due()
+    assert raised.value is err
+    assert job.attempts == 1
+    assert w.done == []
+    assert w.dead == []
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+
+    assert w.run_due() == 2
+    assert log == ["other", "third"]
+    clk.t = 5
+    assert w.run_due() == 1
+    assert log == ["other", "third", "later"]
+    assert len(q) == 0
+
