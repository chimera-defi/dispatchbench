index 6f9f569..0537fc4 100644
--- a/jobq/queue.py
+++ b/jobq/queue.py
@@ -17,11 +17,21 @@ class JobQueue:
         heapq.heappush(self._heap, job)
         return job
 
-    def pop_due(self) -> Job | None:
-        """Remove and return the earliest job whose run_at <= now, or None."""
-        if self._heap and self._heap[0].run_at <= self.clock():
+    def pop_due(self, *, now: int | None = None) -> Job | None:
+        """Remove and return the earliest job whose run_at <= now, or None.
+
+        `now` defaults to the current clock. A caller can pass a frozen value
+        to drain only the jobs that were already due at that instant.
+        """
+        if now is None:
+            now = self.clock()
+        if self._heap and self._heap[0].run_at <= now:
             return heapq.heappop(self._heap)
         return None
 
+    def requeue(self, job: Job) -> None:
+        """Put an existing job back. Does not assign a new seq."""
+        heapq.heappush(self._heap, job)
+
     def __len__(self) -> int:
         return len(self._heap)
