+def test_non_exception_base_exception_propagates_without_requeue():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q)
+    log = []
+    q.submit("a", lambda: log.append("a"))
+    q.submit("b", lambda: (_ for _ in ()).throw(Cancel("stop")))
+    q.submit("c", lambda: log.append("c"))
+
+    with pytest.raises(Cancel):
+        w.run_due()
+    assert log == ["a"]
+    assert w.done == ["a"]
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
+    assert w.run_due() == 1
+    assert log == ["a", "c"]
+
