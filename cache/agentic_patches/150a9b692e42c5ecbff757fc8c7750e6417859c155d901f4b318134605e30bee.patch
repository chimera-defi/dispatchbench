diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..b657132
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,364 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0
+
+    def __call__(self):
+        return self.t
+
+
+class Cancel(BaseException):
+    pass
+
+
+def test_defaults_keep_worker_queue_calls_working():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q)
+    assert (w.max_attempts, w.base_delay, w.max_delay) == (3, 2, 60)
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert w.run_due() == 0
+
+    log = []
+    q.submit("a", lambda: log.append("a"))
+    assert w.run_due() == 1
+    assert log == ["a"] and w.done == ["a"]
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": -1},
+        {"base_delay": 0},
+        {"base_delay": -3},
+        {"base_delay": 2, "max_delay": 1},
+        {"max_delay": 0},
+    ],
+)
+def test_rejects_bad_retry_parameters(kwargs):
+    q = JobQueue(Clock())
+    with pytest.raises(ValueError):
+        Worker(q, **kwargs)
+
+
+def test_boundary_parameters_are_accepted():
+    w = Worker(JobQueue(Clock()), max_attempts=1, base_delay=1, max_delay=1)
+    assert (w.max_attempts, w.base_delay, w.max_delay) == (1, 1, 1)
+
+
+def test_exponential_backoff_then_dead_with_last_exception():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=4, base_delay=2, max_delay=60)
+    messages = iter(["one", "two", "three", "four"])
+
+    def fail():
+        raise RuntimeError(next(messages))
+
+    job = q.submit("j", fail)
+    expected = [2, 4, 8]
+    t = 0
+    for attempt, delay in enumerate(expected, start=1):
+        assert w.run_due() == 1
+        assert job.attempts == attempt
+        assert job.seq == 0
+        assert job.run_at == t + delay
+        assert len(q) == 1
+        assert w.dead == []
+        t = job.run_at
+        clk.t = t
+
+    assert w.run_due() == 1
+    assert job.attempts == 4
+    assert w.dead == [("j", 4, repr(RuntimeError("four")))]
+    assert len(q) == 0
+    assert w.done == []
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+    clk.t = 10_000
+    assert w.run_due() == 0
+
+
+def test_default_policy_dies_on_third_failure():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q)
+    job = q.submit("j", lambda: (_ for _ in ()).throw(RuntimeError("nope")))
+
+    assert w.run_due() == 1 and job.run_at == 2 and job.attempts == 1
+    clk.t = 2
+    assert w.run_due() == 1 and job.run_at == 6 and job.attempts == 2
+    clk.t = 6
+    assert w.run_due() == 1
+    assert w.dead == [("j", 3, "RuntimeError('nope')")]
+    assert len(q) == 0
+
+
+def test_max_delay_caps_backoff():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=8, base_delay=3, max_delay=20)
+    job = q.submit("j", lambda: (_ for _ in ()).throw(RuntimeError("x")))
+    t = 0
+    for delay in (3, 6, 12, 20, 20, 20, 20):
+        assert w.run_due() == 1
+        assert job.run_at == t + delay
+        t = job.run_at
+        clk.t = t
+    assert w.run_due() == 1
+    assert len(q) == 0
+    assert w.stats()["dead"] == 1
+    assert w.dead[0][0] == "j" and w.dead[0][1] == 8
+
+
+def test_max_attempts_one_is_immediately_dead():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=1, base_delay=5, max_delay=5)
+    q.submit("once", lambda: (_ for _ in ()).throw(ValueError("boom")))
+    assert w.run_due() == 1
+    assert w.dead == [("once", 1, "ValueError('boom')")]
+    assert len(q) == 0
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 1, "dead": 1}
+
+
+def test_success_after_failures_counts_both():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=5, base_delay=2, max_delay=60)
+    calls = {"n": 0}
+
+    def flaky():
+        calls["n"] += 1
+        if calls["n"] < 3:
+            raise RuntimeError("not yet")
+
+    job = q.submit("flaky", flaky)
+    assert w.run_due() == 1
+    clk.t = job.run_at
+    assert w.run_due() == 1
+    clk.t = job.run_at
+    assert w.run_due() == 1
+    assert w.done == ["flaky"]
+    assert job.attempts == 3
+    assert len(q) == 0
+    assert w.dead == []
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 2, "dead": 0}
+
+
+def test_retry_keeps_original_seq_against_later_and_earlier_jobs():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=60)
+    log = []
+    state = {"failed": False}
+
+    def fail_once():
+        if not state["failed"]:
+            state["failed"] = True
+            raise RuntimeError("x")
+        log.append("retry")
+
+    early = q.submit("early", lambda: log.append("early"), delay=2)
+    job = q.submit("retry", fail_once)
+    later = q.submit("later", lambda: log.append("later"), delay=2)
+    original_seq = job.seq
+
+    assert w.run_due() == 1
+    assert job.seq == original_seq
+    assert job.run_at == 2
+    # Requeue must not consume a submission sequence number.
+    after = q.submit("after", lambda: log.append("after"), delay=2)
+    assert after.seq == later.seq + 1
+    assert [early.seq, job.seq, later.seq, after.seq] == [0, 1, 2, 3]
+
+    clk.t = 2
+    assert w.run_due() == 4
+    assert log == ["early", "retry", "later", "after"]
+
+
+def test_backoff_is_counted_from_the_clock_when_the_attempt_runs():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=60)
+    job = q.submit("late", lambda: (_ for _ in ()).throw(RuntimeError("late")))
+    clk.t = 10  # due since t=0, but the attempt runs now
+    assert w.run_due() == 1
+    assert job.run_at == 12
+
+
+def test_backoff_uses_each_attempt_clock_inside_one_batch():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=60)
+
+    def first():
+        clk.t = 10
+
+    def second():
+        raise RuntimeError("s")
+
+    q.submit("first", first)
+    failed = q.submit("second", second)
+    assert w.run_due() == 2
+    assert failed.attempts == 1
+    # second ran after first moved the clock; delay is not counted from t=0
+    assert failed.run_at == 12
+
