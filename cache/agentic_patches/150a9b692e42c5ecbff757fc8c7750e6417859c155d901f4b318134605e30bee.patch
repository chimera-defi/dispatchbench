+def test_requeued_job_already_due_does_not_rerun_in_the_same_call():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=4, base_delay=1, max_delay=1)
+    calls = {"n": 0}
+
+    def fail():
+        calls["n"] += 1
+        clk.t = 1  # pre-call clock was 0, so run_at becomes 1, which is now
+        raise RuntimeError("again")
+
+    job = q.submit("j", fail)
+    assert w.run_due() == 1
+    assert calls["n"] == 1
+    assert job.attempts == 1
+    assert job.run_at == 1
+    assert clk.t == 1
+    assert len(q) == 1
+
