+def test_dead_jobs_keep_death_order():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=1)
+
+    def boom(name):
+        def fn():
+            raise RuntimeError(name)
+        return fn
+
+    q.submit("a", boom("a"))
+    q.submit("b", boom("b"), delay=1)
+    q.submit("c", boom("c"))
+    assert w.run_due() == 2
+    clk.t = 1
+    assert w.run_due() == 1
+    assert w.dead == [
+        ("a", 1, "RuntimeError('a')"),
+        ("c", 1, "RuntimeError('c')"),
+        ("b", 1, "RuntimeError('b')"),
+    ]
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 3, "dead": 3}
+
