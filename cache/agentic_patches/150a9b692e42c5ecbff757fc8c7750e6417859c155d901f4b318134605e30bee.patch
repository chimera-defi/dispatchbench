+        self.max_attempts = max_attempts
+        self.base_delay = base_delay
+        self.max_delay = max_delay
+        self.done: list[str] = []  # names of jobs that succeeded, in completion order
+        self.dead: list[tuple[str, int, str]] = []  # (name, attempts, repr of last exception)
+        self._succeeded = 0
+        self._failed_attempts = 0
+
+    def stats(self) -> dict[str, int]:
+        return {
+            "succeeded": self._succeeded,
+            "failed_attempts": self._failed_attempts,
+            "dead": len(self.dead),
+        }
 
     def run_due(self) -> int:
-        """Run every job that is due now, earliest first. Returns how many jobs ran."""
+        """Run jobs that were due when this call started.
+
+        Returns how many attempts ran. A job put back during this call is
+        not run again until a later call, even if it is already due again.
+        """
+        # Snapshot first so a retry, or a job submitted by a running job,
+        # cannot run again in this call.
+        now = self.queue.clock()
+        due = []
+        while (job := self.queue.pop_due(now=now)) is not None:
+            due.append(job)
+
         ran = 0
-        while (job := self.queue.pop_due()) is not None:
-            job.fn()
-            self.done.append(job.name)
+        for index, job in enumerate(due):
+            try:
+                self._attempt(job)
+            except BaseException:
+                for pending in due[index + 1:]:
+                    self.queue.requeue(pending)
+                raise
             ran += 1
         return ran
+
+    def _attempt(self, job) -> None:
+        # Backoff is counted from this clock read: when the attempt ran,
+        # before the job body can move the clock.
+        job.attempts += 1
+        attempt_at = self.queue.clock()
+        try:
+            job.fn()
+        except Exception as exc:
+            self._failed_attempts += 1
+            failures = getattr(job, "_failures", 0) + 1
+            job._failures = failures
+            if failures >= self.max_attempts:
+                self.dead.append((job.name, job.attempts, repr(exc)))
+            else:
+                delay = min(self.max_delay, self.base_delay * 2 ** (failures - 1))
+                job.run_at = attempt_at + delay
+                self.queue.requeue(job)
+        else:
+            self._succeeded += 1
+            self.done.append(job.name)
