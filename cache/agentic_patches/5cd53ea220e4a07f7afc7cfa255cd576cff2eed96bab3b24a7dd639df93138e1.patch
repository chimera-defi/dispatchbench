diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..0b805ee
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,49 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_dollars():
+    config = load("root = base\n[a.b]\nx = ${.root}\ny = pre-${x}-${.root}-$$-$${x}\n")
+    assert config["a.b"]["y"] == "pre-base-base-$-${x}"
+    assert load("[x]\na = ${a.b.c}\n[a.b]\nc = yes\n")["x"]["a"] == "yes"
+    assert parse("x = ${missing}")[""]["x"] == "${missing}"
+
+
+def test_nested_references_and_outer_line():
+    with pytest.raises(ConfigError, match=r"unknown reference: db.hostt") as exc:
+        load("[a]\nx = ${y}\ny = ${db.hostt}\n")
+    assert exc.value.line == 2
+    assert load("a = ${b}\nb = ${c}\nc = done")[""]["a"] == "done"
+
+
+def test_cycle_reports_first_repeated_key_and_outer_line():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nz = ${x}\nx = ${y}\ny = ${x}\n")
+    assert str(exc.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert exc.value.line == 2
+
+
+def test_file_order_with_reopened_sections():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nok = yes\n[b]\nx = ${x}\n[a]\nbad = ${bad}\n")
+    assert str(exc.value) == "reference cycle: b.x -> b.x"
+    assert exc.value.line == 4
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "${missing"])
+def test_bad_syntax(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"x = {value}\n")
+    assert exc.value.line == 1
+
+
+def test_missing_reference_and_unnamed_cycle():
+    with pytest.raises(ConfigError, match=r"unknown reference: \.nope") as exc:
+        load("x = ${.nope}")
+    assert exc.value.line == 1
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${y}\ny = ${x}")
+    assert str(exc.value) == "reference cycle: .x -> .y -> .x"
