--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,64 @@
-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse_with_locations
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    raw, locations, order = _parse_with_locations(text)
+    resolved: dict[tuple[str, str], str] = {}
+    stack: list[tuple[str, str]] = []
+    active: dict[tuple[str, str], int] = {}
+
+    def resolve(item: tuple[str, str]) -> str:
+        if item in resolved:
+            return resolved[item]
+        if item in active:
+            cycle = stack[active[item]:] + [item]
+            raise ConfigError("reference cycle: " + " -> ".join(
+                f"{section}.{key}" for section, key in cycle
+            ))
+        active[item] = len(stack)
+        stack.append(item)
+        section, key = item
+        value = raw[section][key]
+        parts: list[str] = []
+        i = 0
+        while i < len(value):
+            if value[i] != "$":
+                parts.append(value[i])
+                i += 1
+            elif value.startswith("$$", i):
+                parts.append("$")
+                i += 2
+            elif value.startswith("${", i):
+                end = value.find("}", i + 2)
+                if end == -1:
+                    raise ConfigError("unterminated reference")
+                name = value[i + 2:end]
+                if "." in name:
+                    target_section, target_key = name.rsplit(".", 1)
+                else:
+                    target_section, target_key = section, name
+                if target_section not in raw or target_key not in raw[target_section]:
+                    raise ConfigError(f"unknown reference: {name}")
+                parts.append(resolve((target_section, target_key)))
+                i = end + 1
+            else:
+                raise ConfigError("invalid dollar sign")
+        stack.pop()
+        del active[item]
+        result = "".join(parts)
+        resolved[item] = result
+        return result
+
+    for item in order:
+        try:
+            resolve(item)
+        except ConfigError as error:
+            error.line = locations[item]
+            raise
+    return {section: {key: resolved[section, key] for key in values}
+            for section, values in raw.items()}
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
