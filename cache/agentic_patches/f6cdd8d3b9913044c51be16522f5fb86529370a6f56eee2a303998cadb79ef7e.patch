diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..58ac4cf
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,59 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_escaping():
+    config = load("""root = base
+[a.b]
+x = ${.root}/${y}/${other.z} $$ $${y}
+y = ${z}
+z = done
+[other]
+z = yes
+""")
+    assert config["a.b"]["x"] == "base/done/yes $ ${y}"
+    assert parse("x = ${missing}")[""]["x"] == "${missing}"
+
+
+def test_last_dot_and_forward_references():
+    config = load("[first]\nx=${a.b.c}\n[a.b]\nc=ok\n")
+    assert config["first"]["x"] == "ok"
+
+
+@pytest.mark.parametrize("reference", ["db.hostt", "missing", ".absent"])
+def test_missing_reference_reports_name_and_outer_line(reference):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[a]\nx = ${{y}}\ny = ${{{reference}}}\n")
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "${unfinished"])
+def test_invalid_dollar_and_unterminated_reference(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"x = ${{y}}\ny = {value}\n")
+    assert exc.value.line == 1
+
+
+def test_cycle_starts_at_repeated_key_and_reports_outer_line():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nstart=${x}\nx=${y}\ny=${x}\n")
+    assert str(exc.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert exc.value.line == 2
+
+
+def test_cycles_follow_file_order_and_references_left_to_right():
+    text = "[a]\nfirst = ok\n[b]\nx = ${z}${y}\nz = ${x}\ny = ${y}\n[a]\nlast = ${last}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == "reference cycle: b.x -> b.z -> b.x"
+    assert exc.value.line == 4
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError, match=r"^reference cycle: \.x -> \.x$") as exc:
+        load("x = ${x}\n")
+    assert exc.value.line == 1
