diff --git a/cfg/loader.py b/cfg/loader.py
index acd880f..18ce159 100644
--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,59 @@
-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse_with_locations
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    config, locations = _parse_with_locations(text)
+    resolved: dict[tuple[str, str], str] = {}
+    stack: list[tuple[str, str]] = []
+
+    def resolve(section: str, key: str) -> str:
+        name = (section, key)
+        if name in resolved:
+            return resolved[name]
+        if name in stack:
+            cycle = stack[stack.index(name):] + [name]
+            raise ConfigError("reference cycle: " + " -> ".join(f"{s}.{k}" for s, k in cycle))
+        stack.append(name)
+        value = config[section][key]
+        parts: list[str] = []
+        i = 0
+        while i < len(value):
+            if value[i] != "$":
+                parts.append(value[i])
+                i += 1
+            elif value.startswith("$$", i):
+                parts.append("$")
+                i += 2
+            elif value.startswith("${", i):
+                end = value.find("}", i + 2)
+                if end == -1:
+                    raise ConfigError("unterminated reference")
+                reference = value[i + 2:end]
+                if "." in reference:
+                    target_section, _, target_key = reference.rpartition(".")
+                else:
+                    target_section, target_key = section, reference
+                if target_section not in config or target_key not in config[target_section]:
+                    raise ConfigError(f"unknown reference: {reference}")
+                parts.append(resolve(target_section, target_key))
+                i = end + 1
+            else:
+                raise ConfigError("invalid dollar sign")
+        stack.pop()
+        resolved[name] = "".join(parts)
+        return resolved[name]
+
+    for section, key, line in locations:
+        try:
+            resolve(section, key)
+        except ConfigError as error:
+            error.line = line
+            raise
+    for (section, key), value in resolved.items():
+        config[section][key] = value
+    return config
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
