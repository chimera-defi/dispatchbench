diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..c7f1c87
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,58 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_escaping():
+    text = """root = base
+[a.b]
+combined = ${later}/${.root}/$$/${other}
+later = ${other}!
+other = value
+[elsewhere]
+result = ${a.b.combined} $${ignored}
+"""
+    assert parse(text)["a.b"]["combined"] == "${later}/${.root}/$$/${other}"
+    config = load(text)
+    assert config["a.b"]["combined"] == "value!/base/$/value"
+    assert config["elsewhere"]["result"] == "value!/base/$/value ${ignored}"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", ".absent", "missing.key"])
+def test_missing_reference_reports_outer_line(reference):
+    text = f"[a]\nouter = ${{inner}}\ninner = ${{{reference}}}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert f"unknown reference: {reference}" in str(exc.value)
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "${unfinished"])
+def test_invalid_syntax_reports_outer_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"outer = ${{inner}}\ninner = {value}\n")
+    assert exc.value.line == 1
+
+
+def test_cycle_chain_and_outer_line():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n")
+    assert str(exc.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert exc.value.line == 2
+
+
+def test_cycle_selection_uses_file_order_and_left_to_right():
+    text = "[a]\nfirst = ok\n[b]\nx = ${y}${x}\ny = ${x}\n[a]\nx = ${x}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == "reference cycle: b.x -> b.y -> b.x"
+    assert exc.value.line == 4
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${x}\n")
+    assert str(exc.value) == "reference cycle: .x -> .x"
+    assert exc.value.line == 1
