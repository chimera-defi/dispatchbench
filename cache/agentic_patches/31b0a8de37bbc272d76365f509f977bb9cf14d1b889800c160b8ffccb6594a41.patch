 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    config, locations, order = _parse_with_locations(text)
+    resolved: dict[tuple[str, str], str] = {}
+    stack: list[tuple[str, str]] = []
+    active: dict[tuple[str, str], int] = {}
+
+    def resolve(name: tuple[str, str]) -> str:
+        if name in resolved:
+            return resolved[name]
+        if name in active:
+            cycle = stack[active[name]:] + [name]
+            raise ConfigError("reference cycle: " + " -> ".join(f"{s}.{k}" for s, k in cycle))
+        active[name] = len(stack)
+        stack.append(name)
+        section, key = name
+        value = config[section][key]
+        parts = []
+        i = 0
+        while i < len(value):
+            if value[i] != "$":
+                parts.append(value[i])
+                i += 1
+            elif value.startswith("$$", i):
+                parts.append("$")
+                i += 2
+            elif value.startswith("${", i):
+                end = value.find("}", i + 2)
+                if end == -1:
+                    raise ConfigError("unterminated reference")
+                ref = value[i + 2:end]
+                if "." in ref:
+                    ref_section, _, ref_key = ref.rpartition(".")
+                else:
+                    ref_section, ref_key = section, ref
+                if ref_section not in config or ref_key not in config[ref_section]:
+                    raise ConfigError(f"unknown reference: {ref}")
+                parts.append(resolve((ref_section, ref_key)))
+                i = end + 1
+            else:
+                raise ConfigError("invalid dollar sign")
+        stack.pop()
+        del active[name]
+        resolved[name] = "".join(parts)
+        return resolved[name]
+
+    for name in order:
+        try:
+            resolve(name)
+        except ConfigError as exc:
+            exc.line = locations[name]
+            raise
+    return {section: {key: resolved[(section, key)] for key in values}
+            for section, values in config.items()}
 
 
