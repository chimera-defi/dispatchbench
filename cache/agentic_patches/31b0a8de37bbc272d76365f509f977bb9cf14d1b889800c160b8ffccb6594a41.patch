diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..0afc35c
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,59 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_escaping():
+    text = """root = world
+[a.b]
+x = ${y}, ${.root}! $$${y} $${y}
+y = ${z}
+z = hello
+[other]
+v = ${a.b.x}
+"""
+    config = load(text)
+    assert config["a.b"]["x"] == "hello, world! $hello ${y}"
+    assert config["other"]["v"] == config["a.b"]["x"]
+    assert parse(text)["a.b"]["y"] == "${z}"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", ".missing"])
+def test_missing_reference_reports_original_name_and_outer_line(reference):
+    text = f"[a]\nfirst = ${{second}}\nsecond = ${{{reference}}}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 2
+
+
+def test_cycle_reports_first_repeated_key_and_outer_line():
+    text = "[a]\nouter = ${x}\nx = ${y}\ny = ${x}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert exc.value.line == 2
+
+
+def test_file_order_and_left_to_right_choose_first_cycle():
+    text = "[a]\nfirst = ${z}${x}\nx = ${x}\nz = ${z}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == "reference cycle: a.z -> a.z"
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "${missing"])
+def test_invalid_dollar_and_unterminated_reference(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[a]\nx = ${{y}}\ny = {value}\n")
+    assert exc.value.line == 2
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${y}\ny = ${.x}\n")
+    assert str(exc.value) == "reference cycle: .x -> .y -> .x"
+    assert exc.value.line == 1
