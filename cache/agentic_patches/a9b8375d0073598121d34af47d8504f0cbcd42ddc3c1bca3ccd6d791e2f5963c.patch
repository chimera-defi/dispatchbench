diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..d5ad214
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,131 @@
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+def test_entry_is_gone_at_exact_expiry():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(9)
+    assert cache.get("a") == 1
+    assert len(cache) == 1
+
+    clock.advance(1)  # t = 10 == write time + ttl
+    assert len(cache) == 0
+    assert cache.get("a", "gone") == "gone"
+    assert cache.stats.hits == 1
+    assert cache.stats.misses == 1
+    assert cache.stats.expirations == 1
+
+
+def test_put_overwrite_counts_as_use():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.put("a", 3)  # overwrite must become most recently used
+    cache.put("c", 4)
+    assert cache.stats.evictions == 1
+    assert cache.stats.expirations == 0
+    assert cache.get("b", "gone") == "gone"
+    assert cache.get("a") == 3
+    assert cache.get("c") == 4
+
+
+def test_expired_get_is_miss_not_hit():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(10)
+    assert cache.get("a", "gone") == "gone"
+    assert cache.stats.hits == 0
+    assert cache.stats.misses == 1
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+
+    # Already dropped: a later lookup is a miss and not a second expiration.
+    assert cache.get("a", "gone") == "gone"
+    assert cache.stats.hits == 0
+    assert cache.stats.misses == 2
+    assert cache.stats.expirations == 1
+
+    # The other expired entry is still a miss plus one expiration.
+    assert cache.get("b", "gone") == "gone"
+    assert cache.stats.hits == 0
+    assert cache.stats.misses == 3
+    assert cache.stats.expirations == 2
+    assert cache.stats.hit_rate() == 0.0
+
+
+def test_len_counts_only_live_entries():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("a", 1)
+    clock.advance(4)
+    cache.put("b", 2)
+    clock.advance(6)  # t = 10; a is due, b expires at 14
+    assert len(cache) == 1
+    assert cache.stats.expirations == 0  # len does not consume entries
+    clock.advance(4)  # t = 14; b is due as well
+    assert len(cache) == 0
+    assert cache.get("a", "gone") == "gone"
+    assert cache.get("b", "gone") == "gone"
+    assert cache.stats.hits == 0
+    assert cache.stats.misses == 2
+    assert cache.stats.expirations == 2
+
+
+def test_expired_slot_is_reclaimed_before_live_eviction():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("expired", 1)  # expires at 10
+    clock.advance(5)
+    cache.put("live", 2)  # expires at 15; expired is least recently used
+    clock.advance(5)  # t = 10
+    assert len(cache) == 1
+
+    cache.put("new", 3)
+    assert cache.stats.evictions == 0
+    assert cache.stats.expirations == 1
+    assert len(cache) == 2
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+    assert cache.get("expired", "gone") == "gone"
+    assert cache.stats.hits == 2
+    assert cache.stats.misses == 1
+    # Dropped while making room, so the later miss is not another expiration.
+    assert cache.stats.expirations == 1
+
+
+def test_expired_mru_does_not_force_out_a_live_lru():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("expired", 1)  # expires at 10
+    clock.advance(5)
+    cache.put("live", 2)  # expires at 15
+    cache.get("expired")  # expired is most recently used; live is least
+    clock.advance(5)  # t = 10; expired is due, live lasts until 15
+    assert len(cache) == 1
+
+    cache.put("new", 3)
+    assert cache.stats.evictions == 0
+    assert cache.stats.expirations == 1
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+    assert cache.get("expired", "gone") == "gone"
+
+
+def test_live_entries_still_evict_when_nothing_is_expired():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.get("a")
+    cache.put("c", 3)
+    assert cache.stats.evictions == 1
+    assert cache.stats.expirations == 0
+    assert len(cache) == 2
+    assert cache.get("b", "gone") == "gone"
+    assert cache.get("a") == 1
+    assert cache.get("c") == 3
