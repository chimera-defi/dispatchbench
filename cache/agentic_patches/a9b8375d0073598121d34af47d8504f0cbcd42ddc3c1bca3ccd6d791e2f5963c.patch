index be3061f..9900df7 100644
--- a/kvcache/cache.py
+++ b/kvcache/cache.py
@@ -19,23 +19,44 @@ class TTLCache:
         self.stats = Stats()
 
     def get(self, key, default=None):
-        if key not in self._data:
+        item = self._data.get(key)
+        if item is None:
             self.stats.misses += 1
             return default
-        value, expires_at = self._data[key]
-        self.stats.hits += 1
-        if self.clock() > expires_at:
+        value, expires_at = item
+        # Written at t with deadline t + ttl: absent from that instant on.
+        if self.clock() >= expires_at:
             del self._data[key]
+            self.stats.misses += 1
             self.stats.expirations += 1
             return default
         self._data.move_to_end(key)
+        self.stats.hits += 1
         return value
 
     def put(self, key, value) -> None:
-        self._data[key] = (value, self.clock() + self.ttl)
-        if len(self._data) > self.capacity:
-            self._data.popitem(last=False)
-            self.stats.evictions += 1
+        now = self.clock()
+        is_new = key not in self._data
+        self._data[key] = (value, now + self.ttl)
+        # A write is a use: the key becomes most recently used, including overwrites.
+        self._data.move_to_end(key)
+        if is_new and len(self._data) > self.capacity:
+            self._reclaim(now)
+
+    def _reclaim(self, now: int) -> None:
+        """Free one slot. An expired entry is dropped before any live entry is evicted."""
+        expired_key = None
+        for key, (_, expires_at) in self._data.items():
+            if now >= expires_at:
+                expired_key = key
+                break
+        if expired_key is not None:
+            del self._data[expired_key]
+            self.stats.expirations += 1
+            return
+        self._data.popitem(last=False)
+        self.stats.evictions += 1
 
     def __len__(self) -> int:
-        return len(self._data)
+        now = self.clock()
+        return sum(expires_at > now for _, expires_at in self._data.values())
