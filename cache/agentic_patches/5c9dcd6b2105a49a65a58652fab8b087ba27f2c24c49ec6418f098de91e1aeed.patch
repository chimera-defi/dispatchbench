diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..97c3bda
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,61 @@
+import pytest
+
+from cfg import parser
+from cfg.errors import ConfigError
+from cfg.loader import load
+
+
+def test_nested_references_sections_and_escapes():
+    config = load('root = base\n[a.b]\nc = ${.root}\nx = pre-${c}-${other.v}-$$-$${c}\n[other]\nv = ${.root}!\n')
+    assert config['a.b']['x'] == 'pre-base-base!-$-${c}'
+    assert load('[x]\na = ${b}\nb = ${c}\nc = done\n')['x']['a'] == 'done'
+    assert load('[x]\na = ${a.b.c}\n[a.b]\nc = ok\n')['x']['a'] == 'ok'
+
+
+@pytest.mark.parametrize('value, message', [
+    ('${db.hostt}', 'unknown reference: db.hostt'),
+    ('${missing}', 'unknown reference: missing'),
+    ('${.missing}', 'unknown reference: .missing'),
+    ('${unfinished', 'unterminated reference'),
+    ('$oops', 'invalid dollar sign'),
+    ('$', 'invalid dollar sign'),
+])
+def test_reference_errors(value, message):
+    with pytest.raises(ConfigError, match=message.replace('.', r'\.')) as error:
+        load('[a]\nx = ' + value)
+    assert error.value.line == 2
+
+
+def test_nested_error_reports_outermost_line():
+    with pytest.raises(ConfigError) as error:
+        load('[a]\nx = ${b}\nb = ${missing}\n')
+    assert error.value.line == 2
+    assert str(error.value) == 'unknown reference: missing'
+
+
+def test_cycle_reports_repeated_chain_and_outermost_line():
+    with pytest.raises(ConfigError) as error:
+        load('[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n')
+    assert str(error.value) == 'reference cycle: a.x -> a.y -> a.x'
+    assert error.value.line == 2
+
+
+def test_unnamed_cycle():
+    with pytest.raises(ConfigError) as error:
+        load('x = ${y}\ny = ${x}\n')
+    assert str(error.value) == 'reference cycle: .x -> .y -> .x'
+    assert error.value.line == 1
+
+
+def test_definition_and_reference_order():
+    with pytest.raises(ConfigError) as error:
+        load('[a]\nok = yes\n[b]\nx = ${missing}\n[a]\ny = ${y}\n')
+    assert str(error.value) == 'unknown reference: missing'
+    assert error.value.line == 4
+    with pytest.raises(ConfigError) as error:
+        load('[a]\nx = ${missing}${x}\n')
+    assert str(error.value) == 'unknown reference: missing'
+
+
+def test_parse_remains_raw():
+    assert parser.parse('x = ${missing}\n') == {'': {'x': '${missing}'}}
