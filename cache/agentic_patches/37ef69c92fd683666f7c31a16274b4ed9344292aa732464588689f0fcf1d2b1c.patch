diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..456858c
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,67 @@
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+def test_expiration_boundary_is_a_miss():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("key", "value")
+    clock.advance(9)
+    assert cache.get("key") == "value"
+    clock.advance(1)
+    assert cache.get("key", "missing") == "missing"
+    assert (cache.stats.hits, cache.stats.misses, cache.stats.expirations) == (1, 1, 1)
+    assert cache.get("key") is None
+    assert (cache.stats.misses, cache.stats.expirations) == (2, 1)
+
+
+def test_overwrite_counts_as_use_and_refreshes_ttl():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("a", 3)
+    cache.put("c", 4)
+    assert cache.get("b") is None
+    clock.advance(5)
+    assert cache.get("a") == 3
+    assert cache.stats.evictions == 1
+
+
+def test_expired_recent_entry_is_removed_before_live_lru_eviction():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("old", 1)
+    clock.advance(5)
+    cache.put("live", 2)
+    assert cache.get("old") == 1  # The expired entry will be most recently used.
+    clock.advance(5)
+    cache.put("new", 3)
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+    assert (cache.stats.evictions, cache.stats.expirations) == (0, 1)
+
+
+def test_len_removes_all_expired_entries_once():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("c", 3)
+    clock.advance(5)
+    assert len(cache) == 1
+    assert len(cache) == 1
+    assert (cache.stats.expirations, cache.stats.evictions) == (2, 0)
+    assert cache.get("c") == 3
+
+
+def test_overwriting_expired_entry_counts_expiration():
+    clock = FakeClock()
+    cache = TTLCache(1, 10, clock)
+    cache.put("a", 1)
+    clock.advance(10)
+    cache.put("a", 2)
+    assert cache.get("a") == 2
+    assert (cache.stats.expirations, cache.stats.evictions) == (1, 0)
