+    def __init__(self, queue: JobQueue, max_attempts: int = 3, base_delay: int = 2, max_delay: int = 60):
+        if max_attempts < 1 or base_delay < 1 or max_delay < base_delay:
+            raise ValueError(
+                "max_attempts must be >= 1, base_delay >= 1, and max_delay >= base_delay"
+            )
         self.queue = queue
+        self.max_attempts = max_attempts
+        self.base_delay = base_delay
+        self.max_delay = max_delay
         self.done: list[str] = []     # names of jobs that succeeded, in completion order
+        self.dead: list[tuple[str, int, str]] = []
+        self._succeeded = 0
+        self._failed_attempts = 0
 
     def run_due(self) -> int:
-        """Run every job that is due now, earliest first. Returns how many jobs ran."""
-        ran = 0
-        while (job := self.queue.pop_due()) is not None:
+        """Run jobs that were due when this call started. Returns how many attempts ran.
+
+        A job requeued during this call is not attempted again until a later call.
+        """
+        now = self.queue.clock()
+        due = self.queue.drain_due(now)
+        for job in due:
+            self._attempt(job)
+        return len(due)
+
+    def stats(self) -> dict[str, int]:
+        return {
+            "succeeded": self._succeeded,
+            "failed_attempts": self._failed_attempts,
+            "dead": len(self.dead),
+        }
+
+    def _attempt(self, job) -> None:
+        when = self.queue.clock()
+        job.attempts += 1
+        try:
             job.fn()
+        except Exception as exc:
+            self._failed_attempts += 1
+            if job.attempts >= self.max_attempts:
+                self.dead.append((job.name, job.attempts, repr(exc)))
+                return
+            delay = min(self.max_delay, self.base_delay * 2 ** (job.attempts - 1))
+            self.queue.reschedule(job, when + delay)
+        else:
+            self._succeeded += 1
             self.done.append(job.name)
-            ran += 1
-        return ran
