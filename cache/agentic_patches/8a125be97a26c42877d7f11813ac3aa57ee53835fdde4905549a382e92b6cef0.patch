diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..2995693
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,172 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0
+
+    def __call__(self):
+        return self.t
+
+
+def test_defaults_match_previous_calls():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q)
+    log = []
+    q.submit("a", lambda: log.append("a"))
+    assert w.run_due() == 1 and log == ["a"] and w.done == ["a"]
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": -1},
+        {"base_delay": 0},
+        {"base_delay": -3},
+        {"base_delay": 10, "max_delay": 9},
+    ],
+)
+def test_rejects_bad_retry_settings(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_backoff_then_dead_letter():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=5)
+
+    def boom():
+        raise RuntimeError("nope")
+
+    q.submit("j", boom)
+    assert w.run_due() == 1
+    job = q._heap[0]
+    assert job.attempts == 1 and job.run_at == 2  # 2 * 2**0
+
+    clk.t = 2
+    assert w.run_due() == 1
+    job = q._heap[0]
+    assert job.attempts == 2 and job.run_at == 2 + 4  # 2 * 2**1, under the cap
+
+    clk.t = 6
+    assert w.run_due() == 1
+    assert len(q) == 0
+    assert w.dead == [("j", 3, repr(RuntimeError("nope")))]
+    assert w.done == []
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 3, "dead": 1}
+
+
+def test_delay_is_capped_at_max_delay():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=4, base_delay=2, max_delay=5)
+    q.submit("j", lambda: (_ for _ in ()).throw(RuntimeError("x")))
+    w.run_due()
+    clk.t = q._heap[0].run_at
+    w.run_due()
+    # third scheduling uses failures=2 -> 2*2**1 = 4; next failure uses 2*2**2 = 8, capped at 5
+    clk.t = q._heap[0].run_at
+    w.run_due()
+    assert q._heap[0].attempts == 3
+    assert q._heap[0].run_at == clk.t + 5
+
+
+def test_success_after_retry_counts_attempts():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=2, max_delay=60)
+    calls = {"n": 0}
+
+    def flaky():
+        calls["n"] += 1
+        if calls["n"] < 2:
+            raise RuntimeError("later")
+        return "ok"
+
+    q.submit("f", flaky)
+    assert w.run_due() == 1
+    clk.t = 2
+    assert w.run_due() == 1
+    assert w.done == ["f"]
+    assert w.dead == []
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 1, "dead": 0}
+
+
+def test_retried_job_keeps_seq_against_later_submissions():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=3, base_delay=5, max_delay=60)
+    log = []
+    state = {"n": 0}
+
+    def a():
+        state["n"] += 1
+        if state["n"] == 1:
+            raise RuntimeError("x")
+        log.append("a")
+
+    q.submit("a", a)
+    q.submit("b", lambda: log.append("b"), delay=5)
+    assert w.run_due() == 1
+    clk.t = 5
+    assert w.run_due() == 2
+    assert log == ["a", "b"]
+    assert w.done == ["a", "b"]
+
+
+def test_run_due_does_not_retry_in_the_same_call():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=5, base_delay=1, max_delay=10)
+    calls = {"a": 0, "b": 0}
+
+    def a():
+        calls["a"] += 1
+        clk.t = -5
+        raise RuntimeError("a")
+
+    def b():
+        calls["b"] += 1
+
+    q.submit("a", a)
+    q.submit("b", b)
+    assert w.run_due() == 2
+    assert calls == {"a": 1, "b": 1}
+    assert len(q) == 1
+    assert q._heap[0].name == "a"
+    # Delay is counted from the clock value when the attempt ran (before fn), not from the clock fn left behind.
+    assert q._heap[0].run_at == 1
+
+
+def test_keyboard_interrupt_propagates_without_requeue():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q)
+
+    def boom():
+        raise KeyboardInterrupt()
+
+    q.submit("k", boom)
+    with pytest.raises(KeyboardInterrupt):
+        w.run_due()
+    assert w.dead == [] and w.done == [] and len(q) == 0
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+
+
+def test_jobs_die_in_order():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=1, base_delay=2, max_delay=60)
+    q.submit("first", lambda: (_ for _ in ()).throw(ValueError("1")))
+    q.submit("second", lambda: (_ for _ in ()).throw(ValueError("2")), delay=0)
+    assert w.run_due() == 2
+    assert [item[0] for item in w.dead] == ["first", "second"]
+    assert w.dead[0][2] == repr(ValueError("1"))
+    assert w.stats()["dead"] == 2
