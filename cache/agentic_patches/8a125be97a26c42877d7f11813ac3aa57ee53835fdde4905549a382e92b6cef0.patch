diff --git a/jobq/queue.py b/jobq/queue.py
index 6f9f569..2a7f52f 100644
--- a/jobq/queue.py
+++ b/jobq/queue.py
@@ -23,5 +23,17 @@ class JobQueue:
             return heapq.heappop(self._heap)
         return None
 
+    def drain_due(self, now: int) -> list[Job]:
+        """Remove every job that was due at `now`, earliest first."""
+        due: list[Job] = []
+        while self._heap and self._heap[0].run_at <= now:
+            due.append(heapq.heappop(self._heap))
+        return due
+
+    def reschedule(self, job: Job, run_at: int) -> None:
+        """Put `job` back, keeping its seq, to run at `run_at`."""
+        job.run_at = run_at
+        heapq.heappush(self._heap, job)
+
     def __len__(self) -> int:
         return len(self._heap)
