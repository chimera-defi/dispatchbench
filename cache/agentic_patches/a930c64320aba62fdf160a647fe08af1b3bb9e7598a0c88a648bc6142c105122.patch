--- a/inv/store.py
+++ b/inv/store.py
@@ -1,9 +1,18 @@
 from .models import Item
+from .money import apply_percent
 
 
 class Store:
     def __init__(self):
         self.items: dict[str, Item] = {}
+        self.codes: dict[str, int] = {}
+
+    def add_code(self, code: str, pct: int) -> None:
+        key = code.casefold()
+        if key in self.codes:
+            raise ValueError(f"code already exists: {code}")
+        apply_percent(0, pct)
+        self.codes[key] = pct
 
     def add_item(self, name: str, price_cents: int, qty: int = 1) -> None:
         if name in self.items:
@@ -14,5 +23,8 @@ class Store:
     def remove_item(self, name: str) -> None:
         del self.items[name]
 
-    def total_cents(self) -> int:
-        return sum(i.line_total() for i in self.items.values())
+    def total_cents(self, code: str | None = None) -> int:
+        total = sum(i.line_total() for i in self.items.values())
+        if code is not None:
+            total = apply_percent(total, self.codes[code.casefold()])
+        return total
