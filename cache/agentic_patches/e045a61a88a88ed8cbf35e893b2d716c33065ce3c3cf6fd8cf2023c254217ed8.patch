diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..080901a
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,142 @@
+import pytest
+
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+@pytest.mark.parametrize("elapsed, live", [(9, True), (10, False), (11, False)])
+def test_get_expiration_boundary_and_stats(elapsed, live):
+    clock = FakeClock(100)
+    cache = TTLCache(2, 10, clock)
+    cache.put("key", "value")
+    clock.advance(elapsed)
+
+    assert cache.get("key", "missing") == ("value" if live else "missing")
+    assert cache.stats.hits == int(live)
+    assert cache.stats.misses == int(not live)
+    assert cache.stats.expirations == int(not live)
+    assert cache.stats.evictions == 0
+
+    if not live:
+        assert cache.get("key", "missing") == "missing"
+        assert cache.stats.hits == 0
+        assert cache.stats.misses == 2
+        assert cache.stats.expirations == 1
+
+
+def test_overwrite_marks_key_as_most_recently_used():
+    cache = TTLCache(2, 10, FakeClock())
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.put("a", 3)
+    cache.put("c", 4)
+
+    assert cache.get("a") == 3
+    assert cache.get("b") is None
+    assert cache.get("c") == 4
+    assert cache.stats.evictions == 1
+    assert cache.stats.expirations == 0
+
+
+def test_overwrite_refreshes_expiration():
+    clock = FakeClock()
+    cache = TTLCache(1, 10, clock)
+    cache.put("key", "old")
+    clock.advance(5)
+    cache.put("key", "new")
+    clock.advance(5)
+
+    assert cache.get("key") == "new"
+    clock.advance(5)
+    assert cache.get("key") is None
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+
+
+@pytest.mark.parametrize("expired_position", [0, 1, 2])
+def test_put_removes_expired_entries_anywhere_in_lru_order(expired_position):
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("expired", 1)
+    clock.advance(5)
+    cache.put("live_a", 2)
+    cache.put("live_b", 3)
+    # Arrange the soon-to-expire key at each possible LRU position.
+    lru_order = ["live_a", "live_b"]
+    lru_order.insert(expired_position, "expired")
+    for key in lru_order:
+        cache.get(key)
+    clock.advance(5)
+    hits_before_put = cache.stats.hits
+
+    cache.put("new", 4)
+
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+    assert cache.stats.hits == hits_before_put
+    assert cache.stats.misses == 0
+    assert len(cache) == 3
+    assert cache.get("live_a") == 2
+    assert cache.get("live_b") == 3
+    assert cache.get("new") == 4
+    assert cache.get("expired") is None
+    assert cache.stats.expirations == 1
+
+
+def test_put_reclaims_multiple_expired_entries():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    for key in ("a", "b", "c"):
+        cache.put(key, key)
+    clock.advance(10)
+
+    cache.put("new", 4)
+
+    assert cache.stats.expirations == 3
+    assert cache.stats.evictions == 0
+    assert cache.stats.hits == cache.stats.misses == 0
+    assert len(cache) == 1
+    assert cache.get("new") == 4
+
+
+def test_put_replaces_expired_key_and_counts_expiration_once():
+    clock = FakeClock()
+    cache = TTLCache(1, 10, clock)
+    cache.put("key", "old")
+    clock.advance(10)
+
+    cache.put("key", "new")
+
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+    assert cache.stats.hits == cache.stats.misses == 0
+    assert len(cache) == 1
+    assert cache.get("key") == "new"
+    assert cache.stats.expirations == 1
+
+
+def test_len_counts_only_live_entries_and_records_expirations_once():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    assert len(cache) == 0
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("c", 3)
+    clock.advance(4)
+    assert len(cache) == 3
+    assert cache.stats.expirations == 0
+
+    clock.advance(1)
+    assert len(cache) == 1
+    assert len(cache) == 1
+    assert cache.stats.expirations == 2
+    assert cache.stats.hits == cache.stats.misses == cache.stats.evictions == 0
+
+    clock.advance(5)
+    assert len(cache) == 0
+    assert len(cache) == 0
+    assert cache.stats.expirations == 3
+    assert cache.get("a") is None
+    assert cache.stats.expirations == 3
+    assert cache.stats.misses == 1
