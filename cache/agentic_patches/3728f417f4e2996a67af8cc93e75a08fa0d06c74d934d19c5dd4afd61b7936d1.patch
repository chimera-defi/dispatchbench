@@ -0,0 +1,59 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_nested_sections_and_literals():
+    text = """root = base
+[a.b]
+c = ${.root}
+[a]
+x = ${y}/${a.b.c}/$$/${y}
+y = ${z}
+z = end
+"""
+    assert load(text)["a"]["x"] == "end/base/$/end"
+    assert parse(text)["a"]["x"] == "${y}/${a.b.c}/$$/${y}"
+
+
+def test_dollars_from_referenced_values_are_not_reparsed():
+    assert load("a = $${missing}\nb = ${a}\n")[""]["b"] == "${missing}"
+
+
+@pytest.mark.parametrize("ref", ["missing", "db.hostt", ".absent"])
+def test_missing_reference_reports_name_and_outer_line(ref):
+    with pytest.raises(ConfigError) as exc:
+        load("first = ${second}\nsecond = ${" + ref + "}\n")
+    assert f"unknown reference: {ref}" in str(exc.value)
+    assert exc.value.line == 1
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "${unfinished"])
+def test_malformed_value_reports_outer_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load("first = ${second}\nsecond = " + value + "\n")
+    assert exc.value.line == 1
+
+
+def test_cycle_reports_repeated_chain_and_outer_line():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n")
+    assert str(exc.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert exc.value.line == 2
+
+
+def test_cycle_order_follows_file_order_and_references_left_to_right():
+    text = "[a]\nfirst = ok\n[b]\nstart = ${right}${left}\n[a]\nleft = ${left}\n[b]\nright = ${right}\nleft = ${left}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == "reference cycle: b.right -> b.right"
+    assert exc.value.line == 4
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${y}\ny = ${x}\n")
+    assert str(exc.value) == "reference cycle: .x -> .y -> .x"
+    assert exc.value.line == 1
