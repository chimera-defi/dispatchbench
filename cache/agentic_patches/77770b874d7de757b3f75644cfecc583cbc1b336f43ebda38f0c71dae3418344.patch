diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..f5f09b6
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,97 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.now = 0
+
+    def __call__(self):
+        return self.now
+
+
+def test_configuration_validation():
+    q = JobQueue(Clock())
+    for kwargs in ({"max_attempts": 0}, {"base_delay": 0},
+                   {"base_delay": 3, "max_delay": 2}):
+        with pytest.raises(ValueError):
+            Worker(q, **kwargs)
+
+
+def test_backoff_dead_and_stats():
+    clock = Clock()
+    q = JobQueue(clock)
+    w = Worker(q, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise ValueError("bad")
+
+    job = q.submit("bad", fail)
+    for now, next_time in [(0, 2), (2, 5), (5, 8), (8, None)]:
+        clock.now = now
+        assert w.run_due() == 1
+        if next_time is not None:
+            assert job.run_at == next_time
+            assert w.run_due() == 0
+    assert job.attempts == 4
+    assert w.dead == [("bad", 4, "ValueError('bad')")]
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 1}
+
+
+def test_retry_preserves_order_and_succeeds():
+    clock = Clock()
+    q = JobQueue(clock)
+    w = Worker(q)
+    calls = []
+
+    def flaky():
+        calls.append("first")
+        if len(calls) == 1:
+            raise RuntimeError()
+
+    job = q.submit("first", flaky)
+    assert w.run_due() == 1
+    q.submit("second", lambda: calls.append("second"), delay=2)
+    clock.now = 2
+    assert w.run_due() == 2
+    assert calls == ["first", "first", "second"]
+    assert job.attempts == 2
+    assert w.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_attempt_time_and_snapshot():
+    clock = Clock()
+    q = JobQueue(clock)
+    w = Worker(q, base_delay=1, max_delay=1)
+    def advance():
+        clock.now = 10
+    def fail():
+        clock.now = 20
+        raise ValueError()
+    q.submit("advance", advance)
+    job = q.submit("fail", fail)
+    assert w.run_due() == 2
+    assert job.run_at == 11
+    assert job.attempts == 1
+    assert w.run_due() == 1
+
+
+def test_base_exception_propagates_and_preserves_other_jobs():
+    clock = Clock()
+    q = JobQueue(clock)
+    w = Worker(q)
+    error = KeyboardInterrupt()
+    def interrupt():
+        raise error
+    job = q.submit("interrupt", interrupt)
+    q.submit("later", lambda: None)
+    with pytest.raises(KeyboardInterrupt) as caught:
+        w.run_due()
+    assert caught.value is error
+    assert job.attempts == 1
+    assert len(q) == 1
+    assert w.run_due() == 1
+    assert w.done == ["later"]
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 0, "dead": 0}
