diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..b8663f4
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,68 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_literal_dollars():
+    config = load("""root = home
+[a.b]
+host = example
+url = $${host}/${host}/${.root}/$$${suffix}
+suffix = ${other}
+other = ok
+""")
+    assert config["a.b"]["url"] == "${host}/example/home/$ok"
+    assert config["a.b"]["suffix"] == "ok"
+
+
+def test_cross_section_last_dot_and_forward_reference():
+    config = load("""[client]
+value = ${a.b.c} ${a.b.c}
+[a.b]
+c = works
+""")
+    assert config["client"]["value"] == "works works"
+
+
+@pytest.mark.parametrize("reference", ["db.hostt", "missing.key", ".absent", "absent"])
+def test_unknown_reference_reports_name_and_outer_line(reference):
+    text = f"[app]\nfirst = ${{second}}\nsecond = ${{{reference}}}\n"
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == f"unknown reference: {reference}"
+    assert error.value.line == 2
+
+
+def test_cycle_reports_repeated_chain_and_outer_line():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nstart = ${x}\nx = ${y}\ny = ${x}\n")
+    assert str(error.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert error.value.line == 2
+
+
+def test_cycle_selection_uses_file_order_and_reference_order():
+    text = "[a]\nfirst = ${b} ${c}\n[a.other]\nx = ${x}\n[a]\nb = ${b}\nc = ${c}\n"
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == "reference cycle: a.b -> a.b"
+    assert error.value.line == 2
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as error:
+        load("x = ${.y}\ny = ${x}\n")
+    assert str(error.value) == "reference cycle: .x -> .y -> .x"
+    assert error.value.line == 1
+
+
+@pytest.mark.parametrize("value", ["$", "before $x", "${unfinished"])
+def test_invalid_syntax_reports_outer_line(value):
+    with pytest.raises(ConfigError) as error:
+        load(f"first = ${{second}}\nsecond = {value}\n")
+    assert error.value.line == 1
+
+
+def test_parse_still_returns_raw_values():
+    assert parse("x = ${missing}\ny = $\n") == {"": {"x": "${missing}", "y": "$"}}
