diff --git a/cfg/loader.py b/cfg/loader.py
index acd880f..c6aef9d 100644
--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,64 @@
-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    config, entries = _parse(text)
+    resolved: dict[tuple[str, str], str] = {}
+    stack: list[tuple[str, str]] = []
+    active: dict[tuple[str, str], int] = {}
+
+    def fail(message: str, line: int) -> None:
+        # Resolution errors carry the outermost line separately from the message.
+        error = ConfigError(message)
+        error.line = line
+        raise error
+
+    def resolve(section: str, key: str, line: int) -> str:
+        name = (section, key)
+        if name in resolved:
+            return resolved[name]
+        if name in active:
+            cycle = stack[active[name]:] + [name]
+            chain = " -> ".join(f"{s}.{k}" for s, k in cycle)
+            fail(f"reference cycle: {chain}", line)
+        active[name] = len(stack)
+        stack.append(name)
+        value = config[section][key]
+        parts: list[str] = []
+        i = 0
+        while i < len(value):
+            if value[i] != "$":
+                parts.append(value[i])
+                i += 1
+            elif value.startswith("$$", i):
+                parts.append("$")
+                i += 2
+            elif value.startswith("${", i):
+                end = value.find("}", i + 2)
+                if end == -1:
+                    fail("unterminated reference", line)
+                reference = value[i + 2:end]
+                if "." in reference:
+                    target_section, _, target_key = reference.rpartition(".")
+                else:
+                    target_section, target_key = section, reference
+                if target_section not in config or target_key not in config[target_section]:
+                    fail(f"unknown reference: {reference}", line)
+                parts.append(resolve(target_section, target_key, line))
+                i = end + 1
+            else:
+                fail("invalid dollar sign", line)
+        stack.pop()
+        del active[name]
+        resolved[name] = "".join(parts)
+        return resolved[name]
+
+    for section, key, line in entries:
+        resolve(section, key, line)
+    return {section: {key: resolved[section, key] for key in values}
+            for section, values in config.items()}
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
