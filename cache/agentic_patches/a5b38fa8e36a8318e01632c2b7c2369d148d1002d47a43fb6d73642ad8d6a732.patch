diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..945c911
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,57 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_references_and_literal_dollars():
+    text = """root = top
+[a.b]
+name = world
+message = Hello ${name}, ${.root}! $$${a.b.name} $${name}
+chain = ${message}
+"""
+    result = load(text)
+    assert result["a.b"]["message"] == "Hello world, top! $world ${name}"
+    assert result["a.b"]["chain"] == result["a.b"]["message"]
+    assert parse(text)["a.b"]["chain"] == "${message}"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", ".absent", "a.b.absent"])
+def test_missing_reference_reports_original_name_and_outer_line(reference):
+    text = f"[s]\nouter = ${{inner}}\ninner = ${{{reference}}}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["${unfinished", "before $x", "end $"])
+def test_malformed_reference_reports_outer_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"first = ${{second}}\nsecond = {value}\n")
+    assert exc.value.line == 1
+
+
+def test_cycle_reports_repeated_part_and_outer_line():
+    text = "[a]\nouter = ${x}\nx = ${y}\ny = ${x}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert exc.value.line == 2
+
+
+def test_cycle_uses_file_order_and_left_to_right_reference_order():
+    text = "[a]\nfirst = ok\n[b]\nx = ${y}${x}\ny = ${x}\n[a]\nlast = ${last}\n"
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == "reference cycle: b.x -> b.y -> b.x"
+    assert exc.value.line == 4
+
+
+def test_unnamed_section_cycle():
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${.y}\ny = ${x}\n")
+    assert str(exc.value) == "reference cycle: .x -> .y -> .x"
+    assert exc.value.line == 1
