+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, now=0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+
+@pytest.mark.parametrize('options', [
+    {'max_attempts': 0}, {'base_delay': 0},
+    {'base_delay': 3, 'max_delay': 2},
+])
+def test_invalid_settings(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_retries_backoff_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise ValueError('bad')
+
+    job = queue.submit('failing', fail)
+    for time, next_time in [(0, 2), (2, 5), (5, 8)]:
+        clock.now = time
+        assert worker.run_due() == 1
+        assert job.run_at == next_time
+        assert worker.run_due() == 0
+    clock.now = 8
+    assert worker.run_due() == 1
+    assert job.attempts == 4
+    assert worker.dead == [('failing', 4, "ValueError('bad')")]
+    assert worker.stats() == {'succeeded': 0, 'failed_attempts': 4, 'dead': 1}
+    assert len(queue) == 0
+
+
+def test_retry_succeeds_and_uses_attempt_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def first():
+        clock.now = 10
+
+    def flaky():
+        calls.append(1)
+        if len(calls) == 1:
+            clock.now = 50
+            raise RuntimeError('temporary')
+
+    queue.submit('first', first)
+    job = queue.submit('flaky', flaky)
+    assert worker.run_due() == 2
+    assert job.run_at == 12
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+    assert worker.done == ['first', 'flaky']
+    assert worker.stats() == {'succeeded': 2, 'failed_attempts': 1, 'dead': 0}
+
+
+def test_retry_preserves_sequence_order():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        log.append('old')
+        if log.count('old') == 1:
+            raise ValueError()
+
+    old = queue.submit('old', flaky)
+    assert worker.run_due() == 1
+    new = queue.submit('new', lambda: log.append('new'), delay=2)
+    assert old.seq < new.seq
+    clock.now = 2
+    assert worker.run_due() == 2
+    assert log == ['old', 'old', 'new']
+
+
+def test_retry_rounded_to_now_waits_for_next_call():
+    clock = Clock(1e20)
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=2)
+    job = queue.submit('job', lambda: (_ for _ in ()).throw(ValueError()))
+    assert worker.run_due() == 1
+    assert job.run_at == clock.now
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+
