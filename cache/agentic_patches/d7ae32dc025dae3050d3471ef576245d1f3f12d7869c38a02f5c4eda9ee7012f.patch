+def test_base_exception_propagates_and_other_due_jobs_remain():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    error = KeyboardInterrupt()
+
+    def interrupt():
+        raise error
+
+    job = queue.submit('interrupt', interrupt)
+    queue.submit('pending', lambda: None)
+    with pytest.raises(KeyboardInterrupt) as caught:
+        worker.run_due()
+    assert caught.value is error
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.stats() == {'succeeded': 0, 'failed_attempts': 0, 'dead': 0}
+    assert worker.run_due() == 1
+    assert worker.done == ['pending']
+
+
+def test_jobs_submitted_during_run_wait_for_next_call():
+    queue = JobQueue(Clock())
+    worker = Worker(queue)
+    queue.submit('first', lambda: queue.submit('later', lambda: None))
+    assert worker.run_due() == 1
+    assert worker.run_due() == 1
