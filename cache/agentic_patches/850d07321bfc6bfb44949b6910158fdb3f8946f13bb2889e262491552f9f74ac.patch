diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..6c9b49f
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,95 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+@pytest.mark.parametrize(
+    "cents,pct,expected",
+    [
+        (1005, 10, 905),
+        (1004, 10, 904),
+        (1006, 10, 905),
+        (1, 50, 1),
+        (1234, 0, 1234),
+        (1234, 100, 0),
+        (0, 50, 0),
+        (-1005, 10, -905),
+        (10**20 + 5, 10, 9 * 10**19 + 5),
+    ],
+)
+def test_apply_percent(cents, pct, expected):
+    assert apply_percent(cents, pct) == expected
+
+
+@pytest.mark.parametrize("pct", [-1, 101, 10.0, "10", None, True, False])
+def test_invalid_percent(pct):
+    with pytest.raises(ValueError):
+        apply_percent(1005, pct)
+    store = Store()
+    with pytest.raises(ValueError):
+        store.add_code("SAVE", pct)
+    store.add_code("SAVE", 10)
+    assert store.total_cents("SAVE") == 0
+
+
+def test_discount_applies_to_whole_total():
+    store = Store()
+    store.add_item("pen", 101, 2)
+    store.add_item("pad", 803)
+    store.add_code("Save10", 10)
+    assert store.total_cents("sAVE10") == 905
+    assert main(["total", "--code", "SAVE10"], store) == "$9.05"
+    assert store.total_cents() == 1005
+    assert store.total_cents(None) == 1005
+    assert main(["total"], store) == "$10.05"
+
+
+def test_discount_rounds_only_after_summing():
+    store = Store()
+    store.add_item("pen", 1)
+    store.add_item("pad", 1)
+    store.add_code("HALF", 50)
+    assert store.total_cents("half") == 1
+
+
+@pytest.mark.parametrize("code", ["Save", "save", "SAVE", "sAvE"])
+def test_duplicate_codes_are_case_insensitive(code):
+    store = Store()
+    store.add_item("pen", 100)
+    store.add_code("Save", 10)
+    with pytest.raises(ValueError):
+        store.add_code(code, 50)
+    assert store.total_cents("SAVE") == 90
+
+
+@pytest.mark.parametrize("pct,expected", [(0, 1005), (100, 0)])
+def test_store_discount_boundaries(pct, expected):
+    store = Store()
+    store.add_item("pad", 1005)
+    store.add_code("BOUNDARY", pct)
+    assert store.total_cents("boundary") == expected
+
+
+@pytest.mark.parametrize("code", ["Missing", "MiSsInG", ""])
+def test_unknown_code(code):
+    store = Store()
+    with pytest.raises(KeyError):
+        store.total_cents(code)
+    assert main(["total", "--code", code], store) == f"unknown code: {code}"
+
+
+def test_codes_belong_to_each_store():
+    first = Store()
+    first.add_code("SAVE", 10)
+    second = Store()
+    with pytest.raises(KeyError):
+        second.total_cents("SAVE")
+
+
+def test_empty_code_can_be_registered():
+    store = Store()
+    store.add_item("pen", 100)
+    store.add_code("", 10)
+    assert store.total_cents("") == 90
