+def test_interrupt_propagates_and_preserves_other_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    interrupt = KeyboardInterrupt()
+
+    def stop():
+        raise interrupt
+
+    job = queue.submit("stop", stop)
+    queue.submit("later", lambda: None)
+    with pytest.raises(KeyboardInterrupt) as caught:
+        worker.run_due()
+    assert caught.value is interrupt
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
