diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..2e7ebd6
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,121 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, t=0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.mark.parametrize("options", [
+    {"max_attempts": 0}, {"base_delay": 0},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_configuration(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_backoff_dead_and_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise ValueError("broken")
+
+    job = queue.submit("bad", fail)
+    queue.submit("good", lambda: None)
+    assert worker.run_due() == 2
+    assert job.attempts == 1 and job.run_at == 2
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 1, "dead": 0}
+    clock.t = 1
+    assert worker.run_due() == 0
+    clock.t = 2
+    assert worker.run_due() == 1 and job.run_at == 5
+    clock.t = 5
+    assert worker.run_due() == 1 and job.run_at == 8
+    clock.t = 8
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 4, "ValueError('broken')")]
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 4, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_retry_succeeds_and_preserves_sequence():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        log.append("first")
+        if len(log) == 1:
+            raise RuntimeError("once")
+
+    job = queue.submit("first", flaky)
+    assert worker.run_due() == 1
+    queue.submit("second", lambda: log.append("second"), delay=2)
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert log == ["first", "first", "second"]
+    assert job.attempts == 2
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_attempt_time_and_snapshot():
+    clock = Clock(10**20)  # Adding a float delay rounds back to the same time.
+    queue = JobQueue(clock)
+    worker = Worker(queue, base_delay=1.0)
+    calls = []
+
+    def fail():
+        calls.append(clock.t)
+        queue.submit("new", lambda: calls.append("new"))
+        raise RuntimeError()
+
+    job = queue.submit("retry", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock.t
+    assert calls == [clock.t]
+    assert worker.run_due() == 2
+
+
+def test_delay_is_measured_at_attempt_not_after_function():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail():
+        clock.t = 100
+        raise RuntimeError()
+
+    job = queue.submit("job", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == 2
+    assert worker.run_due() == 1
+
