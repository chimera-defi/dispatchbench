diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..a28b1b7
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,169 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, now=0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+
+def fail():
+    raise ValueError("broken")
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"max_attempts": 0}, {"max_attempts": -1},
+    {"base_delay": 0}, {"base_delay": -1},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_settings(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_default_retries_and_death():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    job = queue.submit("bad", fail)
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    for attempt, now, next_time in [(1, 0, 2), (2, 2, 6), (3, 6, None)]:
+        clock.now = now
+        assert worker.run_due() == 1
+        assert job.attempts == attempt
+        assert worker.stats()["failed_attempts"] == attempt
+        if next_time is not None:
+            assert job.run_at == next_time
+            clock.now = next_time - 1
+            assert worker.run_due() == 0
+    assert worker.dead == [("bad", 3, "ValueError('broken')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 3, "dead": 1}
+    assert len(queue) == 0
+
+
+def test_success_after_failure():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append(1)
+        if len(calls) == 1:
+            fail()
+
+    job = queue.submit("flaky", flaky)
+    assert worker.run_due() == 1
+    clock.now = 2
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+    assert worker.done == ["flaky"]
+    assert len(queue) == 0
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 1, "dead": 0}
+
+
+def test_delay_cap_and_death_order_with_last_exception():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=5, base_delay=3, max_delay=7)
+    job = queue.submit("first", fail)
+    queue.submit("second", fail)
+    for now, next_time in [(0, 3), (3, 9), (9, 16), (16, 23)]:
+        clock.now = now
+        assert worker.run_due() == 2
+        assert job.run_at == next_time
+    job.fn = lambda: (_ for _ in ()).throw(RuntimeError("last"))
+    clock.now = 23
+    assert worker.run_due() == 2
+    assert worker.dead == [
+        ("first", 5, "RuntimeError('last')"),
+        ("second", 5, "ValueError('broken')"),
+    ]
+
+
+def test_single_attempt_and_success_counts():
+    queue = JobQueue(Clock())
+    worker = Worker(queue, max_attempts=1, base_delay=1, max_delay=1)
+    bad = queue.submit("bad", fail)
+    good = queue.submit("good", lambda: None)
+    assert worker.run_due() == 2
+    assert bad.attempts == good.attempts == 1
+    assert len(queue) == 0
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 1, "dead": 1}
+
+
+@pytest.mark.parametrize("exception", [KeyboardInterrupt(), SystemExit(), BaseException()])
+def test_base_exception_propagates_without_requeue(exception):
+    queue = JobQueue(Clock())
+    worker = Worker(queue)
+
+    def interrupt():
+        raise exception
+
+    job = queue.submit("interrupt", interrupt)
+    other = queue.submit("other", lambda: None)
+    with pytest.raises(type(exception)) as caught:
+        worker.run_due()
+    assert caught.value is exception
+    assert job.attempts == 1
+    assert other.attempts == 0
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert worker.done == ["other"]
+
+
+def test_retry_keeps_sequence_at_equal_due_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    job = queue.submit("first", fail)
+    original_seq = job.seq
+    queue.submit("second", lambda: None, delay=2)
+    assert worker.run_due() == 1
+    assert job.seq == original_seq
+    job.fn = lambda: None
+    clock.now = 2
+    assert worker.run_due() == 2
+    assert worker.done == ["first", "second"]
+
+
+def test_due_snapshot_and_attempt_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def advance():
+        clock.now = 10
+        queue.submit("new", lambda: None)
+
+    def slow_failure():
+        clock.now = 20
+        fail()
+
+    queue.submit("advance", advance)
+    job = queue.submit("bad", slow_failure)
+    queue.submit("future", lambda: None, delay=5)
+    assert worker.run_due() == 2
+    assert job.run_at == 12  # Attempt started at 10, before the callable advanced time.
+    assert job.attempts == 1
+    assert worker.done == ["advance"]
+    assert len(queue) == 3
+
+
+def test_retry_rounding_to_now_waits_for_next_call():
+    clock = Clock(float(2 ** 60))
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock.now
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert job.attempts == 2
