diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..2235f2b
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,92 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+@pytest.mark.parametrize(
+    "cents,pct,expected",
+    [
+        (1005, 10, 905),
+        (1004, 10, 904),
+        (1006, 10, 905),
+        (1, 50, 1),
+        (1234, 0, 1234),
+        (1234, 100, 0),
+        (0, 25, 0),
+        (-1005, 10, -905),
+        (10**20 + 5, 10, 9 * 10**19 + 5),
+    ],
+)
+def test_apply_percent(cents, pct, expected):
+    assert apply_percent(cents, pct) == expected
+
+
+@pytest.mark.parametrize("pct", [-1, 101, 10.0, "10", None, True, False])
+def test_invalid_percent(pct):
+    with pytest.raises(ValueError):
+        apply_percent(1005, pct)
+
+    store = Store()
+    with pytest.raises(ValueError):
+        store.add_code("sale", pct)
+    with pytest.raises(KeyError):
+        store.total_cents("sale")
+
+
+def test_discount_applies_to_whole_total():
+    store = Store()
+    store.add_item("pen", 1, 2)
+    store.add_item("pad", 1)
+    store.add_code("HALF", 50)
+
+    assert store.total_cents("half") == 2
+    assert store.total_cents() == 3
+    assert store.items["pen"].price_cents == 1
+    assert store.items["pen"].qty == 2
+
+
+def test_codes_are_case_insensitive_and_cannot_be_replaced():
+    store = Store()
+    store.add_item("pad", 1005)
+    store.add_code("Sale", 10)
+
+    for code in ["Sale", "sale", "SALE"]:
+        assert store.total_cents(code) == 905
+        with pytest.raises(ValueError):
+            store.add_code(code, 50)
+    assert store.total_cents("sAlE") == 905
+
+
+@pytest.mark.parametrize("pct,expected", [(0, 1005), (100, 0)])
+def test_store_percent_boundaries(pct, expected):
+    store = Store()
+    store.add_item("pad", 1005)
+    store.add_code("sale", pct)
+    assert store.total_cents("sale") == expected
+
+
+def test_unknown_code_including_empty_store():
+    store = Store()
+    with pytest.raises(KeyError):
+        store.total_cents("missing")
+    store.add_code("sale", 10)
+    assert store.total_cents("SALE") == 0
+
+
+def test_codes_belong_to_each_store():
+    store = Store()
+    store.add_code("sale", 10)
+    with pytest.raises(KeyError):
+        Store().total_cents("sale")
+
+
+def test_cli_discount_and_plain_total():
+    store = Store()
+    store.add_item("pad", 1005)
+    store.add_code("sale", 10)
+
+    assert main(["total", "--code", "SaLe"], store) == "$9.05"
+    assert main(["total"], store) == "$10.05"
+    assert main(["total", "--code", "MiSsInG"], store) == "unknown code: MiSsInG"
