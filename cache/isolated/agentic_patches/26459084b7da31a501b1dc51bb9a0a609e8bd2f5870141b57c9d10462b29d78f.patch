+    def requeue(self, job: Job) -> None:
+        """Put an existing job back without changing its insertion sequence."""
+        heapq.heappush(self._heap, job)
+
+    def pop_due(self, now=None) -> Job | None:
+        """Remove the earliest job due by `now` (default: the clock), or None."""
