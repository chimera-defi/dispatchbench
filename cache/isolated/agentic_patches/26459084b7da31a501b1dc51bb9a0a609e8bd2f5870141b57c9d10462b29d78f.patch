+from collections import deque
+
 from .queue import JobQueue
 
 
 class Worker:
-    def __init__(self, queue: JobQueue):
+    def __init__(self, queue: JobQueue, max_attempts=3, base_delay=2, max_delay=60):
+        if max_attempts < 1:
+            raise ValueError("max_attempts must be at least 1")
+        if base_delay < 1:
+            raise ValueError("base_delay must be at least 1")
+        if max_delay < base_delay:
+            raise ValueError("max_delay must be at least base_delay")
         self.queue = queue
+        self.max_attempts = max_attempts
+        self.base_delay = base_delay
+        self.max_delay = max_delay
         self.done: list[str] = []     # names of jobs that succeeded, in completion order
+        self.dead: list[tuple[str, int, str]] = []
+        self._failed_attempts = 0
 
     def run_due(self) -> int:
-        """Run every job that is due now, earliest first. Returns how many jobs ran."""
+        """Run the jobs due at entry once each, returning the number of attempts."""
+        now = self.queue.clock()
+        pending = deque()
+        while (job := self.queue.pop_due(now)) is not None:
+            pending.append(job)
+
         ran = 0
-        while (job := self.queue.pop_due()) is not None:
-            job.fn()
-            self.done.append(job.name)
-            ran += 1
+        try:
+            while pending:
+                job = pending.popleft()
+                attempted_at = self.queue.clock()
+                job.attempts += 1
+                ran += 1
+                try:
+                    job.fn()
+                except Exception as exc:
+                    job.failures += 1
+                    self._failed_attempts += 1
+                    if job.failures >= self.max_attempts:
+                        self.dead.append((job.name, job.attempts, repr(exc)))
+                    else:
+                        delay = min(self.max_delay, self.base_delay * 2 ** (job.failures - 1))
+                        job.run_at = attempted_at + delay
+                        self.queue.requeue(job)
+                else:
+                    self.done.append(job.name)
+        finally:
+            # An interrupt removes only the attempted job, not the remaining work.
+            for job in pending:
+                self.queue.requeue(job)
         return ran
+
+    def stats(self) -> dict[str, int]:
+        return {
+            "succeeded": len(self.done),
+            "failed_attempts": self._failed_attempts,
+            "dead": len(self.dead),
+        }
diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..6050533
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,189 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, t=0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+def fail():
+    raise ValueError("oops")
+
+
+@pytest.mark.parametrize("options", [
+    {"max_attempts": 0}, {"max_attempts": -1},
+    {"base_delay": 0}, {"base_delay": -1},
+    {"max_delay": 1}, {"base_delay": 5, "max_delay": 4},
+])
+def test_invalid_options(options):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **options)
+
+
+def test_default_retries_and_death():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    job = queue.submit("bad", fail)
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    for attempt, now, next_time in [(1, 0, 2), (2, 2, 6), (3, 6, None)]:
+        clock.t = now
+        assert worker.run_due() == 1
+        assert job.attempts == attempt
+        if next_time is not None:
+            assert job.run_at == next_time
+            clock.t = next_time - 1
+            assert worker.run_due() == 0
+    assert len(queue) == 0
+    assert worker.dead == [("bad", 3, "ValueError('oops')")]
+    assert worker.done == []
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 3, "dead": 1}
+
+
+def test_success_after_failure_and_other_jobs_continue():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append(clock.t)
+        if len(calls) == 1:
+            fail()
+
+    job = queue.submit("flaky", flaky)
+    good = queue.submit("good", lambda: None)
+    assert worker.run_due() == 2
+    assert good.attempts == 1
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+    assert calls == [0, 2]
+    assert worker.done == ["good", "flaky"]
+    assert worker.dead == []
+    assert worker.stats() == {"succeeded": 2, "failed_attempts": 1, "dead": 0}
+
+
+def test_capped_backoff():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=5, base_delay=3, max_delay=7)
+    job = queue.submit("bad", fail)
+    for now, next_time in [(0, 3), (3, 9), (9, 16), (16, 23)]:
+        clock.t = now
+        assert worker.run_due() == 1
+        assert job.run_at == next_time
+    clock.t = 23
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 5, "ValueError('oops')")]
+
+
+def test_dead_order_and_last_exception():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=2, base_delay=1, max_delay=1)
+    messages = iter(["first", "last"])
+
+    def changing_error():
+        raise RuntimeError(next(messages))
+
+    queue.submit("later", fail, delay=2)
+    queue.submit("earlier", changing_error)
+    for now in range(4):
+        clock.t = now
+        assert worker.run_due() == 1
+    assert worker.dead == [
+        ("earlier", 2, "RuntimeError('last')"),
+        ("later", 2, "ValueError('oops')"),
+    ]
+
+
+def test_one_attempt_limit():
+    queue = JobQueue(Clock())
+    worker = Worker(queue, max_attempts=1)
+    queue.submit("bad", fail)
+    assert worker.run_due() == 1
+    assert len(queue) == 0
+    assert worker.dead == [("bad", 1, "ValueError('oops')")]
+
+
+@pytest.mark.parametrize("error", [KeyboardInterrupt(), SystemExit(), BaseException()])
+def test_base_exception_propagates_without_requeue(error):
+    queue = JobQueue(Clock())
+    worker = Worker(queue)
+
+    def interrupt():
+        raise error
+
+    job = queue.submit("interrupt", interrupt)
+    remaining = queue.submit("remaining", lambda: None)
+    with pytest.raises(type(error)) as caught:
+        worker.run_due()
+    assert caught.value is error
+    assert job.attempts == 1
+    assert remaining.attempts == 0
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert worker.done == ["remaining"]
+
+
+def test_retry_preserves_original_sequence():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        log.append("first")
+        if len(log) == 1:
+            fail()
+
+    job = queue.submit("first", flaky)
+    original_seq = job.seq
+    queue.submit("second", lambda: log.append("second"), delay=2)
+    assert worker.run_due() == 1
+    assert job.seq == original_seq
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert log == ["first", "first", "second"]
+
+
+def test_snapshot_and_delay_use_attempt_start_time():
+    clock = Clock(10)
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def slow_failure():
+        clock.t += 10
+        queue.submit("new", lambda: None)
+        fail()
+
+    bad = queue.submit("bad", slow_failure)
+    good = queue.submit("already_due", lambda: None)
+    future = queue.submit("future", lambda: None, delay=5)
+    assert worker.run_due() == 2
+    assert bad.attempts == good.attempts == 1
+    assert bad.run_at == 12
+    assert future.attempts == 0
+    assert len(queue) == 3
+    assert worker.done == ["already_due"]
+
+
+def test_retry_not_repeated_when_delay_rounds_to_now():
+    clock = Clock(float(2 ** 60))
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock.t
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert job.attempts == 2
