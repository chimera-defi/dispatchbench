diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..f46927e
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,196 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, t=0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+def fail():
+    raise ValueError("failed")
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"max_attempts": 0},
+    {"max_attempts": -1},
+    {"base_delay": 0},
+    {"base_delay": -1},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_configuration(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_defaults_retry_then_succeed():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append(clock())
+        if len(calls) < 3:
+            fail()
+
+    job = queue.submit("flaky", flaky)
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert job.attempts == 1 and job.run_at == 2
+    clock.t = 1
+    assert worker.run_due() == 0
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert job.attempts == 2 and job.run_at == 6
+    clock.t = 6
+    assert worker.run_due() == 1
+    assert job.attempts == 3
+    assert calls == [0, 2, 6]
+    assert worker.done == ["flaky"]
+    assert worker.dead == [] and len(queue) == 0
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 2, "dead": 0}
+
+
+def test_backoff_cap_and_dead_order():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=5, base_delay=3, max_delay=7)
+    first = queue.submit("first", fail)
+    second = queue.submit("second", fail)
+    for now, next_time in [(0, 3), (3, 9), (9, 16), (16, 23)]:
+        clock.t = now
+        assert worker.run_due() == 2
+        assert first.run_at == second.run_at == next_time
+    clock.t = 23
+    assert worker.run_due() == 2
+    assert worker.dead == [
+        ("first", 5, "ValueError('failed')"),
+        ("second", 5, "ValueError('failed')"),
+    ]
+    assert worker.done == [] and len(queue) == 0
+    assert worker.run_due() == 0
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 10, "dead": 2}
+
+
+def test_one_attempt_and_last_exception():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=1)
+    job = queue.submit("once", fail)
+    assert worker.run_due() == 1
+    assert job.attempts == 1
+    assert worker.dead == [("once", 1, "ValueError('failed')")]
+
+    worker = Worker(queue, max_attempts=2)
+    errors = iter([ValueError("first"), RuntimeError("last")])
+
+    def changing_error():
+        raise next(errors)
+
+    queue.submit("changing", changing_error)
+    assert worker.run_due() == 1
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert worker.dead == [("changing", 2, "RuntimeError('last')")]
+
+
+@pytest.mark.parametrize("error", [KeyboardInterrupt(), SystemExit(), BaseException()])
+def test_base_exception_propagates_without_requeue(error):
+    queue = JobQueue(Clock())
+    worker = Worker(queue)
+
+    def interrupt():
+        raise error
+
+    job = queue.submit("interrupt", interrupt)
+    later = queue.submit("later", lambda: None)
+    with pytest.raises(type(error)) as caught:
+        worker.run_due()
+    assert caught.value is error
+    assert job.attempts == 1 and later.attempts == 0
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert worker.done == ["later"]
+
+
+def test_retry_preserves_sequence_against_later_submissions():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    job = queue.submit("original", fail)
+    seq = job.seq
+    queue.submit("later", lambda: None, delay=2)
+    assert worker.run_due() == 1
+    job.fn = lambda: None
+    assert job.seq == seq
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert worker.done == ["original", "later"]
+
+
+def test_retry_delay_uses_time_before_attempt():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def slow_failure():
+        clock.t += 10
+        fail()
+
+    queue.submit("advance", lambda: setattr(clock, "t", 5))
+    job = queue.submit("slow", slow_failure)
+    assert worker.run_due() == 2
+    assert clock.t == 15
+    assert job.run_at == 7 and job.attempts == 1
+    assert worker.run_due() == 1
+    assert job.run_at == 19 and job.attempts == 2
+
+
+def test_due_snapshot_excludes_future_and_new_jobs():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def submit_and_advance():
+        queue.submit("new", lambda: None)
+        clock.t = 10
+
+    queue.submit("initial", submit_and_advance)
+    future = queue.submit("future", lambda: None, delay=5)
+    assert worker.run_due() == 1
+    assert worker.done == ["initial"] and future.attempts == 0
+    assert worker.run_due() == 2
+    assert worker.done == ["initial", "new", "future"]
+
+
+def test_retry_is_not_repeated_when_delay_rounds_to_now():
+    clock = Clock(1e20)
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    job = queue.submit("rounded", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock() and job.attempts == 1
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+
+
+def test_jobs_with_same_name_have_independent_attempts():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=2)
+    failed = queue.submit("same", fail)
+    succeeded = queue.submit("same", lambda: None)
+    assert worker.run_due() == 2
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert failed.attempts == 2 and succeeded.attempts == 1
+    assert worker.done == ["same"]
+    assert worker.dead == [("same", 2, "ValueError('failed')")]
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 2, "dead": 1}
