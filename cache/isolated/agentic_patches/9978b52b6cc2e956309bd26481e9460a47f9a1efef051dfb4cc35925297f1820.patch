-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    raw, lines = _parse(text)
+    resolved: dict[tuple[str, str], str] = {}
+    stack: list[tuple[str, str]] = []
+    active: dict[tuple[str, str], int] = {}
+
+    def resolve(section: str, key: str) -> str:
+        name = (section, key)
+        if name in resolved:
+            return resolved[name]
+        if name in active:
+            cycle = stack[active[name]:] + [name]
+            chain = " -> ".join(f"{s}.{k}" for s, k in cycle)
+            raise ConfigError(f"reference cycle: {chain}")
+
+        active[name] = len(stack)
+        stack.append(name)
+        value = raw[section][key]
+        parts: list[str] = []
+        pos = 0
+        while pos < len(value):
+            dollar = value.find("$", pos)
+            if dollar < 0:
+                parts.append(value[pos:])
+                break
+            parts.append(value[pos:dollar])
+            if value.startswith("$$", dollar):
+                parts.append("$")
+                pos = dollar + 2
+            elif value.startswith("${", dollar):
+                end = value.find("}", dollar + 2)
+                if end < 0:
+                    raise ConfigError("unterminated reference")
+                reference = value[dollar + 2:end]
+                target_section, dot, target_key = reference.rpartition(".")
+                if not dot:
+                    target_section = section
+                if target_section not in raw or target_key not in raw[target_section]:
+                    raise ConfigError(f"unknown reference: {reference}")
+                parts.append(resolve(target_section, target_key))
+                pos = end + 1
+            else:
+                raise ConfigError("invalid '$' in value")
+
+        stack.pop()
+        del active[name]
+        resolved[name] = "".join(parts)
+        return resolved[name]
+
+    for (section, key), line in lines.items():
+        try:
+            resolve(section, key)
+        except ConfigError as error:
+            # Keep the resolution message exact while attributing it to the root.
+            error.line = line
+            raise
+
+    return {
+        section: {key: resolved[section, key] for key in values}
+        for section, values in raw.items()
+    }
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
