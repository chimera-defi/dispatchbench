diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..f2d7b85
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,124 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_same_section_forward_and_nested_references():
+    config = load("[app]\na = pre-${b}/${c}-${b}-post\nb = ${c}\nc = value\n")
+    assert config["app"] == {
+        "a": "pre-value/value-value-post",
+        "b": "value",
+        "c": "value",
+    }
+
+
+def test_cross_section_dotted_sections_and_unnamed_section():
+    config = load(
+        "key = global\ncopy = ${key}\n"
+        "[a]\nkey = local\nvalue = ${key}/${.key}/${a.b.c}\n"
+        "[a.b]\nc = ${db.host}\n[db]\nhost = localhost\n"
+    )
+    assert config[""]["copy"] == "global"
+    assert config["a"]["value"] == "local/global/localhost"
+    assert config["a.b"]["c"] == "localhost"
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        ("", ""),
+        ("plain text", "plain text"),
+        ("$$", "$"),
+        ("$$$$", "$$"),
+        ("cost: $$5", "cost: $5"),
+        ("$${missing}", "${missing}"),
+        ("$$${key}", "$value"),
+        ("${key}$$${key}", "value$value"),
+    ],
+)
+def test_literals_and_escapes(value, expected):
+    assert load(f"key = value\nresult = {value}\n")[""]["result"] == expected
+
+
+def test_inserted_values_are_not_rescanned():
+    config = load("result = ${literal}\nliteral = $${missing} $$\n")
+    assert config[""]["result"] == "${missing} $"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", "absent.host", ".missing", "a.b.c", " key "])
+def test_unknown_reference_keeps_exact_name(reference):
+    with pytest.raises(ConfigError) as error:
+        load(f"[app]\nresult = ${{{reference}}}\n[db]\nhost = localhost\n")
+    assert str(error.value) == f"unknown reference: {reference}"
+    assert error.value.line == 2
+
+
+def test_unqualified_reference_does_not_fall_back_to_unnamed_section():
+    with pytest.raises(ConfigError, match="unknown reference: key") as error:
+        load("key = global\n[app]\nresult = ${key}\n")
+    assert error.value.line == 3
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "text $ text", "$$$", "${", "prefix ${key"])
+def test_invalid_dollar_and_unterminated_reference(value):
+    with pytest.raises(ConfigError) as error:
+        load(f"# comment\n\n[app]\nresult = {value}\n")
+    assert error.value.line == 4
+
+
+@pytest.mark.parametrize("invalid", ["${missing}", "$oops", "${unfinished"])
+def test_nested_errors_report_outermost_definition_line(invalid):
+    with pytest.raises(ConfigError) as error:
+        load(f"# comment\n[app]\n\nroot = ${{middle}}\nmiddle = ${{leaf}}\nleaf = {invalid}\n")
+    assert error.value.line == 4
+
+
+@pytest.mark.parametrize(
+    ("text", "chain", "line"),
+    [
+        ("x = ${x}\n", ".x -> .x", 1),
+        ("[a]\nx = ${y}\ny = ${x}\n", "a.x -> a.y -> a.x", 2),
+        (
+            "root = ${a.x}\n[a]\nx = ${b.y}\n[b]\ny = ${a.x}\n",
+            "a.x -> b.y -> a.x",
+            1,
+        ),
+        ("x = ${a.y}\n[a]\ny = ${.x}\n", ".x -> a.y -> .x", 1),
+    ],
+)
+def test_cycles_report_exact_chain_and_outermost_line(text, chain, line):
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == f"reference cycle: {chain}"
+    assert error.value.line == line
+
+
+def test_values_are_resolved_in_file_order_across_reopened_sections():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nfirst = ok\n[b]\nx = ${x}\n[a]\ny = ${y}\n")
+    assert str(error.value) == "reference cycle: b.x -> b.x"
+    assert error.value.line == 4
+
+
+def test_references_are_resolved_left_to_right():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nroot = ${z} ${y}\ny = ${y}\nz = ${z}\n")
+    assert str(error.value) == "reference cycle: a.z -> a.z"
+    assert error.value.line == 2
+
+
+def test_parser_still_returns_raw_values():
+    assert parse("x = ${missing} $$\n") == {"": {"x": "${missing} $$"}}
+
+
+def test_parsing_finishes_before_resolution():
+    with pytest.raises(ConfigError) as error:
+        load("x = ${missing}\nx = duplicate\n")
+    assert str(error.value) == "line 2: duplicate key 'x'"
+    assert error.value.line == 2
+
+
+def test_empty_and_unused_sections_are_preserved():
+    assert load("[empty]\n") == {"": {}, "empty": {}}
