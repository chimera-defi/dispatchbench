diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..e88f43e
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,86 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_nested_references_and_plain_text():
+    config = load("[app]\na = before ${b}/${c}/${b} after\nb = ${c}\nc = done")
+    assert config["app"] == {
+        "a": "before done/done/done after", "b": "done", "c": "done"
+    }
+
+
+def test_section_names_use_last_dot_and_unnamed_section():
+    config = load(
+        "root = home\nalias = ${root}\n[app]\n"
+        "path = ${.alias}/${a.b.c}/${db.host}\n"
+        "[a.b]\nc = data\n[db]\nhost = localhost"
+    )
+    assert config["app"]["path"] == "home/data/localhost"
+
+
+@pytest.mark.parametrize("raw, expected", [
+    ("", ""), ("plain", "plain"), ("$$", "$"),
+    ("$$$$", "$$"), ("$${missing}", "${missing}"),
+    ("$$${target}$$", "$ok$"),
+])
+def test_literal_dollars(raw, expected):
+    config = load(f"value = {raw}\ncopy = ${{value}}\ntarget = ok")
+    assert config[""]["value"] == expected
+    assert config[""]["copy"] == expected
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", "absent.key", ".nope", "a.b.c", ""])
+def test_unknown_reference_preserves_name(reference):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[app]\nouter = ${{inner}}\ninner = ${{{reference}}}\n[db]\nhost = ok")
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$word", "end$", "${", "${missing", "$$$"])
+def test_invalid_dollar_or_unterminated_reference(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"# header\nouter = ${{inner}}\ninner = {value}")
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("text, chain, line", [
+    ("[a]\nx = ${y}\ny = ${x}", "a.x -> a.y -> a.x", 2),
+    ("x = ${x}", ".x -> .x", 1),
+    ("outer = ${a.x}\n[a]\nx = ${y}\ny = ${x}", "a.x -> a.y -> a.x", 1),
+    ("x = ${a.y}\n[a]\ny = ${.x}", ".x -> a.y -> .x", 1),
+    ("[a.b]\nx = ${x}", "a.b.x -> a.b.x", 2),
+])
+def test_cycle_chain_and_outermost_line(text, chain, line):
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == f"reference cycle: {chain}"
+    assert exc.value.line == line
+
+
+def test_references_are_visited_left_to_right():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nouter = ${right}${left}\nleft = ${left}\nright = ${right}")
+    assert str(exc.value) == "reference cycle: a.right -> a.right"
+    assert exc.value.line == 2
+
+
+def test_reopened_sections_preserve_file_resolution_order():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nok = fine\n[b]\nx = ${x}\n[a]\ny = ${y}")
+    assert str(exc.value) == "reference cycle: b.x -> b.x"
+    assert exc.value.line == 4
+
+
+def test_parsing_finishes_before_resolution():
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${missing}\nx = duplicate")
+    assert str(exc.value) == "line 2: duplicate key 'x'"
+    assert exc.value.line == 2
+
+
+def test_parse_still_returns_raw_values():
+    assert parse("x = ${missing}\ny = $") == {"": {"x": "${missing}", "y": "$"}}
