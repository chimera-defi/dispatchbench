diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..315d5f0
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,88 @@
+import pytest
+
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+from kvcache.stats import Stats
+
+
+@pytest.mark.parametrize("elapsed", [10, 11])
+def test_expired_get_counts_as_miss(elapsed):
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(9)
+    assert cache.get("a") == 1
+    clock.advance(elapsed - 9)
+
+    assert cache.get("a", "missing") == "missing"
+    assert cache.stats == Stats(hits=1, misses=1, expirations=1)
+    assert cache.get("a") is None
+    assert cache.stats == Stats(hits=1, misses=2, expirations=1)
+
+
+def test_overwrite_updates_recency_and_ttl():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("a", 3)
+    cache.put("c", 4)
+
+    assert cache.get("b") is None
+    clock.advance(5)
+    assert cache.get("a") == 3
+    assert cache.get("c") == 4
+    assert cache.stats == Stats(hits=2, misses=1, evictions=1)
+
+
+@pytest.mark.parametrize("expired_is_mru", [False, True])
+def test_put_removes_expired_entries_before_evicting(expired_is_mru):
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("expired", 1)
+    clock.advance(5)
+    cache.put("live", 2)
+    if expired_is_mru:
+        assert cache.get("expired") == 1
+    clock.advance(5)
+
+    cache.put("new", 3)
+
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+    assert len(cache) == 2
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+
+
+def test_len_counts_only_live_entries_and_expires_each_once():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("c", 3)
+    assert cache.get("a") == 1
+    clock.advance(5)
+
+    assert len(cache) == 1
+    assert len(cache) == 1
+    assert cache.stats == Stats(hits=1, expirations=2)
+    clock.advance(5)
+    assert len(cache) == 0
+    assert len(cache) == 0
+    assert cache.stats == Stats(hits=1, expirations=3)
+
+
+def test_put_over_expired_key_records_expiration():
+    clock = FakeClock()
+    cache = TTLCache(1, 10, clock)
+    cache.put("a", 1)
+    clock.advance(10)
+
+    cache.put("a", 2)
+
+    assert cache.stats == Stats(expirations=1)
+    assert len(cache) == 1
+    assert cache.get("a") == 2
