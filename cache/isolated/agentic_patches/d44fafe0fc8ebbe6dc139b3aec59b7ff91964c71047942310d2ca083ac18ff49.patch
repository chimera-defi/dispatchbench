@@ -0,0 +1,147 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_local_references_and_forward_chains():
+    config = load(
+        "[app]\n"
+        "url = https://${host}:${port}/${path}?host=${host}\n"
+        "host = ${hostname}\n"
+        "hostname = localhost\n"
+        "port = 8080\n"
+        "path = api\n"
+    )
+    assert config["app"]["url"] == "https://localhost:8080/api?host=localhost"
+    assert config["app"]["host"] == "localhost"
+
+
+def test_qualified_dotted_and_unnamed_sections():
+    config = load(
+        "root = base\n"
+        "alias = ${root}\n"
+        "[app]\n"
+        "value = ${a.b.c}/${.alias}/${db.host}\n"
+        "[a.b]\n"
+        "c = ${.root}\n"
+        "[db]\n"
+        "host = localhost\n"
+    )
+    assert config["app"]["value"] == "base/base/localhost"
+
+
+def test_nested_local_references_use_the_target_section():
+    config = load(
+        "host = global\n"
+        "[app]\n"
+        "host = app-host\n"
+        "url = ${db.url}/${host}\n"
+        "[db]\n"
+        "url = ${host}\n"
+        "host = db-host\n"
+    )
+    assert config["app"]["url"] == "db-host/app-host"
+
+
+def test_local_references_do_not_fall_back_to_unnamed_section():
+    with pytest.raises(ConfigError, match="unknown reference: host") as caught:
+        load("host = global\n[app]\nurl = ${host}\n")
+    assert caught.value.line == 3
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("", ""),
+        ("$$", "$"),
+        ("$$$$", "$$"),
+        ("price: $$5", "price: $5"),
+        ("$${missing}", "${missing}"),
+        ("$$${key}$$", "$value$"),
+        ("${empty}text${empty}", "text"),
+    ],
+)
+def test_literal_dollars_and_empty_values(raw, expected):
+    config = load(f"result = {raw}\nkey = value\nempty =\n")
+    assert config[""]["result"] == expected
+
+
+def test_substituted_values_are_not_scanned_again():
+    config = load("result = ${literal}${dollar}\nliteral = $${missing}\ndollar = $$\n")
+    assert config[""]["result"] == "${missing}$"
+
+
+@pytest.mark.parametrize("reference", ["hostt", "db.hostt", "missing.host", "a.b.c", ".missing", ""])
+def test_unknown_reference_preserves_written_name(reference):
+    with pytest.raises(ConfigError) as caught:
+        load(f"[app]\nvalue = ${{{reference}}}\n[db]\nhost = localhost\n")
+    assert str(caught.value) == f"unknown reference: {reference}"
+    assert caught.value.line == 2
+
+
+@pytest.mark.parametrize("raw", ["$", "$x", "prefix $ suffix", "$$$", "${key}$"])
+def test_invalid_dollar(raw):
+    with pytest.raises(ConfigError) as caught:
+        load(f"[app]\nvalue = {raw}\nkey = ok\n")
+    assert caught.value.line == 2
+
+
+@pytest.mark.parametrize("raw", ["${", "text ${key", "${key}${unfinished"])
+def test_unterminated_reference(raw):
+    with pytest.raises(ConfigError, match="unterminated") as caught:
+        load(f"[app]\nvalue = {raw}\nkey = ok\n")
+    assert caught.value.line == 2
+
+
+@pytest.mark.parametrize(
+    ("text", "chain", "line"),
+    [
+        ("[a]\nx = ${x}\n", "a.x -> a.x", 2),
+        ("[a]\nx = ${y}\ny = ${x}\n", "a.x -> a.y -> a.x", 2),
+        ("x = ${a.y}\n[a]\ny = ${.x}\n", ".x -> a.y -> .x", 1),
+        (
+            "[a]\nouter = ${x}\nx = ${b.y}\n[b]\ny = ${a.x}\n",
+            "a.x -> b.y -> a.x",
+            2,
+        ),
+    ],
+)
+def test_cycle_chain_starts_at_repeated_key(text, chain, line):
+    with pytest.raises(ConfigError) as caught:
+        load(text)
+    assert str(caught.value) == f"reference cycle: {chain}"
+    assert caught.value.line == line
+
+
+def test_resolution_follows_file_order_across_reopened_sections():
+    with pytest.raises(ConfigError) as caught:
+        load("[a]\nvalid = ok\n[b]\ny = ${y}\n[a]\nx = ${x}\n")
+    assert str(caught.value) == "reference cycle: b.y -> b.y"
+    assert caught.value.line == 4
+
+
+def test_references_are_resolved_left_to_right():
+    with pytest.raises(ConfigError) as caught:
+        load("[a]\nouter = ${right}${left}\nleft = ${left}\nright = ${right}\n")
+    assert str(caught.value) == "reference cycle: a.right -> a.right"
+    assert caught.value.line == 2
+
+
+@pytest.mark.parametrize("invalid", ["${missing}", "$bad", "${unfinished"])
+def test_nested_resolution_errors_use_outermost_definition_line(invalid):
+    with pytest.raises(ConfigError) as caught:
+        load(f"# comment\n[a]\nouter = ${{b.middle}}\n[b]\nmiddle = ${{inner}}\ninner = {invalid}\n")
+    assert caught.value.line == 3
+
+
+def test_parse_keeps_raw_values_and_existing_behavior():
+    text = " # comment\n initial = $bad \n[a]\nx = ${missing}\n[a]\ny = $$\n"
+    assert parse(text) == {"": {"initial": "$bad"}, "a": {"x": "${missing}", "y": "$$"}}
+
+
+def test_parsing_finishes_before_resolution():
+    with pytest.raises(ConfigError, match="duplicate key") as caught:
+        load("x = ${missing}\nx = duplicate\n")
+    assert caught.value.line == 2
