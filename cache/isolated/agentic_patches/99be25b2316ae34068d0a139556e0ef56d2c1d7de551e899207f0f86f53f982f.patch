diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..e08a49b
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,91 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_nested_references_and_plain_text():
+    config = load("[a]\nx = before ${y}/${z} after\ny = ${z}\nz = done")
+    assert config["a"] == {
+        "x": "before done/done after", "y": "done", "z": "done"
+    }
+
+
+def test_sections_last_dot_and_unnamed_section():
+    config = load(
+        "key = global\n[a]\nkey = local\n"
+        "value = ${key} ${.key} ${a.b.c}\n[a.b]\nc = dotted"
+    )
+    assert config["a"]["value"] == "local global dotted"
+
+
+def test_dollar_escapes_are_not_rescanned():
+    config = load("a = $${missing}\nb = ${a} $$$$ $$${c}\nc = ok")
+    assert config[""]["a"] == "${missing}"
+    assert config[""]["b"] == "${missing} $$ $ok"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", "a.b.c", ".absent", ""])
+def test_unknown_reference_preserves_name(reference):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[db]\nhost = localhost\nx = ${{{reference}}}")
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 3
+
+
+@pytest.mark.parametrize("value", ["$", "$oops", "text $!", "${", "${key"])
+def test_invalid_dollar_and_unterminated_reference(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"\nroot = ${{a.bad}}\n[a]\nbad = {value}")
+    assert exc.value.line == 2
+
+
+def test_nested_unknown_reference_reports_outermost_line():
+    with pytest.raises(ConfigError) as exc:
+        load("# comment\nroot = ${a.x}\n[a]\nx = ${db.hostt}")
+    assert str(exc.value) == "unknown reference: db.hostt"
+    assert exc.value.line == 2
+
+
+def test_cycle_excludes_prefix_and_reports_outermost_line():
+    with pytest.raises(ConfigError) as exc:
+        load("root = ${a.x}\n[a]\nx = ${y}\ny = ${x}")
+    assert str(exc.value) == "reference cycle: a.x -> a.y -> a.x"
+    assert exc.value.line == 1
+
+
+def test_cycle_in_unnamed_section():
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${y}\ny = ${.x}")
+    assert str(exc.value) == "reference cycle: .x -> .y -> .x"
+    assert exc.value.line == 1
+
+
+def test_references_are_resolved_left_to_right():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nroot = ${y} ${x}\nx = ${x}\ny = ${y}")
+    assert str(exc.value) == "reference cycle: a.y -> a.y"
+    assert exc.value.line == 2
+
+
+def test_file_order_when_section_is_reopened():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nok = fine\n[b]\nx = ${x}\n[a]\ny = ${y}")
+    assert str(exc.value) == "reference cycle: b.x -> b.x"
+    assert exc.value.line == 4
+
+
+def test_parse_keeps_raw_values():
+    assert parse("x = ${missing}\ny = $") == {"": {"x": "${missing}", "y": "$"}}
+
+
+def test_parsing_finishes_before_resolution():
+    with pytest.raises(ConfigError) as exc:
+        load("x = ${missing}\nx = duplicate")
+    assert str(exc.value) == "line 2: duplicate key 'x'"
+    assert exc.value.line == 2
+
+
+def test_empty_values_and_sections():
+    assert load("x =\ny = ${x}\n[empty]") == {"": {"x": "", "y": ""}, "empty": {}}
