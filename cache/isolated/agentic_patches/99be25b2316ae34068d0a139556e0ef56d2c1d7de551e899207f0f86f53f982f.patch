-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    raw, lines = _parse(text)
+    resolved: dict[tuple[str, str], str] = {}
+    active: list[tuple[str, str]] = []
+
+    def resolve(name: tuple[str, str]) -> str:
+        if name in resolved:
+            return resolved[name]
+        if name in active:
+            cycle = active[active.index(name):] + [name]
+            raise ConfigError("reference cycle: " + " -> ".join(
+                f"{section}.{key}" for section, key in cycle
+            ))
+
+        active.append(name)
+        section, key = name
+        value = raw[section][key]
+        parts: list[str] = []
+        i = 0
+        while i < len(value):
+            if value[i] != "$":
+                end = value.find("$", i)
+                if end == -1:
+                    end = len(value)
+                parts.append(value[i:end])
+                i = end
+            elif value.startswith("$$", i):
+                parts.append("$")
+                i += 2
+            elif value.startswith("${", i):
+                end = value.find("}", i + 2)
+                if end == -1:
+                    raise ConfigError("unterminated reference")
+                reference = value[i + 2:end]
+                target_section, dot, target_key = reference.rpartition(".")
+                if not dot:
+                    target_section = section
+                if target_section not in raw or target_key not in raw[target_section]:
+                    raise ConfigError(f"unknown reference: {reference}")
+                parts.append(resolve((target_section, target_key)))
+                i = end + 1
+            else:
+                raise ConfigError("invalid dollar sign")
+        active.pop()
+        resolved[name] = "".join(parts)
+        return resolved[name]
+
+    for name, line in lines.items():
+        try:
+            resolve(name)
+        except ConfigError as error:
+            # Keep the resolution message exact while attributing it to its root.
+            error.line = line
+            raise
+    return {
+        section: {key: resolved[section, key] for key in values}
+        for section, values in raw.items()
+    }
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
