diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..faf0566
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,191 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, t=0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"max_attempts": 0},
+    {"max_attempts": -1},
+    {"base_delay": 0},
+    {"base_delay": -1},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_configuration(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_retry_then_success_with_defaults():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append(clock.t)
+        if len(calls) < 3:
+            raise ValueError("try again")
+
+    job = queue.submit("flaky", flaky)
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert job.attempts == 1
+    assert job.run_at == 2
+    clock.t = 1
+    assert worker.run_due() == 0
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert job.run_at == 6
+    clock.t = 6
+    assert worker.run_due() == 1
+    assert calls == [0, 2, 6]
+    assert job.attempts == 3
+    assert worker.done == ["flaky"]
+    assert worker.dead == []
+    assert len(queue) == 0
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 2, "dead": 0}
+
+
+def test_backoff_is_capped_and_jobs_die_in_order():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=3, max_delay=5)
+
+    def fail():
+        raise RuntimeError(f"failure at {clock.t}")
+
+    first = queue.submit("first", fail)
+    second = queue.submit("second", fail)
+    for time, next_time in [(0, 3), (3, 8), (8, 13)]:
+        clock.t = time
+        assert worker.run_due() == 2
+        assert first.run_at == second.run_at == next_time
+    clock.t = 13
+    assert worker.run_due() == 2
+    assert worker.dead == [
+        ("first", 4, "RuntimeError('failure at 13')"),
+        ("second", 4, "RuntimeError('failure at 13')"),
+    ]
+    assert first.attempts == second.attempts == 4
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 8, "dead": 2}
+    assert len(queue) == 0
+
+
+def test_one_attempt_limit():
+    queue = JobQueue(Clock())
+    worker = Worker(queue, max_attempts=1)
+
+    def fail():
+        raise ValueError("fatal")
+
+    job = queue.submit("job", fail)
+    assert worker.run_due() == 1
+    assert job.attempts == 1
+    assert worker.dead == [("job", 1, "ValueError('fatal')")]
+    assert len(queue) == 0
+
+
+@pytest.mark.parametrize("exception", [KeyboardInterrupt(), SystemExit(), BaseException()])
+def test_base_exception_propagates_without_retry_and_preserves_pending(exception):
+    queue = JobQueue(Clock())
+    worker = Worker(queue)
+
+    def interrupt():
+        raise exception
+
+    job = queue.submit("interrupt", interrupt)
+    pending = queue.submit("pending", lambda: None)
+    with pytest.raises(type(exception)) as caught:
+        worker.run_due()
+    assert caught.value is exception
+    assert job.attempts == 1
+    assert pending.attempts == 0
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert worker.done == ["pending"]
+
+
+def test_retry_preserves_original_sequence():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+    queue.submit("earlier", lambda: log.append("earlier"), delay=2)
+
+    def flaky():
+        if job.attempts == 1:
+            raise ValueError()
+        log.append("retry")
+
+    job = queue.submit("retry", flaky)
+    sequence = job.seq
+    queue.submit("later", lambda: log.append("later"), delay=2)
+    assert worker.run_due() == 1
+    assert job.seq == sequence
+    clock.t = 2
+    assert worker.run_due() == 3
+    assert log == ["earlier", "retry", "later"]
+
+
+def test_delay_uses_attempt_time_and_due_jobs_are_snapshotted():
+    clock = Clock(10)
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail_after_time_passes():
+        clock.t = 100
+        queue.submit("new", lambda: None)
+        raise ValueError()
+
+    job = queue.submit("retry", fail_after_time_passes)
+    future = queue.submit("future", lambda: None, delay=1)
+    assert worker.run_due() == 1
+    assert job.run_at == 12
+    assert job.attempts == 1
+    assert future.attempts == 0
+    assert len(queue) == 3
+
+
+def test_retry_that_rounds_to_now_is_not_run_twice():
+    clock = Clock(1e20)
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail():
+        raise ValueError()
+
+    job = queue.submit("retry", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock.t
+    assert job.attempts == 1
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+
+
+def test_each_attempt_uses_its_own_start_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def advance_clock():
+        clock.t = 10
+
+    def fail():
+        clock.t = 20
+        raise ValueError()
+
+    queue.submit("advance", advance_clock)
+    job = queue.submit("retry", fail)
+    assert worker.run_due() == 2
+    assert job.run_at == 12
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 1, "dead": 0}
