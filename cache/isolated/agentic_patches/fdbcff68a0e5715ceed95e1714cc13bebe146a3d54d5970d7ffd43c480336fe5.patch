 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    config, locations = _parse_with_locations(text)
+    resolved: dict[tuple[str, str], str] = {}
+    active: list[tuple[str, str]] = []
+
+    def resolve(section: str, key: str) -> str:
+        name = (section, key)
+        if name in resolved:
+            return resolved[name]
+        if name in active:
+            cycle = active[active.index(name):] + [name]
+            chain = " -> ".join(f"{s}.{k}" for s, k in cycle)
+            raise ConfigError(f"reference cycle: {chain}")
+
+        active.append(name)
+        value = config[section][key]
+        parts: list[str] = []
+        start = 0
+        while start < len(value):
+            dollar = value.find("$", start)
+            if dollar == -1:
+                parts.append(value[start:])
+                break
+            parts.append(value[start:dollar])
+            if value.startswith("$$", dollar):
+                parts.append("$")
+                start = dollar + 2
+            elif value.startswith("${", dollar):
+                end = value.find("}", dollar + 2)
+                if end == -1:
+                    raise ConfigError("unterminated reference")
+                reference = value[dollar + 2:end]
+                if "." in reference:
+                    target_section, _, target_key = reference.rpartition(".")
+                else:
+                    target_section, target_key = section, reference
+                if (target_section, target_key) not in locations:
+                    raise ConfigError(f"unknown reference: {reference}")
+                parts.append(resolve(target_section, target_key))
+                start = end + 1
+            else:
+                raise ConfigError("invalid dollar sign")
+        active.pop()
+        resolved[name] = "".join(parts)
+        return resolved[name]
+
+    # Locations retain global file order, including entries in reopened sections.
+    for (section, key), line in locations.items():
+        try:
+            config[section][key] = resolve(section, key)
+        except ConfigError as error:
+            raise ConfigError(str(error), line) from None
+    return config
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
