diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..71ebe96
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,74 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+@pytest.mark.parametrize(
+    "cents,pct,expected",
+    [
+        (1005, 10, 905),
+        (1004, 10, 904),
+        (1006, 10, 905),
+        (1234, 0, 1234),
+        (1234, 100, 0),
+        (0, 50, 0),
+        (-1005, 10, -905),
+        (10**20 + 5, 10, 9 * 10**19 + 5),
+    ],
+)
+def test_apply_percent(cents, pct, expected):
+    assert apply_percent(cents, pct) == expected
+
+
+@pytest.mark.parametrize("pct", [-1, 101, 10.0, "10", None, True, False])
+def test_invalid_percent(pct):
+    with pytest.raises(ValueError):
+        apply_percent(1005, pct)
+    store = Store()
+    with pytest.raises(ValueError):
+        store.add_code("SAVE", pct)
+    with pytest.raises(KeyError):
+        store.total_cents("SAVE")
+
+
+def test_discount_applies_to_whole_total():
+    store = Store()
+    store.add_item("pen", 5, 2)
+    store.add_item("pad", 5)
+    store.add_code("Save", 10)
+    assert store.total_cents("sAVE") == 14
+    assert store.total_cents() == 15
+    assert main(["total", "--code", "SAVE"], store) == "$0.14"
+    assert main(["total"], store) == "$0.15"
+
+
+def test_duplicate_code_preserves_original_discount():
+    store = Store()
+    store.add_item("pad", 1005)
+    store.add_code("Save", 10)
+    for code in ("Save", "SAVE", "save"):
+        with pytest.raises(ValueError):
+            store.add_code(code, 50)
+    assert store.total_cents("save") == 905
+
+
+def test_unknown_code():
+    store = Store()
+    with pytest.raises(KeyError):
+        store.total_cents("Missing")
+    assert main(["total", "--code", "MiSsInG"], store) == "unknown code: MiSsInG"
+
+
+def test_empty_store_and_boundary_discounts():
+    store = Store()
+    store.add_code("FREE", 100)
+    store.add_code("NONE", 0)
+    store.add_code("", 50)
+    assert store.total_cents("FREE") == 0
+    assert store.total_cents("") == 0
+    store.add_item("pad", 1005)
+    assert store.total_cents("NONE") == 1005
+    assert store.total_cents("FREE") == 0
+    assert main(["total", "--code", "free"], store) == "$0.00"
