diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..58bf47d
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,232 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, t=0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"max_attempts": -1},
+        {"base_delay": 0},
+        {"base_delay": -1},
+        {"base_delay": 5, "max_delay": 4},
+    ],
+)
+def test_invalid_retry_settings(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_default_retries_then_success():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    outcomes = iter([ValueError("first"), RuntimeError("second"), None])
+
+    def flaky():
+        error = next(outcomes)
+        if error is not None:
+            raise error
+
+    job = queue.submit("flaky", flaky)
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    for attempt, timestamp, next_run in [(1, 0, 2), (2, 2, 6)]:
+        clock.t = timestamp
+        assert worker.run_due() == 1
+        assert job.attempts == attempt
+        assert job.run_at == next_run
+        assert worker.done == []
+        assert worker.stats() == {
+            "succeeded": 0, "failed_attempts": attempt, "dead": 0
+        }
+        clock.t = next_run - 1
+        assert worker.run_due() == 0
+
+    clock.t = 6
+    assert worker.run_due() == 1
+    assert job.attempts == 3
+    assert worker.done == ["flaky"]
+    assert worker.dead == []
+    assert len(queue) == 0
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 2, "dead": 0}
+
+
+def test_backoff_is_capped_and_death_records_last_exception():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=5, base_delay=3, max_delay=7)
+    calls = []
+
+    def fail():
+        calls.append(clock.t)
+        raise ValueError(f"failure {len(calls)}")
+
+    job = queue.submit("bad", fail)
+    for attempt, timestamp in enumerate([0, 3, 9, 16, 23], start=1):
+        clock.t = timestamp
+        assert worker.run_due() == 1
+        assert job.attempts == attempt
+    assert calls == [0, 3, 9, 16, 23]
+    assert worker.dead == [("bad", 5, "ValueError('failure 5')")]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 5, "dead": 1}
+    assert len(queue) == 0
+    assert worker.run_due() == 0
+
+
+def test_jobs_die_in_completion_order_with_independent_failure_counts():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=2)
+
+    def fail():
+        raise RuntimeError("bad")
+
+    later = queue.submit("later", fail, delay=1)
+    earlier = queue.submit("earlier", fail)
+    for timestamp in [0, 1, 2, 3]:
+        clock.t = timestamp
+        assert worker.run_due() == 1
+    assert worker.dead == [
+        ("earlier", 2, "RuntimeError('bad')"),
+        ("later", 2, "RuntimeError('bad')"),
+    ]
+    assert earlier.attempts == later.attempts == 2
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 2}
+
+
+@pytest.mark.parametrize("error", [KeyboardInterrupt("stop"), SystemExit(2)])
+def test_base_exception_propagates_without_requeue_and_preserves_other_jobs(error):
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def interrupt():
+        raise error
+
+    interrupted = queue.submit("interrupt", interrupt)
+    remaining = queue.submit("remaining", lambda: None)
+    with pytest.raises(type(error)) as caught:
+        worker.run_due()
+    assert caught.value is error
+    assert interrupted.attempts == 1
+    assert remaining.attempts == 0
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert worker.done == ["remaining"]
+
+
+def test_single_attempt_limit_and_continuing_after_failure():
+    queue = JobQueue(Clock())
+    worker = Worker(queue, max_attempts=1, base_delay=1, max_delay=1)
+
+    def fail():
+        raise ValueError("bad")
+
+    bad = queue.submit("bad", fail)
+    good = queue.submit("good", lambda: None)
+    assert worker.run_due() == 2
+    assert bad.attempts == good.attempts == 1
+    assert worker.done == ["good"]
+    assert worker.dead == [("bad", 1, "ValueError('bad')")]
+    assert len(queue) == 0
+
+
+def test_retry_keeps_sequence_when_due_times_tie():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        log.append("retry")
+        if len(log) == 1:
+            raise ValueError("first")
+
+    job = queue.submit("retry", flaky)
+    original_seq = job.seq
+    queue.submit("later", lambda: log.append("later"), delay=2)
+    assert worker.run_due() == 1
+    assert job.seq == original_seq
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert log == ["retry", "retry", "later"]
+
+
+def test_retry_uses_attempt_time_and_does_not_run_again_in_same_call():
+    clock = Clock(10)
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail_slowly():
+        clock.t += 100
+        raise ValueError("slow")
+
+    job = queue.submit("slow", fail_slowly)
+    assert worker.run_due() == 1
+    assert job.run_at == 12
+    assert job.attempts == 1
+    assert worker.run_due() == 1
+    assert job.run_at == 114
+
+
+def test_each_attempt_uses_its_own_start_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def advance_clock():
+        clock.t = 10
+
+    def fail():
+        raise ValueError("bad")
+
+    queue.submit("advance", advance_clock)
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 2
+    assert job.run_at == 12
+
+
+def test_retry_is_deferred_when_delay_rounds_to_now():
+    clock = Clock(1e20)
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail():
+        raise ValueError("bad")
+
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock.t
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+
+
+def test_only_jobs_due_at_entry_run_even_if_clock_advances_or_jobs_are_submitted():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def submit_and_advance():
+        queue.submit("new", lambda: None)
+        clock.t = 10
+
+    queue.submit("first", submit_and_advance)
+    future = queue.submit("future", lambda: None, delay=5)
+    assert worker.run_due() == 1
+    assert worker.done == ["first"]
+    assert future.attempts == 0
+    assert worker.run_due() == 2
+    assert worker.done == ["first", "new", "future"]
