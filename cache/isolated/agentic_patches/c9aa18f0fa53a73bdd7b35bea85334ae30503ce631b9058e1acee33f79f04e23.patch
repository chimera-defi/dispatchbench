+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0
+
+    def __call__(self):
+        return self.t
+
+
+def test_retries_with_exponential_backoff_and_succeeds():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, max_attempts=4, base_delay=2, max_delay=5)
+    calls = []
+
+    def flaky():
+        calls.append(clk.t)
+        if len(calls) < 3:
+            raise RuntimeError("try again")
+
+    job = q.submit("job", flaky)
+    assert w.run_due() == 1
+    assert job.attempts == 1
+    assert calls == [0]
+    assert w.run_due() == 0
+    clk.t = 2
+    assert w.run_due() == 1
+    assert job.attempts == 2
+    assert w.run_due() == 0
+    clk.t = 6
+    assert w.run_due() == 1
+    assert job.attempts == 3
+    assert w.done == ["job"]
+    assert w.stats() == {"succeeded": 1, "failed_attempts": 2, "dead": 0}
+
+
+def test_dead_jobs_record_attempt_count_and_last_exception_in_death_order():
+    q = JobQueue(Clock())
+    w = Worker(q, max_attempts=2, base_delay=1)
+
+    def fail_a():
+        raise ValueError("a")
+
+    def fail_b():
+        raise TypeError("b")
+
+    q.submit("a", fail_a)
+    q.submit("b", fail_b)
+    assert w.run_due() == 2
+    q.clock.t = 1
+    assert w.run_due() == 2
+    assert w.dead == [
+        ("a", 2, "ValueError('a')"),
+        ("b", 2, "TypeError('b')"),
+    ]
+    assert w.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 2}
+
+
+def test_retry_keeps_sequence_among_jobs_due_together():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, base_delay=1)
+    log = []
+    tries = 0
+
+    def first():
+        nonlocal tries
+        tries += 1
+        log.append("first")
+        if tries == 1:
+            raise RuntimeError()
+
+    q.submit("first", first)
+    q.submit("second", lambda: log.append("second"), delay=1)
+    assert w.run_due() == 1
+    clk.t = 1
+    assert w.run_due() == 2
+    assert log == ["first", "first", "second"]
+
+
+def test_retry_that_is_due_now_is_not_repeated_in_same_call():
+    clk = Clock()
+    q = JobQueue(clk)
+    w = Worker(q, base_delay=1)
+    calls = []
+
+    def fail_and_advance_clock():
+        calls.append(clk.t)
+        clk.t += 1
+        raise RuntimeError()
+
+    q.submit("job", fail_and_advance_clock)
+    assert w.run_due() == 1
+    assert calls == [0]
+    assert len(q) == 1
+    assert q._heap[0].run_at == 1
+
+
+def test_non_exception_baseexception_propagates_without_retry():
+    q = JobQueue(Clock())
+    w = Worker(q)
+    job = q.submit("stop", lambda: (_ for _ in ()).throw(KeyboardInterrupt()))
+    with pytest.raises(KeyboardInterrupt):
+        w.run_due()
+    assert job.attempts == 1
+    assert len(q) == 0
+    assert w.dead == []
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"max_attempts": 0},
+        {"base_delay": 0},
+        {"base_delay": 3, "max_delay": 2},
+    ],
+)
+def test_invalid_retry_configuration(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
