diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..110c309
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,102 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_nested_references_and_plain_text():
+    config = load(
+        "[db]\nurl = postgres://${host}:${port}/${name}\n"
+        "host = ${server}\nserver = localhost\nport = 5432\nname = app\n"
+    )
+    assert config["db"]["url"] == "postgres://localhost:5432/app"
+    assert config["db"]["host"] == "localhost"
+
+
+def test_sections_and_last_dot():
+    config = load(
+        "key = global\n[a]\nkey = local\n"
+        "value = ${key}/${.key}/${a.b.c}\n[a.b]\nc = ${a.key}\n"
+    )
+    assert config["a"]["value"] == "local/global/local"
+    assert config["a.b"]["c"] == "local"
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [("", ""), ("$$", "$"), ("$$$$", "$$"),
+     ("$${missing}", "${missing}"), ("$$${key}$$", "$ok$"),
+     ("${key}${key}", "okok"), ("before $$ after", "before $ after")],
+)
+def test_dollars_and_multiple_references(value, expected):
+    assert load(f"value = {value}\nkey = ok\n")[""]["value"] == expected
+
+
+def test_inserted_values_are_not_scanned_again():
+    config = load("a = ${b}/${b}\nb = $${missing}$$\n")
+    assert config[""]["a"] == "${missing}$/${missing}$"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", "a.b.c", ".key", ""])
+def test_unknown_reference_preserves_name(reference):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[db]\nvalue = ${{{reference}}}\n")
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$x", "text $!", "${", "${key", "$$$"])
+def test_malformed_dollars(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"# comment\n[a]\nkey = {value}\n")
+    assert exc.value.line == 3
+
+
+@pytest.mark.parametrize("value", ["${missing}", "$bad", "${unfinished"])
+def test_nested_errors_use_outermost_line(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"# comment\n[a]\nouter = ${{b.inner}}\n[b]\ninner = {value}\n")
+    assert exc.value.line == 3
+
+
+@pytest.mark.parametrize(
+    ("text", "chain", "line"),
+    [
+        ("[a]\nx = ${y}\ny = ${x}\n", "a.x -> a.y -> a.x", 2),
+        ("x = ${x}\n", ".x -> .x", 1),
+        ("outer = ${a.x}\n[a]\nx = ${y}\ny = ${x}\n",
+         "a.x -> a.y -> a.x", 1),
+        ("x = ${a.y}\n[a]\ny = ${.x}\n", ".x -> a.y -> .x", 1),
+    ],
+)
+def test_cycles(text, chain, line):
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == f"reference cycle: {chain}"
+    assert exc.value.line == line
+
+
+def test_resolution_uses_file_order_with_reopened_sections():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nok = yes\n[b]\nx = ${x}\n[a]\ny = ${y}\n")
+    assert str(exc.value) == "reference cycle: b.x -> b.x"
+    assert exc.value.line == 4
+
+
+def test_references_are_resolved_left_to_right():
+    with pytest.raises(ConfigError) as exc:
+        load("[a]\nouter = ${z}${y}\ny = ${y}\nz = ${z}\n")
+    assert str(exc.value) == "reference cycle: a.z -> a.z"
+    assert exc.value.line == 2
+
+
+def test_parse_still_returns_raw_values():
+    assert parse("a = ${missing}\nb = $\n") == {"": {"a": "${missing}", "b": "$"}}
+
+
+def test_parsing_finishes_before_resolution():
+    with pytest.raises(ConfigError) as exc:
+        load("a = ${missing}\na = duplicate\n")
+    assert str(exc.value) == "line 2: duplicate key 'a'"
+    assert exc.value.line == 2
