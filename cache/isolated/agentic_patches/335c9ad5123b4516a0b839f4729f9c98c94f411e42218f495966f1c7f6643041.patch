+from collections import deque
+
 from .queue import JobQueue
 
 
 class Worker:
-    def __init__(self, queue: JobQueue):
+    def __init__(self, queue: JobQueue, max_attempts=3, base_delay=2, max_delay=60):
+        if max_attempts < 1:
+            raise ValueError("max_attempts must be at least 1")
+        if base_delay < 1:
+            raise ValueError("base_delay must be at least 1")
+        if max_delay < base_delay:
+            raise ValueError("max_delay must be at least base_delay")
         self.queue = queue
+        self.max_attempts = max_attempts
+        self.base_delay = base_delay
+        self.max_delay = max_delay
         self.done: list[str] = []     # names of jobs that succeeded, in completion order
+        self.dead: list[tuple[str, int, str]] = []
+        self._failed_attempts = 0
 
     def run_due(self) -> int:
-        """Run every job that is due now, earliest first. Returns how many jobs ran."""
+        """Attempt the jobs due at entry, returning the number of attempts made."""
+        now = self.queue.clock()
+        pending = deque()
+        while (job := self.queue.pop_due(now)) is not None:
+            pending.append(job)
+
         ran = 0
-        while (job := self.queue.pop_due()) is not None:
-            job.fn()
-            self.done.append(job.name)
-            ran += 1
+        try:
+            while pending:
+                job = pending.popleft()
+                attempted_at = self.queue.clock()
+                job.attempts += 1
+                ran += 1
+                try:
+                    job.fn()
+                except Exception as exc:
+                    job.failures += 1
+                    self._failed_attempts += 1
+                    if job.failures >= self.max_attempts:
+                        self.dead.append((job.name, job.attempts, repr(exc)))
+                    else:
+                        delay = min(self.max_delay, self.base_delay * 2 ** (job.failures - 1))
+                        job.run_at = attempted_at + delay
+                        self.queue.requeue(job)
+                else:
+                    self.done.append(job.name)
+        finally:
+            # A BaseException leaves all jobs not yet attempted available to run.
+            for job in pending:
+                self.queue.requeue(job)
         return ran
+
+    def stats(self) -> dict[str, int]:
+        return {
+            "succeeded": len(self.done),
+            "failed_attempts": self._failed_attempts,
+            "dead": len(self.dead),
+        }
diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..55b3e76
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,178 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, now=0):
+        self.t = now
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"max_attempts": 0},
+    {"max_attempts": -1},
+    {"base_delay": 0},
+    {"base_delay": -1},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_configuration(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_default_retries_then_success():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append(clock())
+        if len(calls) < 3:
+            raise ValueError("temporary")
+
+    job = queue.submit("flaky", flaky)
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert job.attempts == 1
+    assert job.run_at == 2
+    clock.t = 1
+    assert worker.run_due() == 0
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert job.run_at == 6
+    clock.t = 6
+    assert worker.run_due() == 1
+    assert calls == [0, 2, 6]
+    assert job.attempts == 3
+    assert worker.done == ["flaky"]
+    assert worker.dead == []
+    assert len(queue) == 0
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 2, "dead": 0}
+
+
+def test_capped_backoff_and_dead_letter_order():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=3)
+
+    def fail():
+        raise RuntimeError("still broken")
+
+    first = queue.submit("first", fail)
+    second = queue.submit("second", fail)
+    for now, next_due in [(0, 2), (2, 5), (5, 8)]:
+        clock.t = now
+        worker.run_due()
+        assert first.run_at == next_due
+    clock.t = 8
+    assert worker.run_due() == 2
+    assert worker.dead == [
+        ("first", 4, "RuntimeError('still broken')"),
+        ("second", 4, "RuntimeError('still broken')"),
+    ]
+    assert first.attempts == second.attempts == 4
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 8, "dead": 2}
+    assert len(queue) == 0
+
+
+@pytest.mark.parametrize("max_attempts", [1, 3])
+def test_dead_letter_uses_last_exception_repr(max_attempts):
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=max_attempts)
+
+    def fail():
+        raise ValueError(f"error {job.attempts}")
+
+    job = queue.submit("bad", fail)
+    for _ in range(max_attempts):
+        clock.t = job.run_at
+        assert worker.run_due() == 1
+    assert job.attempts == max_attempts
+    assert worker.dead == [("bad", max_attempts, f"ValueError('error {max_attempts}')")]
+    assert len(queue) == 0
+
+
+def test_delay_starts_at_attempt_time_and_due_jobs_are_snapshotted():
+    clock = Clock(10)
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def fail_slowly():
+        clock.t = 20
+        queue.submit("new", lambda: log.append("new"))
+        raise RuntimeError("slow failure")
+
+    job = queue.submit("slow", fail_slowly)
+    queue.submit("already due", lambda: log.append("already due"))
+    queue.submit("future", lambda: log.append("future"), delay=1)
+    assert worker.run_due() == 2
+    assert job.run_at == 12
+    assert job.attempts == 1
+    assert log == ["already due"]
+    assert len(queue) == 3
+
+
+def test_retry_preserves_sequence_for_equal_due_times():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        if not log:
+            log.append("failure")
+            raise ValueError("retry")
+        log.append("retry")
+
+    job = queue.submit("original", flaky)
+    original_seq = job.seq
+    queue.submit("later", lambda: log.append("later"), delay=2)
+    assert worker.run_due() == 1
+    assert job.seq == original_seq
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert log == ["failure", "retry", "later"]
+
+
+def test_retry_is_not_repeated_when_delay_rounds_to_now():
+    clock = Clock(1e20)
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def fail():
+        raise ValueError("retry")
+
+    job = queue.submit("rounded", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock()
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.run_due() == 1
+    assert job.attempts == 2
+
+
+@pytest.mark.parametrize("error", [KeyboardInterrupt(), SystemExit(), BaseException()])
+def test_base_exception_propagates_without_requeueing(error):
+    queue = JobQueue(Clock())
+    worker = Worker(queue)
+
+    def interrupt():
+        raise error
+
+    job = queue.submit("interrupt", interrupt)
+    queue.submit("remaining", lambda: None)
+    with pytest.raises(type(error)) as caught:
+        worker.run_due()
+    assert caught.value is error
+    assert job.attempts == 1
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert worker.done == ["remaining"]
