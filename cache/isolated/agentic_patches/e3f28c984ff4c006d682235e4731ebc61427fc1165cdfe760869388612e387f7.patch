diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..429a9bc
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,98 @@
+import pytest
+
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+@pytest.mark.parametrize("elapsed, live", [(9, True), (10, False), (11, False)])
+def test_expiration_boundary_and_lookup_stats(elapsed, live):
+    clock = FakeClock(100)
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(elapsed)
+
+    assert cache.get("a", "missing") == (1 if live else "missing")
+    assert cache.stats.hits == int(live)
+    assert cache.stats.misses == int(not live)
+    assert cache.stats.expirations == int(not live)
+    assert cache.stats.evictions == 0
+    if not live:
+        assert cache.get("a", "missing") == "missing"
+        assert cache.stats.misses == 2
+        assert cache.stats.expirations == 1
+        assert cache.stats.hit_rate() == 0.0
+
+
+def test_overwrite_updates_recency_and_refreshes_ttl():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("a", 3)
+    cache.put("c", 4)
+
+    assert cache.get("b") is None
+    assert cache.get("a") == 3
+    assert cache.get("c") == 4
+    assert cache.stats.evictions == 1
+    clock.advance(5)
+    assert cache.get("a") == 3
+    clock.advance(5)
+    assert cache.get("a") is None
+
+
+def test_put_reclaims_expired_entries_even_when_they_are_most_recently_used():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("expired", 1)
+    clock.advance(5)
+    cache.put("live", 2)
+    assert cache.get("expired") == 1
+    clock.advance(5)
+
+    cache.put("new", 3)
+
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+    assert len(cache) == 2
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+    assert cache.get("expired") is None
+
+
+def test_len_removes_all_expired_entries_and_counts_each_once():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("c", 3)
+    assert cache.get("a") == 1
+    clock.advance(5)
+
+    assert len(cache) == 1
+    assert len(cache) == 1
+    assert cache.stats.expirations == 2
+    assert cache.stats.evictions == 0
+    assert cache.stats.hits == 1
+    assert cache.stats.misses == 0
+    clock.advance(5)
+    assert len(cache) == 0
+    assert cache.stats.expirations == 3
+
+
+def test_put_reclaims_all_expired_entries_including_overwritten_key():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(10)
+
+    cache.put("a", 3)
+
+    assert cache.stats.expirations == 2
+    assert cache.stats.evictions == 0
+    assert cache.stats.hits == cache.stats.misses == 0
+    assert len(cache) == 1
+    assert cache.get("a") == 3
