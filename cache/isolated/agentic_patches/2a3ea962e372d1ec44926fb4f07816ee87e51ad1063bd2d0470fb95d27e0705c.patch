diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..91a95de
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,97 @@
+import pytest
+
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+@pytest.mark.parametrize("elapsed", [10, 11])
+def test_expired_lookup_is_a_miss(elapsed):
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("key", "value")
+    clock.advance(9)
+    assert cache.get("key") == "value"
+    clock.advance(elapsed - 9)
+
+    sentinel = object()
+    assert cache.get("key", sentinel) is sentinel
+    assert cache.stats.hits == 1
+    assert cache.stats.misses == 1
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+
+    assert cache.get("key", sentinel) is sentinel
+    assert cache.stats.hits == 1
+    assert cache.stats.misses == 2
+    assert cache.stats.expirations == 1
+
+
+def test_overwrite_refreshes_recency_and_ttl():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("a", 3)
+    cache.put("c", 4)
+
+    assert cache.get("b") is None
+    clock.advance(5)
+    assert cache.get("a") == 3
+    assert cache.get("c") == 4
+    assert cache.stats.evictions == 1
+    assert cache.stats.expirations == 0
+
+
+def test_put_removes_expired_entries_even_when_recently_used():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("expired_a", 1)
+    cache.put("expired_b", 2)
+    clock.advance(5)
+    cache.put("live", 3)
+    assert cache.get("expired_a") == 1
+    assert cache.get("expired_b") == 2
+    clock.advance(5)
+
+    cache.put("new", 4)
+
+    assert cache.stats.evictions == 0
+    assert cache.stats.expirations == 2
+    assert cache.get("live") == 3
+    assert cache.get("new") == 4
+    assert len(cache) == 2
+
+
+def test_len_counts_only_live_entries_and_expires_each_once():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(5)
+    cache.put("c", 3)
+    clock.advance(5)
+
+    assert len(cache) == 1
+    assert len(cache) == 1
+    assert cache.stats.expirations == 2
+    assert cache.stats.hits == cache.stats.misses == cache.stats.evictions == 0
+
+    clock.advance(5)
+    assert len(cache) == 0
+    assert cache.stats.expirations == 3
+    assert cache.get("a") is None
+    assert cache.stats.expirations == 3
+
+
+def test_put_replaces_expired_key_and_counts_expiration():
+    clock = FakeClock()
+    cache = TTLCache(1, 10, clock)
+    cache.put("key", 1)
+    clock.advance(10)
+    cache.put("key", 2)
+
+    assert cache.get("key") == 2
+    assert len(cache) == 1
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
