diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..0d2521f
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,96 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_local_forward_and_nested_references():
+    config = load("[app]\na = before ${b} / ${c} after\nb = ${c}\nc = done")
+    assert config["app"] == {
+        "a": "before done / done after", "b": "done", "c": "done"
+    }
+
+
+def test_cross_section_dotted_and_unnamed_references():
+    config = load(
+        "root = base\n[app]\nurl = ${db.host}:${db.port}/${.root}/${a.b.c}\n"
+        "[db]\nhost = localhost\nport = 5432\n[a.b]\nc = suffix"
+    )
+    assert config["app"]["url"] == "localhost:5432/base/suffix"
+
+
+def test_unqualified_reference_uses_current_section():
+    config = load("key = global\ncopy = ${key}\n[a]\nkey = local\ncopy = ${key}")
+    assert config[""]["copy"] == "global"
+    assert config["a"]["copy"] == "local"
+
+
+def test_empty_values_and_sections():
+    assert load("[empty]\n[a]\nx =\ny = <${x}>") == {
+        "": {}, "empty": {}, "a": {"x": "", "y": "<>"}
+    }
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [("$$", "$"), ("$$$$", "$$"), ("$${missing}", "${missing}"),
+     ("$$${key}$$", "$value$"), ("text $$ text", "text $ text")],
+)
+def test_dollar_escaping(raw, expected):
+    assert load(f"key = value\nresult = {raw}")[""]["result"] == expected
+
+
+def test_resolved_text_is_not_expanded_again():
+    config = load("literal = $${missing}\ncopy = ${literal}")
+    assert config[""]["copy"] == "${missing}"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", "absent.key", ".missing", "a.b.c", ""])
+def test_unknown_reference_preserves_written_name(reference):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[app]\nx = ${{{reference}}}\n[db]\nhost = localhost")
+    assert str(exc.value) == f"unknown reference: {reference}"
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$plain", "hello $!", "$$$", "${key", "${"])
+def test_invalid_dollar_syntax(value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"[a]\nx = {value}")
+    assert exc.value.line == 2
+
+
+@pytest.mark.parametrize("bad_value", ["${missing}", "$oops", "${unfinished"])
+def test_nested_errors_use_outermost_line(bad_value):
+    with pytest.raises(ConfigError) as exc:
+        load(f"# comment\n[a]\nouter = ${{b.inner}}\n[b]\ninner = {bad_value}")
+    assert exc.value.line == 3
+
+
+@pytest.mark.parametrize(
+    ("text", "chain", "line"),
+    [
+        ("[a]\nx = ${y}\ny = ${x}", "a.x -> a.y -> a.x", 2),
+        ("x = ${x}", ".x -> .x", 1),
+        ("[a]\nouter = ${x}\nx = ${y}\ny = ${x}", "a.x -> a.y -> a.x", 2),
+        ("[a]\nx = ${b.y}\n[b]\ny = ${a.x}", "a.x -> b.y -> a.x", 2),
+        ("[a]\nx = ${z}${y}\ny = ${y}\nz = ${z}", "a.z -> a.z", 2),
+        ("[a]\nok = fine\n[b]\nx = ${x}\n[a]\ny = ${y}", "b.x -> b.x", 4),
+    ],
+)
+def test_first_cycle_and_outermost_line(text, chain, line):
+    with pytest.raises(ConfigError) as exc:
+        load(text)
+    assert str(exc.value) == f"reference cycle: {chain}"
+    assert exc.value.line == line
+
+
+def test_parse_keeps_raw_values():
+    assert parse("x = ${missing}\ny = $") == {"": {"x": "${missing}", "y": "$"}}
+
+
+def test_parsing_finishes_before_resolution():
+    with pytest.raises(ConfigError, match="duplicate key") as exc:
+        load("x = ${missing}\nx = repeated")
+    assert exc.value.line == 2
