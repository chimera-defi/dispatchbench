diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..37a51c2
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,98 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_nested_and_multiple_references():
+    config = load(
+        "[app]\nurl = https://${host}:${port}/${path}\n"
+        "host = ${server}\nserver = localhost\nport = 8080\npath = \n"
+    )
+    assert config["app"]["url"] == "https://localhost:8080/"
+    assert config["app"]["host"] == "localhost"
+
+
+def test_sections_and_last_dot():
+    config = load(
+        "key = global\n[a]\nkey = local\n"
+        "value = ${key}/${.key}/${a.b.c}/${other.key}\n"
+        "[a.b]\nc = dotted\n[other]\nkey = remote\n"
+    )
+    assert config["a"]["value"] == "local/global/dotted/remote"
+
+
+def test_escaped_dollars_are_not_rescanned():
+    config = load(
+        "literal = $${missing}\ndollar = $$\n"
+        "value = ${literal}/${dollar}/$$${dollar}/$$$$\n"
+    )
+    assert config[""]["value"] == "${missing}/$/$$/$$"
+
+
+@pytest.mark.parametrize("name", ["missing", "db.hostt", ".missing", "a.b.c", ""])
+def test_unknown_reference_preserves_name_and_outer_line(name):
+    with pytest.raises(ConfigError) as error:
+        load("# comment\n[a]\nfirst = ${next}\nnext = ${" + name + "}\n")
+    assert str(error.value) == f"line 3: unknown reference: {name}"
+    assert error.value.line == 3
+
+
+@pytest.mark.parametrize("value", ["$", "$bad", "text $!", "${", "${missing", "$$$"])
+def test_invalid_dollars_and_unterminated_references(value):
+    with pytest.raises(ConfigError) as error:
+        load("first = ${second}\nsecond = " + value)
+    assert error.value.line == 1
+
+
+@pytest.mark.parametrize(
+    ("text", "chain", "line"),
+    [
+        ("[a]\nx = ${y}\ny = ${x}", "a.x -> a.y -> a.x", 2),
+        ("x = ${x}", ".x -> .x", 1),
+        (
+            "[a]\nouter = ${b.x}\n[b]\nx = ${y}\ny = ${x}",
+            "b.x -> b.y -> b.x",
+            2,
+        ),
+        (
+            "[a]\nx = ${b.y}\n[b]\ny = ${a.x}",
+            "a.x -> b.y -> a.x",
+            2,
+        ),
+    ],
+)
+def test_cycles(text, chain, line):
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == f"line {line}: reference cycle: {chain}"
+    assert error.value.line == line
+
+
+def test_reopened_sections_resolve_in_file_order():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nok = fine\n[b]\nx = ${x}\n[a]\ny = ${y}\n")
+    assert str(error.value) == "line 4: reference cycle: b.x -> b.x"
