diff --git a/cfg/loader.py b/cfg/loader.py
index acd880f..96f5163 100644
--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -1,9 +1,60 @@
-from .parser import parse
+from .errors import ConfigError
+from .parser import _parse_with_lines
 
 
 def load(text: str) -> dict[str, dict[str, str]]:
     """Parse config text and return the resolved values."""
-    return parse(text)
+    raw, lines = _parse_with_lines(text)
+    resolved: dict[tuple[str, str], str] = {}
+    stack: list[tuple[str, str]] = []
+
+    def resolve(entry: tuple[str, str], outer_line: int) -> str:
+        if entry in resolved:
+            return resolved[entry]
+        if entry in stack:
+            cycle = stack[stack.index(entry):] + [entry]
+            chain = " -> ".join(f"{section}.{key}" for section, key in cycle)
+            raise ConfigError(f"reference cycle: {chain}", outer_line)
+
+        stack.append(entry)
+        section, key = entry
+        value = raw[section][key]
+        parts: list[str] = []
+        pos = 0
+        while pos < len(value):
+            dollar = value.find("$", pos)
+            if dollar == -1:
+                parts.append(value[pos:])
+                break
+            parts.append(value[pos:dollar])
+            if value.startswith("$$", dollar):
+                parts.append("$")
+                pos = dollar + 2
+            elif value.startswith("${", dollar):
+                end = value.find("}", dollar + 2)
+                if end == -1:
+                    raise ConfigError("unterminated reference", outer_line)
+                name = value[dollar + 2:end]
+                if "." in name:
+                    target_section, _, target_key = name.rpartition(".")
+                else:
+                    target_section, target_key = section, name
+                if target_section not in raw or target_key not in raw[target_section]:
+                    raise ConfigError(f"unknown reference: {name}", outer_line)
+                parts.append(resolve((target_section, target_key), outer_line))
+                pos = end + 1
+            else:
+                raise ConfigError("invalid dollar in value", outer_line)
+        stack.pop()
+        resolved[entry] = "".join(parts)
+        return resolved[entry]
+
+    for entry, line in lines.items():
+        resolve(entry, line)
+    return {
+        section: {key: resolved[section, key] for key in values}
+        for section, values in raw.items()
+    }
 
 
 def get(config: dict[str, dict[str, str]], dotted: str) -> str:
