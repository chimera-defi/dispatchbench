+def test_references_resolve_left_to_right():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nouter = ${right} ${left}\nleft = ${left}\nright = ${right}\n")
+    assert str(error.value) == "line 2: reference cycle: a.right -> a.right"
