diff --git a/tests/test_refs.py b/tests/test_refs.py
new file mode 100644
index 0000000..5bc85f2
--- /dev/null
+++ b/tests/test_refs.py
@@ -0,0 +1,134 @@
+import pytest
+
+from cfg.errors import ConfigError
+from cfg.loader import load
+from cfg.parser import parse
+
+
+def test_local_nested_and_multiple_references():
+    config = load(
+        "[app]\n"
+        "url = https://${host}:${port}/${path}\n"
+        "host = ${domain}\n"
+        "domain = example.com\n"
+        "port = 443\n"
+        "path = api/${version}\n"
+        "version = v1\n"
+        "empty =\n"
+        "wrapped = <${empty}>\n"
+    )
+    assert config["app"]["url"] == "https://example.com:443/api/v1"
+    assert config["app"]["host"] == "example.com"
+    assert config["app"]["wrapped"] == "<>"
+
+
+def test_cross_section_dotted_section_and_unnamed_section():
+    config = load(
+        "root = base\n"
+        "local = ${root}\n"
+        "remote = ${a.b.c}\n"
+        "[app]\n"
+        "root = local\n"
+        "value = ${root}/${.root}/${db.host}/${a.b.c}\n"
+        "[db]\n"
+        "host = localhost\n"
+        "[a.b]\n"
+        "c = nested\n"
+    )
+    assert config[""]["local"] == "base"
+    assert config[""]["remote"] == "nested"
+    assert config["app"]["value"] == "local/base/localhost/nested"
+
+
+def test_escaped_dollars_and_replacements_are_not_rescanned():
+    config = load(
+        "price = $$10\n"
+        "literal = $${missing}\n"
+        "copy = ${literal} / ${price}\n"
+        "mixed = $$$$ / $$$${missing} / $$$${price} / $$$${\n"
+        "prefixed = $$${price}\n"
+    )
+    assert config[""]["price"] == "$10"
+    assert config[""]["literal"] == "${missing}"
+    assert config[""]["copy"] == "${missing} / $10"
+    assert config[""]["mixed"] == "$$ / $${missing} / $${price} / $${"
+    assert config[""]["prefixed"] == "$$10"
+
+
+@pytest.mark.parametrize("reference", ["missing", "db.hostt", "absent.key", "a.b.c", ".key", ""])
+def test_unknown_reference_preserves_name(reference):
+    with pytest.raises(ConfigError) as error:
+        load(f"[app]\nvalue = ${{{reference}}}\n[db]\nhost = localhost\n")
+    assert str(error.value) == f"unknown reference: {reference}"
+    assert error.value.line == 2
+
+
+@pytest.mark.parametrize("value", ["$", "$name", "text $!", "$$$", "${", "before ${key"])
+def test_malformed_dollars_and_unterminated_references(value):
+    with pytest.raises(ConfigError) as error:
+        load(f"# comment\n[app]\nvalue = {value}\n")
+    assert error.value.line == 3
+
+
+@pytest.mark.parametrize(
+    ("text", "chain", "line"),
+    [
+        ("[a]\nx = ${x}\n", "a.x -> a.x", 2),
+        ("[a]\nx = ${y}\ny = ${x}\n", "a.x -> a.y -> a.x", 2),
+        ("x = ${y}\ny = ${.x}\n", ".x -> .y -> .x", 1),
+        (
+            "[start]\nvalue = ${a.x}\n[a]\nx = ${b.y}\n[b]\ny = ${a.x}\n",
+            "a.x -> b.y -> a.x",
+            2,
+        ),
+        (
+            "[a.b]\nx = ${a.b.y}\ny = ${x}\n",
+            "a.b.x -> a.b.y -> a.b.x",
+            2,
+        ),
+    ],
+)
+def test_cycle_message_and_outermost_line(text, chain, line):
+    with pytest.raises(ConfigError) as error:
+        load(text)
+    assert str(error.value) == f"reference cycle: {chain}"
+    assert error.value.line == line
+
+
+def test_reopened_sections_resolve_in_file_order():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nvalid = ok\n[b]\nx = ${x}\n[a]\ny = ${y}\n")
+    assert str(error.value) == "reference cycle: b.x -> b.x"
+    assert error.value.line == 4
+
+
+def test_resolution_preserves_section_and_key_order():
+    config = load("[a]\nfirst = ${b.last}\nsecond = ${third}\nthird = end\n[b]\nlast = ok\n")
+    assert list(config) == ["", "a", "b"]
+    assert list(config["a"]) == ["first", "second", "third"]
+    assert config["a"] == {"first": "ok", "second": "end", "third": "end"}
+
+
+def test_references_resolve_left_to_right():
+    with pytest.raises(ConfigError) as error:
+        load("[a]\nroot = ${right} ${left}\nleft = ${left}\nright = ${right}\n")
+    assert str(error.value) == "reference cycle: a.right -> a.right"
+    assert error.value.line == 2
+
+
+@pytest.mark.parametrize("nested", ["${missing.key}", "$bad", "${unfinished"])
+def test_nested_errors_report_outermost_line(nested):
+    with pytest.raises(ConfigError) as error:
+        load(f"# comment\n[app]\nouter = ${{inner}}\ninner = {nested}\n")
+    assert error.value.line == 3
+
+
+def test_parse_still_returns_raw_values():
+    assert parse("x = ${missing}\ny = $\n") == {"": {"x": "${missing}", "y": "$"}}
+
+
+def test_parsing_finishes_before_resolution():
+    with pytest.raises(ConfigError) as error:
+        load("x = ${missing}\nx = duplicate\n")
+    assert str(error.value) == "line 2: duplicate key 'x'"
+    assert error.value.line == 2
