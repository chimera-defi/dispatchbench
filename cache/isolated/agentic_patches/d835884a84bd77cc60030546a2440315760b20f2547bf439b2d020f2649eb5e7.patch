diff --git a/kvcache/cache.py b/kvcache/cache.py
index be3061f..e789e06 100644
--- a/kvcache/cache.py
+++ b/kvcache/cache.py
@@ -23,19 +23,31 @@ class TTLCache:
             self.stats.misses += 1
             return default
         value, expires_at = self._data[key]
-        self.stats.hits += 1
-        if self.clock() > expires_at:
+        if self.clock() >= expires_at:
             del self._data[key]
             self.stats.expirations += 1
+            self.stats.misses += 1
             return default
+        self.stats.hits += 1
         self._data.move_to_end(key)
         return value
 
     def put(self, key, value) -> None:
-        self._data[key] = (value, self.clock() + self.ttl)
+        now = self.clock()
+        self._discard_expired(now)
+        if key in self._data:
+            self._data.move_to_end(key)
+        self._data[key] = (value, now + self.ttl)
         if len(self._data) > self.capacity:
             self._data.popitem(last=False)
             self.stats.evictions += 1
 
     def __len__(self) -> int:
+        self._discard_expired(self.clock())
         return len(self._data)
+
+    def _discard_expired(self, now) -> None:
+        expired = [key for key, (_, expires_at) in self._data.items() if now >= expires_at]
+        for key in expired:
+            del self._data[key]
+        self.stats.expirations += len(expired)
diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..9ee283c
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,54 @@
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+def test_entry_expires_at_exact_deadline():
+    clock = FakeClock()
+    cache = TTLCache(2, 5, clock)
+    cache.put("a", 1)
+
+    clock.advance(5)
+    assert cache.get("a") is None
+    assert cache.stats.hits == 0
+    assert cache.stats.misses == 1
+    assert cache.stats.expirations == 1
+
+
+def test_overwrite_marks_key_as_most_recently_used():
+    cache = TTLCache(2, 10, FakeClock())
+    cache.put("a", 1)
+    cache.put("b", 2)
+
+    cache.put("a", 3)
+    cache.put("c", 4)
+
+    assert cache.get("a") == 3
+    assert cache.get("b") is None
+    assert cache.stats.evictions == 1
+
+
+def test_put_discards_expired_slot_before_evicting_live_entry():
+    clock = FakeClock()
+    cache = TTLCache(2, 3, clock)
+    cache.put("expired", 1)
+    cache.put("live", 2)
+    clock.advance(3)
+    cache.put("new", 3)
+
+    assert cache.get("expired") is None
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+    assert len(cache) == 2
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+
+
+def test_len_counts_only_live_entries_and_expires_them():
+    clock = FakeClock()
+    cache = TTLCache(2, 2, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(2)
+
+    assert len(cache) == 0
+    assert cache.stats.expirations == 2
