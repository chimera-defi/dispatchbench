diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..7eacd93
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,48 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+@pytest.mark.parametrize("cents,pct,expected", [
+    (1005, 10, 905),
+    (1, 50, 1),
+    (99, 50, 50),
+    (100, 0, 100),
+    (100, 100, 0),
+])
+def test_apply_percent(cents, pct, expected):
+    assert apply_percent(cents, pct) == expected
+
+
+@pytest.mark.parametrize("pct", [-1, 101, 1.5, "10", True])
+def test_apply_percent_rejects_invalid_percentage(pct):
+    with pytest.raises(ValueError):
+        apply_percent(100, pct)
+
+
+def test_add_code_validates_and_looks_up_case_insensitively():
+    store = Store()
+    store.add_item("item", 1005)
+    store.add_code("SAVE", 10)
+    assert store.total_cents("save") == 905
+    assert store.total_cents("SaVe") == 905
+    with pytest.raises(ValueError):
+        store.add_code("save", 5)
+    with pytest.raises(ValueError):
+        store.add_code("BAD", 101)
+
+
+def test_unknown_code_raises_key_error():
+    with pytest.raises(KeyError):
+        Store().total_cents("missing")
+
+
+def test_cli_code_discount_and_unknown_code():
+    store = Store()
+    store.add_item("item", 1005)
+    store.add_code("SAVE", 10)
+    assert main(["total", "--code", "save"], store) == "$9.05"
+    assert main(["total", "--code", "Nope"], store) == "unknown code: Nope"
+    assert main(["total"], store) == "$10.05"
