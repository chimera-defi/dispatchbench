diff --git a/inv/money.py b/inv/money.py
index caa7f2f..0ed9277 100644
--- a/inv/money.py
+++ b/inv/money.py
@@ -3,3 +3,14 @@ def format_cents(cents: int) -> str:
     sign = "-" if cents < 0 else ""
     cents = abs(cents)
     return f"{sign}${cents // 100}.{cents % 100:02d}"
+
+
+def apply_percent(cents: int, pct: int) -> int:
+    """Reduce a cent amount by a percentage, rounding half up to cents."""
+    if not isinstance(pct, int) or isinstance(pct, bool) or not 0 <= pct <= 100:
+        raise ValueError("pct must be an integer from 0 to 100")
+    # Round cents * (100 - pct) / 100 to nearest integer, with ties upward.
+    discounted = cents * (100 - pct)
+    if discounted >= 0:
+        return (discounted + 50) // 100
+    return -((-discounted + 50) // 100)
