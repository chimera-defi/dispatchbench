diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..db79d8e
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,100 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+@pytest.mark.parametrize(
+    ("cents", "pct", "expected"),
+    [
+        (1005, 10, 905),
+        (1004, 10, 904),
+        (1006, 10, 905),
+        (1, 50, 1),
+        (0, 50, 0),
+        (1005, 0, 1005),
+        (1005, 100, 0),
+        (-1005, 10, -905),
+        (10**20 + 5, 10, 9 * 10**19 + 5),
+    ],
+)
+def test_apply_percent(cents, pct, expected):
+    assert apply_percent(cents, pct) == expected
+
+
+@pytest.mark.parametrize("pct", [-1, 101, 10.0, "10", None, True, False])
+def test_invalid_percent(pct):
+    with pytest.raises(ValueError):
+        apply_percent(1005, pct)
+    store = Store()
+    with pytest.raises(ValueError):
+        store.add_code("SAVE", pct)
+    with pytest.raises(KeyError):
+        store.total_cents("SAVE")
+
+
+def test_codes_are_case_insensitive_and_cannot_be_replaced():
+    store = Store()
+    store.add_item("pen", 1005)
+    store.add_code("Save10", 10)
+    assert store.total_cents("SAVE10") == 905
+    assert store.total_cents("save10") == 905
+    for duplicate in ["Save10", "SAVE10", "save10"]:
+        with pytest.raises(ValueError):
+            store.add_code(duplicate, 50)
+    assert store.total_cents("Save10") == 905
+    assert store.total_cents() == 1005
+    assert store.total_cents(None) == 1005
+
+
+def test_discount_rounds_the_whole_total():
+    store = Store()
+    store.add_item("pen", 5)
+    store.add_item("pad", 5)
+    store.add_code("HALF", 50)
+    assert store.total_cents("half") == 5
+    assert store.total_cents() == 10
+
+
+@pytest.mark.parametrize(("pct", "expected"), [(0, 1005), (100, 0)])
+def test_code_percent_boundaries(pct, expected):
+    store = Store()
+    store.add_item("pen", 1005)
+    store.add_code("CODE", pct)
+    assert store.total_cents("CODE") == expected
+
+
+def test_empty_store_and_unknown_code():
+    store = Store()
+    store.add_code("SAVE", 10)
+    assert store.total_cents("save") == 0
+    with pytest.raises(KeyError):
+        store.total_cents("missing")
+
+
+def test_codes_belong_to_each_store():
+    store = Store()
+    store.add_code("SAVE", 10)
+    with pytest.raises(KeyError):
+        Store().total_cents("SAVE")
+
+
+def test_total_cli_with_code():
+    store = Store()
+    store.add_item("pen", 1005)
+    store.add_code("SAVE10", 10)
+    assert main(["total", "--code", "save10"], store) == "$9.05"
+    assert main(["total", "--code", "MiSsInG"], store) == "unknown code: MiSsInG"
+    assert main(["total"], store) == "$10.05"
+
+
+def test_empty_code_is_distinct_from_no_code():
+    store = Store()
+    store.add_item("pen", 1005)
+    with pytest.raises(KeyError):
+        store.total_cents("")
+    assert main(["total", "--code", ""], store) == "unknown code: "
+    store.add_code("", 100)
+    assert store.total_cents("") == 0
+    assert main(["total", "--code", ""], store) == "$0.00"
