diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..0ac4ca6
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,144 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self):
+        self.t = 0
+
+    def __call__(self):
+        return self.t
+
+
+@pytest.mark.parametrize(
+    "kwargs", [
+        {"max_attempts": 0},
+        {"base_delay": 0},
+        {"base_delay": 3, "max_delay": 2},
+    ],
+)
+def test_rejects_invalid_configuration(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_retries_with_exponential_backoff_and_records_stats():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=4, base_delay=2, max_delay=5)
+    calls = []
+
+    def flaky():
+        calls.append(clock.t)
+        if len(calls) < 4:
+            raise RuntimeError("not yet")
+
+    job = queue.submit("flaky", flaky)
+    assert worker.run_due() == 1
+    assert job.attempts == 1 and len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 1, "dead": 0}
+
+    clock.t = 1
+    assert worker.run_due() == 0
+    clock.t = 2
+    assert worker.run_due() == 1
+    clock.t = 5  # the second backoff schedules the next attempt at 6
+    assert worker.run_due() == 0
+    clock.t = 6
+    assert worker.run_due() == 1
+    clock.t = 10  # the third backoff is capped at 5 seconds
+    assert worker.run_due() == 0
+    clock.t = 11
+    assert worker.run_due() == 1
+
+    assert calls == [0, 2, 6, 11]
+    assert job.attempts == 4
+    assert worker.done == ["flaky"]
+    assert worker.dead == []
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 3, "dead": 0}
+
+
+def test_dead_jobs_are_recorded_in_death_order():
+    queue = JobQueue(Clock())
+    worker = Worker(queue, max_attempts=2, base_delay=1, max_delay=1)
+
+    def fail_a():
+        raise ValueError("a")
+
+    def fail_b():
+        raise LookupError("b")
+
+    queue.submit("a", fail_a)
+    queue.submit("b", fail_b)
+    assert worker.run_due() == 2
+    assert worker.dead == []
+    # Their retries are due together and preserve the original queue order.
+    assert worker.run_due() == 0
+    # They fail permanently in the same order.
+    # Move time to the retry time.
+    queue.clock.t = 1
+    assert worker.run_due() == 2
+    assert worker.dead == [
+        ("a", 2, "ValueError('a')"),
+        ("b", 2, "LookupError('b')"),
+    ]
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 4, "dead": 2}
+
+
+def test_retries_keep_sequence_relative_to_new_submissions():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=2, base_delay=1, max_delay=1)
+    log = []
+
+    def retry_once():
+        log.append("original")
+        if log.count("original") == 1:
+            raise RuntimeError("retry")
+
+    queue.submit("original", retry_once)
+    assert worker.run_due() == 1
+    queue.submit("later", lambda: log.append("later"), delay=1)
+    clock.t = 1
+    assert worker.run_due() == 2
+    assert log == ["original", "original", "later"]
+
+
+def test_requeued_job_is_not_run_twice_in_one_call_when_delay_is_now():
+    class AdvancingClock:
+        t = 0
+
+        def __call__(self):
+            result = self.t
+            self.t += 1
+            return result
+
+    clock = AdvancingClock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=2, base_delay=1, max_delay=1)
+    calls = []
+
+    def fail():
+        calls.append(1)
+        raise RuntimeError("fail")
+
+    queue.submit("job", fail)
+    assert worker.run_due() == 1
+    assert calls == [1]
+    assert len(queue) == 1
+
+
+def test_non_exception_baseexception_propagates_without_requeue():
+    queue = JobQueue(Clock())
+    worker = Worker(queue)
+    job = queue.submit("interrupt", lambda: (_ for _ in ()).throw(KeyboardInterrupt()))
+
+    with pytest.raises(KeyboardInterrupt):
+        worker.run_due()
+
+    assert job.attempts == 1
+    assert len(queue) == 0
+    assert worker.dead == []
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
