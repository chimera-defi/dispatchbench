index 0a9e9fa..43d42d3 100644
--- a/jobq/job.py
+++ b/jobq/job.py
@@ -8,3 +8,4 @@ class Job:
     name: str = field(compare=False)
     fn: object = field(compare=False, repr=False)  # zero-argument callable
     attempts: int = field(default=0, compare=False)
+    failures: int = field(default=0, compare=False)
diff --git a/jobq/queue.py b/jobq/queue.py
index 6f9f569..c4ffba2 100644
--- a/jobq/queue.py
+++ b/jobq/queue.py
@@ -17,11 +17,37 @@ class JobQueue:
         heapq.heappush(self._heap, job)
         return job
 
-    def pop_due(self) -> Job | None:
+    def due_sequences(self, now) -> set[int]:
+        """Return the insertion sequences due at a fixed time."""
+        return {job.seq for job in self._heap if job.run_at <= now}
+
+    def pop_due(self, now=None, eligible=None) -> Job | None:
         """Remove and return the earliest job whose run_at <= now, or None."""
-        if self._heap and self._heap[0].run_at <= self.clock():
+        if now is None:
+            now = self.clock()
+        if eligible is not None:
+            index = min(
+                (i for i, job in enumerate(self._heap)
+                 if job.seq in eligible and job.run_at <= now),
+                key=lambda i: self._heap[i],
+                default=None,
+            )
+            if index is None:
+                return None
+            job = self._heap[index]
+            last = self._heap.pop()
+            if index < len(self._heap):
+                self._heap[index] = last
+                heapq.heapify(self._heap)
+            return job
+        if self._heap and self._heap[0].run_at <= now:
             return heapq.heappop(self._heap)
         return None
 
+    def reschedule(self, job: Job, run_at) -> None:
+        """Put a previously popped job back, preserving its insertion sequence."""
+        job.run_at = run_at
+        heapq.heappush(self._heap, job)
+
     def __len__(self) -> int:
         return len(self._heap)
diff --git a/jobq/worker.py b/jobq/worker.py
index c90a7df..8292e70 100644
--- a/jobq/worker.py
+++ b/jobq/worker.py
@@ -2,15 +2,56 @@ from .queue import JobQueue
 
 
 class Worker:
-    def __init__(self, queue: JobQueue):
+    def __init__(self, queue: JobQueue, max_attempts: int = 3,
+                 base_delay: int = 2, max_delay: int = 60):
+        if max_attempts < 1:
+            raise ValueError("max_attempts must be at least 1")
+        if base_delay < 1:
+            raise ValueError("base_delay must be at least 1")
+        if max_delay < base_delay:
+            raise ValueError("max_delay must be at least base_delay")
         self.queue = queue
+        self.max_attempts = max_attempts
+        self.base_delay = base_delay
+        self.max_delay = max_delay
         self.done: list[str] = []     # names of jobs that succeeded, in completion order
+        self.dead: list[tuple[str, int, str]] = []
+        self._succeeded = 0
+        self._failed_attempts = 0
 
     def run_due(self) -> int:
-        """Run every job that is due now, earliest first. Returns how many jobs ran."""
+        """Run jobs due at the start of this call; return attempts made."""
+        now = self.queue.clock()
+        eligible = self.queue.due_sequences(now)
         ran = 0
-        while (job := self.queue.pop_due()) is not None:
-            job.fn()
-            self.done.append(job.name)
+        while (job := self.queue.pop_due(now, eligible)) is not None:
+            eligible.discard(job.seq)
+            attempt_time = self.queue.clock()
+            job.attempts += 1
             ran += 1
+            try:
+                job.fn()
+            except Exception as exc:
+                job.failures += 1
+                self._failed_attempts += 1
+                if job.failures >= self.max_attempts:
+                    self.dead.append((job.name, job.attempts, repr(exc)))
+                else:
+                    # Cap before exponentiation can grow without bound.
+                    delay = self.base_delay
+                    for _ in range(job.failures - 1):
+                        delay = min(self.max_delay, delay * 2)
+                        if delay == self.max_delay:
+                            break
+                    self.queue.reschedule(job, attempt_time + delay)
+            else:
+                self.done.append(job.name)
+                self._succeeded += 1
         return ran
+
+    def stats(self) -> dict[str, int]:
+        return {
+            "succeeded": self._succeeded,
+            "failed_attempts": self._failed_attempts,
+            "dead": len(self.dead),
+        }
