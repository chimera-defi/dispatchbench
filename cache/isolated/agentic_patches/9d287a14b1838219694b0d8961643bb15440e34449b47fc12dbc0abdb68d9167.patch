diff --git a/tests/test_discount.py b/tests/test_discount.py
new file mode 100644
index 0000000..ae3f825
--- /dev/null
+++ b/tests/test_discount.py
@@ -0,0 +1,77 @@
+import pytest
+
+from inv.cli import main
+from inv.money import apply_percent
+from inv.store import Store
+
+
+@pytest.mark.parametrize(
+    "cents,pct,expected",
+    [
+        (1005, 10, 905),
+        (1004, 10, 904),
+        (1006, 10, 905),
+        (1234, 0, 1234),
+        (1234, 100, 0),
+        (0, 50, 0),
+        (-1005, 10, -905),
+        (10**20 + 5, 10, 9 * 10**19 + 5),
+    ],
+)
+def test_apply_percent(cents, pct, expected):
+    assert apply_percent(cents, pct) == expected
+
+
+@pytest.mark.parametrize("pct", [-1, 101, 10.0, "10", None, True, False])
+def test_invalid_percent(pct):
+    with pytest.raises(ValueError):
+        apply_percent(100, pct)
+    store = Store()
+    with pytest.raises(ValueError):
+        store.add_code("sale", pct)
+    with pytest.raises(KeyError):
+        store.total_cents("sale")
+
+
+def test_codes_are_case_insensitive_and_unique():
+    store = Store()
+    store.add_item("pen", 1005)
+    store.add_code("Sale", 10)
+    assert store.total_cents("sALE") == 905
+    with pytest.raises(ValueError):
+        store.add_code("SALE", 50)
+    assert store.total_cents("sale") == 905
+    assert store.total_cents() == 1005
+
+
+def test_discount_rounds_the_whole_total():
+    store = Store()
+    store.add_item("pen", 5, 2)
+    store.add_item("pad", 5)
+    store.add_code("half", 50)
+    assert store.total_cents("half") == 8
+
+
+def test_unknown_code_even_for_empty_store():
+    store = Store()
+    with pytest.raises(KeyError):
+        store.total_cents("missing")
+    store.add_code("sale", 10)
+    assert store.total_cents("sale") == 0
+
+
+def test_cli_discount_and_unknown_code():
+    store = Store()
+    store.add_item("pen", 1005)
+    store.add_code("sale", 10)
+    assert main(["total", "--code", "SALE"], store) == "$9.05"
+    assert main(["total", "--code", "MiSsInG"], store) == "unknown code: MiSsInG"
+    assert main(["total"], store) == "$10.05"
+
+
+@pytest.mark.parametrize("pct,expected", [(0, 1005), (100, 0)])
+def test_store_discount_boundaries(pct, expected):
+    store = Store()
+    store.add_item("pen", 1005)
+    store.add_code("", pct)
+    assert store.total_cents("") == expected
