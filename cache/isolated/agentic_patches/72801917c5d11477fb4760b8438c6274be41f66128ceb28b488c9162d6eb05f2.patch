diff --git a/inv/money.py b/inv/money.py
index caa7f2f..f8882ca 100644
--- a/inv/money.py
+++ b/inv/money.py
@@ -3,3 +3,12 @@ def format_cents(cents: int) -> str:
     sign = "-" if cents < 0 else ""
     cents = abs(cents)
     return f"{sign}${cents // 100}.{cents % 100:02d}"
+
+
+def apply_percent(cents: int, pct: int) -> int:
+    """Reduce a cent amount by a percentage, rounding half up to a cent."""
+    if not isinstance(pct, int) or not 0 <= pct <= 100:
+        raise ValueError("pct must be an integer from 0 to 100")
+    # The discounted amount is cents * (100 - pct) / 100. Adding 50
+    # before integer division implements half-up rounding for nonnegative cents.
+    return (cents * (100 - pct) + 50) // 100
