diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..d86d956
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,101 @@
+import pytest
+
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+from kvcache.stats import Stats
+
+
+@pytest.mark.parametrize("elapsed", [10, 11])
+def test_expired_get_is_a_miss_and_counts_expiration_once(elapsed):
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    clock.advance(9)
+    assert cache.get("a") == 1
+    assert cache.stats == Stats(hits=1)
+
+    clock.advance(elapsed - 9)
+    default = object()
+    assert cache.get("a", default) is default
+    assert cache.stats == Stats(hits=1, misses=1, expirations=1)
+    assert cache.get("a", default) is default
+    assert cache.stats == Stats(hits=1, misses=2, expirations=1)
+
+
+def test_overwrite_updates_recency_and_value():
+    cache = TTLCache(2, 10, FakeClock())
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.put("a", 3)
+    assert cache.stats == Stats()
+
+    cache.put("c", 4)
+    assert cache.get("b") is None
+    assert cache.get("a") == 3
+    assert cache.get("c") == 4
+    assert cache.stats == Stats(hits=2, misses=1, evictions=1)
+
+
+def test_overwrite_refreshes_expiration():
+    clock = FakeClock()
+    cache = TTLCache(1, 10, clock)
+    cache.put("a", 1)
+    clock.advance(5)
+    cache.put("a", 2)
+    clock.advance(5)
+    assert cache.get("a") == 2
+    clock.advance(5)
+    assert cache.get("a") is None
+    assert cache.stats == Stats(hits=1, misses=1, expirations=1)
+
+
+@pytest.mark.parametrize("touch_expiring_key", [False, True])
+def test_put_drops_expired_entries_before_evicting_live_ones(touch_expiring_key):
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("old", 1)
+    clock.advance(5)
+    cache.put("live", 2)
+    if touch_expiring_key:
+        # Expiration order need not match LRU order.
+        assert cache.get("old") == 1
+
+    clock.advance(5)
+    cache.put("new", 3)
+    assert cache.stats == Stats(hits=int(touch_expiring_key), expirations=1)
+    assert len(cache) == 2
+    assert cache.get("live") == 2
+    assert cache.get("new") == 3
+    assert cache.get("old") is None
+    assert cache.stats.evictions == 0
+    assert cache.stats.expirations == 1
+
+
+def test_put_counts_all_expired_entries_including_overwritten_key():
+    clock = FakeClock()
+    cache = TTLCache(2, 10, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(10)
+    cache.put("a", 3)
+    assert cache.stats == Stats(expirations=2)
+    assert len(cache) == 1
+    assert cache.get("a") == 3
+
+
+def test_len_counts_only_live_entries_and_expirations_once():
+    clock = FakeClock()
+    cache = TTLCache(3, 10, clock)
+    cache.put("old", 1)
+    clock.advance(5)
+    cache.put("live", 2)
+    assert cache.get("old") == 1
+    clock.advance(5)
+
+    assert len(cache) == 1
+    assert len(cache) == 1
+    assert cache.stats == Stats(hits=1, expirations=1)
+    clock.advance(5)
+    assert len(cache) == 0
+    assert len(cache) == 0
+    assert cache.stats == Stats(hits=1, expirations=2)
