diff --git a/tests/test_regressions.py b/tests/test_regressions.py
new file mode 100644
index 0000000..d4b48f9
--- /dev/null
+++ b/tests/test_regressions.py
@@ -0,0 +1,55 @@
+from kvcache.cache import TTLCache
+from kvcache.clock import FakeClock
+
+
+def test_entry_expires_at_exact_deadline():
+    clock = FakeClock()
+    cache = TTLCache(2, 5, clock)
+    cache.put("a", 1)
+
+    clock.advance(5)
+    assert cache.get("a") is None
+    assert cache.stats.hits == 0
+    assert cache.stats.misses == 1
+    assert cache.stats.expirations == 1
+    assert len(cache) == 0
+
+
+def test_overwriting_key_refreshes_its_lru_position():
+    cache = TTLCache(2, 10, FakeClock())
+    cache.put("a", 1)
+    cache.put("b", 2)
+    cache.put("a", 3)
+    cache.put("c", 4)
+
+    assert cache.get("a") == 3
+    assert cache.get("b") is None
+    assert cache.stats.evictions == 1
+
+
+def test_put_discards_expired_entry_before_evicting_live_entry():
+    clock = FakeClock()
+    cache = TTLCache(2, 5, clock)
+    cache.put("expired", "old")
+    clock.advance(1)
+    cache.put("live", "keep")
+    clock.advance(4)
+
+    cache.put("new", "value")
+
+    assert cache.get("live") == "keep"
+    assert cache.get("new") == "value"
+    assert cache.stats.expirations == 1
+    assert cache.stats.evictions == 0
+    assert len(cache) == 2
+
+
+def test_len_counts_only_live_entries_and_records_expiration():
+    clock = FakeClock()
+    cache = TTLCache(2, 3, clock)
+    cache.put("a", 1)
+    cache.put("b", 2)
+    clock.advance(3)
+
+    assert len(cache) == 0
+    assert cache.stats.expirations == 2
