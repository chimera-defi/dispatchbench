diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..65d1dd4
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,185 @@
+import pytest
+
+from jobq.queue import JobQueue
+from jobq.worker import Worker
+
+
+class Clock:
+    def __init__(self, t=0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+def fail():
+    raise ValueError("failed")
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"max_attempts": 0}, {"max_attempts": -1},
+    {"base_delay": 0}, {"base_delay": -1},
+    {"base_delay": 3, "max_delay": 2},
+])
+def test_invalid_configuration(kwargs):
+    with pytest.raises(ValueError):
+        Worker(JobQueue(Clock()), **kwargs)
+
+
+def test_default_retries_and_death():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    job = queue.submit("bad", fail)
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    for attempt, when in enumerate([0, 2, 6], start=1):
+        clock.t = when
+        assert worker.run_due() == 1
+        assert job.attempts == attempt
+        assert worker.stats()["failed_attempts"] == attempt
+        assert worker.run_due() == 0
+    assert worker.dead == [("bad", 3, "ValueError('failed')")]
+    assert worker.done == []
+    assert len(queue) == 0
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 3, "dead": 1}
+
+
+def test_retry_can_succeed():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    calls = []
+
+    def flaky():
+        calls.append(clock.t)
+        if len(calls) == 1:
+            fail()
+
+    job = queue.submit("flaky", flaky)
+    assert worker.run_due() == 1
+    clock.t = 1
+    assert worker.run_due() == 0
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert calls == [0, 2]
+    assert job.attempts == 2
+    assert worker.done == ["flaky"]
+    assert worker.stats() == {"succeeded": 1, "failed_attempts": 1, "dead": 0}
+    assert len(queue) == 0
+
+
+def test_custom_backoff_is_capped():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=5, base_delay=3, max_delay=5)
+    job = queue.submit("bad", fail)
+    for when, next_when in [(0, 3), (3, 8), (8, 13), (13, 18)]:
+        clock.t = when
+        assert worker.run_due() == 1
+        assert job.run_at == next_when
+    clock.t = 18
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 5, "ValueError('failed')")]
+
+
+def test_dead_order_and_last_exception():
+    queue = JobQueue(Clock())
+    worker = Worker(queue, max_attempts=1)
+    first = queue.submit("first", fail)
+    second = queue.submit("second", lambda: (_ for _ in ()).throw(RuntimeError("last")))
+    assert worker.run_due() == 2
+    assert first.attempts == second.attempts == 1
+    assert worker.dead == [
+        ("first", 1, "ValueError('failed')"),
+        ("second", 1, "RuntimeError('last')"),
+    ]
+
+
+@pytest.mark.parametrize("exception", [KeyboardInterrupt(), SystemExit(), BaseException()])
+def test_base_exception_propagates_and_preserves_unattempted_jobs(exception):
+    queue = JobQueue(Clock())
+    worker = Worker(queue)
+
+    def interrupt():
+        raise exception
+
+    job = queue.submit("interrupted", interrupt)
+    later = queue.submit("later", lambda: None)
+    with pytest.raises(type(exception)) as caught:
+        worker.run_due()
+    assert caught.value is exception
+    assert job.attempts == 1
+    assert later.attempts == 0
+    assert len(queue) == 1
+    assert worker.stats() == {"succeeded": 0, "failed_attempts": 0, "dead": 0}
+    assert worker.run_due() == 1
+    assert worker.done == ["later"]
+
+
+def test_retry_retains_sequence_for_equal_due_times():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    log = []
+
+    def flaky():
+        log.append("first")
+        if len(log) == 1:
+            fail()
+
+    first = queue.submit("first", flaky)
+    original_seq = first.seq
+    queue.submit("second", lambda: log.append("second"), delay=2)
+    assert worker.run_due() == 1
+    assert first.seq == original_seq
+    clock.t = 2
+    assert worker.run_due() == 2
+    assert log == ["first", "first", "second"]
+
+
+def test_snapshot_and_delay_use_attempt_start_time():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+
+    def slow_failure():
+        clock.t += 10
+        queue.submit("new", lambda: None)
+        fail()
+
+    bad = queue.submit("bad", slow_failure)
+    ready = queue.submit("ready", fail)
+    future = queue.submit("future", lambda: None, delay=5)
+    assert worker.run_due() == 2
+    assert bad.run_at == 2
+    assert ready.run_at == 12
+    assert bad.attempts == ready.attempts == 1
+    assert future.attempts == 0
+    assert len(queue) == 4
+
+
+def test_retry_rounding_to_now_is_not_attempted_again():
+    clock = Clock(float(2 ** 60))
+    queue = JobQueue(clock)
+    worker = Worker(queue)
+    job = queue.submit("bad", fail)
+    assert worker.run_due() == 1
+    assert job.run_at == clock.t
+    assert job.attempts == 1
+    assert len(queue) == 1
+
+
+def test_dead_record_uses_final_exception():
+    clock = Clock()
+    queue = JobQueue(clock)
+    worker = Worker(queue, max_attempts=2)
+    errors = iter([ValueError("first"), RuntimeError("last")])
+
+    def changing_failure():
+        raise next(errors)
+
+    queue.submit("bad", changing_failure)
+    assert worker.run_due() == 1
+    clock.t = 2
+    assert worker.run_due() == 1
+    assert worker.dead == [("bad", 2, "RuntimeError('last')")]
