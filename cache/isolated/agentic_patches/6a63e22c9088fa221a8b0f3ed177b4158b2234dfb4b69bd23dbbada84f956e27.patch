+        while (job := self.queue.pop_due(now)) is not None:
+            pending.append(job)
+
         ran = 0
-        while (job := self.queue.pop_due()) is not None:
-            job.fn()
-            self.done.append(job.name)
-            ran += 1
+        try:
+            while pending:
+                attempted_at = self.queue.clock()
+                job = pending.popleft()
+                job.attempts += 1
+                ran += 1
+                try:
+                    job.fn()
+                except Exception as exc:
+                    job.failures += 1
+                    self._failed_attempts += 1
+                    if job.failures >= self.max_attempts:
+                        self.dead.append((job.name, job.attempts, repr(exc)))
+                    else:
+                        delay = min(
+                            self.max_delay, self.base_delay * 2 ** (job.failures - 1)
+                        )
+                        job.run_at = attempted_at + delay
+                        self.queue.requeue(job)
+                else:
+                    self.done.append(job.name)
+        finally:
